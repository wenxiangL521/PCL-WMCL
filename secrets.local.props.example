<Project>
  <!--
    复制为 secrets.local.props（该文件已被 .gitignore 忽略）后填入真实值。
    未提供时仓库默认走镜像（CurseForge）或要求用户在设置里填写 Client ID。
    对照 PCL2：官方发布版在构建时把密钥编入程序，开源仓库不携带真实值。
  -->
  <PropertyGroup>
    <!-- 微软 OAuth Client ID（Azure 公共客户端，设备码登录） -->
    <WmclMsClientId></WmclMsClientId>
    <!-- CurseForge API Key（缺少时自动改用 mod.mcimirror.top 镜像） -->
    <WmclCurseForgeApiKey></WmclCurseForgeApiKey>
  </PropertyGroup>
</Project>
