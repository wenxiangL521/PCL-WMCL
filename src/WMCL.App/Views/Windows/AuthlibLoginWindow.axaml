<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:WMCL.App.Views"
        x:Class="WMCL.App.Views.AuthlibLoginWindow"
        Title="第三方登录"
        Width="540"
        Height="490"
        MinWidth="480"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WmclPage}">
  <Border Classes="card" Margin="20" Padding="18">
    <views:AuthlibLoginView x:Name="LoginView" />
  </Border>
</Window>