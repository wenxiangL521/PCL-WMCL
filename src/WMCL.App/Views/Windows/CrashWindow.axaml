<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WMCL.App.Views.CrashWindow"
        Width="580"
        MinHeight="260"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterOwner"
        Background="Transparent">
  <Window.Styles>
    <Style Selector="Button.dialogAction">
      <Setter Property="MinWidth" Value="92" />
      <Setter Property="Height" Value="34" />
    </Style>
  </Window.Styles>

  <Border Margin="12"
          Background="{DynamicResource WmclCard}"
          BorderBrush="{DynamicResource WmclDivider}"
          BorderThickness="1"
          CornerRadius="{DynamicResource WmclWindowCorner}"
          BoxShadow="{DynamicResource WmclWindowShadowBox}">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="22,18,22,18">
      <TextBlock Text="游戏崩溃了"
                 FontSize="{DynamicResource WmclFontDialogTitle}"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource WmclDanger}" />
      <Border Grid.Row="1" Height="1" Margin="0,10,0,12"
              Background="{DynamicResource WmclDivider}" />
      <ScrollViewer Grid.Row="2" MaxHeight="300"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <SelectableTextBlock Text="{Binding CrashDetails}"
                             FontSize="{DynamicResource WmclFontBody}"
                             Foreground="{DynamicResource WmclText}"
                             LineHeight="21"
                             TextWrapping="Wrap" />
      </ScrollViewer>
      <WrapPanel Grid.Row="3" Orientation="Horizontal"
                 HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="8"
                 Margin="0,16,0,0">
        <Button Content="保存报告" Classes="secondary dialogAction" Command="{Binding SaveCrashReportCommand}" />
        <Button Content="诊断包" Classes="secondary dialogAction" Command="{Binding SaveDiagnosticPackageCommand}" />
        <Button Content="崩溃报告" Classes="secondary dialogAction" Command="{Binding OpenCrashReportCommand}" />
        <Button Content="打开日志" Classes="secondary dialogAction" Command="{Binding OpenCrashLogCommand}" />
        <Button Content="关闭" Classes="primary dialogAction" Click="OnClose" />
      </WrapPanel>
    </Grid>
  </Border>
</Window>
