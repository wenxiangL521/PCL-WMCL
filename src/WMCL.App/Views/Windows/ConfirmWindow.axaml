<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WMCL.App.Views.ConfirmWindow"
        Width="520"
        MinHeight="210"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterOwner"
        Background="Transparent">

  <Window.Styles>
    <Style Selector="TextBlock.dialogTitle">
      <Setter Property="Foreground" Value="{DynamicResource WmclText}" />
    </Style>
    <Style Selector="TextBlock.dialogTitle.warning">
      <Setter Property="Foreground" Value="{DynamicResource WmclDanger}" />
    </Style>
    <Style Selector="Button.dialogAction">
      <Setter Property="MinWidth" Value="84" />
      <Setter Property="Height" Value="34" />
    </Style>
  </Window.Styles>

  <Border x:Name="DialogSurface"
          Margin="12"
          Padding="24,20"
          Background="{DynamicResource WmclCard}"
          BorderBrush="{DynamicResource WmclDivider}"
          BorderThickness="1"
          CornerRadius="{DynamicResource WmclWindowCorner}"
          BoxShadow="{DynamicResource WmclWindowShadowBox}">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto">
      <TextBlock x:Name="TitleText"
                 Classes="dialogTitle"
                 FontSize="{DynamicResource WmclFontDialogTitle}"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap" />
      <Border x:Name="DialogDivider"
              Grid.Row="1"
              Height="1"
              Margin="0,12,0,16"
              Background="{DynamicResource WmclDivider}" />
      <ScrollViewer x:Name="MessageScroll"
                    Grid.Row="2"
                    MaxHeight="240"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <SelectableTextBlock x:Name="MessageText"
                             FontSize="{DynamicResource WmclFontBody}"
                             Foreground="{DynamicResource WmclTextStrong}"
                             LineHeight="22"
                             TextWrapping="Wrap" />
      </ScrollViewer>
      <StackPanel Grid.Row="3"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="10"
                  Margin="0,22,0,0">
        <Button x:Name="ConfirmButton" Content="确定" Classes="primary dialogAction" Click="OnConfirm" />
        <Button x:Name="CancelButton" Content="取消" Classes="secondary dialogAction" Click="OnCancel" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
