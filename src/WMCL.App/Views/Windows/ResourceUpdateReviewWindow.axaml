<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WMCL.App.Views.ResourceUpdateReviewWindow"
        Width="720" Height="540" MinWidth="440" MinHeight="360"
        Title="{Binding Title}" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WmclPage}">
  <Border Classes="card" Margin="20">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding Title}" Classes="cardTitle" />
        <TextBlock Text="仅更新勾选的资源，请确认当前版本与新版本。" Classes="muted" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding !IsBusy}">
          <Button Content="全选" Classes="taskAction" Command="{Binding SelectAllCommand}" />
          <Button Content="全不选" Classes="taskAction" Command="{Binding SelectNoneCommand}" />
          <TextBlock Text="{Binding SelectedCount, StringFormat='已选择 {0} 项'}" VerticalAlignment="Center" Classes="muted" />
        </StackPanel>
      </StackPanel>
      <Grid Grid.Row="1">
        <TextBlock Text="没有可更新的资源。" IsVisible="{Binding IsEmpty}" Classes="muted"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Items}" IsEnabled="{Binding !IsBusy}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource WmclInput}" BorderBrush="{DynamicResource WmclBlue8}"
                        BorderThickness="1" CornerRadius="{DynamicResource WmclCornerCard}" Padding="10" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <CheckBox Theme="{StaticResource PclCheckBoxTheme}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"
                              VerticalAlignment="Top" AutomationProperties.Name="{Binding Title}" />
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding VersionChange}" Classes="muted" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Detail}" Classes="faint" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
      <StackPanel Grid.Row="2" Spacing="10">
        <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
        <WrapPanel HorizontalAlignment="Right">
          <Button Content="更新所选" Classes="primary taskAction" Command="{Binding ApplySelectedCommand}"
                  IsEnabled="{Binding CanApply}" Margin="0,0,8,4" />
          <Button Content="取消" Classes="taskAction" Command="{Binding CancelCommand}" Margin="0,0,8,4" />
          <Button Content="关闭" Classes="taskAction" Click="OnClose" Margin="0,0,0,4" />
        </WrapPanel>
      </StackPanel>
    </Grid>
  </Border>
</Window>
