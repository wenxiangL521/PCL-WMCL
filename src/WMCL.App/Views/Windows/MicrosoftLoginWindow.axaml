<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:WMCL.App.Views"
        x:Class="WMCL.App.Views.MicrosoftLoginWindow"
        Title="微软登录"
        Width="560"
        Height="480"
        MinWidth="480"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WmclPage}">

  <Border Classes="card" Margin="20">
    <views:MicrosoftLoginView x:Name="LoginView" />
  </Border>
</Window>