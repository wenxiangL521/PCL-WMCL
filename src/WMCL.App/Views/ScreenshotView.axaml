<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WMCL.App.Controls"
             x:Class="WMCL.App.Views.ScreenshotView"
             FontSize="{DynamicResource WmclFontBody}">
  <Grid>

  <Border Classes="card" Margin="0,0,0,10" Padding="14">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
      <controls:WmclCardHeader Title="实例截图" Subtitle="按修改时间排列；支持预览、打开目录与删除。">
        <controls:WmclCardHeader.Action>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="打开截图目录" Classes="secondary" Click="OnOpenFolder" />
            <Button Content="刷新" Click="OnRefresh" />
          </StackPanel>
        </controls:WmclCardHeader.Action>
      </controls:WmclCardHeader>

      <Grid Grid.Row="1" ColumnDefinitions="300,*" ColumnSpacing="12">
        <ListBox x:Name="ShotList" SelectionChanged="OnSelectionChanged" Background="Transparent">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Width="110" Padding="4" CornerRadius="{DynamicResource WmclCornerCard}"
                      Background="{DynamicResource WmclCard}">
                <StackPanel Spacing="3">
                  <Image Source="{Binding Thumbnail}" Height="62" Stretch="UniformToFill" />
                  <TextBlock Text="{Binding Name}" FontSize="{DynamicResource WmclFontFaint}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding SizeText}" FontSize="{DynamicResource WmclFontFaint}" Classes="faint" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Column="1" Background="{DynamicResource WmclCard}" CornerRadius="{DynamicResource WmclCornerCard}">
          <Grid>
            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8" />
            <controls:WmclEmptyState x:Name="EmptyState" Title="没有截图"
                                       Description="在游戏中按 F2 截图，或选择左侧文件预览。" />
          </Grid>
        </Border>
      </Grid>

      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
        <Button Content="打开图片" Classes="secondary" Click="OnOpenImage" />
        <Button Content="删除截图" Classes="secondary" Click="OnDelete" />
        <TextBlock x:Name="StatusText" Classes="faint" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Grid>
  </Border>

    <controls:LoadingOverlay x:Name="Loading" />
  </Grid>
</UserControl>
