<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WMCL.App.Views.LabyModView">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="12">
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="LabyMod" Classes="cardTitle" />
          <TextBlock Text="LabyMod 是独立客户端/加载器。这里提供 CE 页面同源的正式版与快照版 Java 安装器下载；实例创建需使用安装器完成。"
                     Classes="muted" TextWrapping="Wrap" />
          <Button Content="打开 LabyMod 官网" Classes="secondary"
                  HorizontalAlignment="Left" Click="OnWebsiteClick" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="版本" Classes="cardTitle" />
          <ItemsControl ItemsSource="{Binding Versions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" Margin="0,3" MinHeight="42">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Medium" />
                    <TextBlock Text="{Binding Detail}" FontSize="11.5" Classes="faint" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="下载安装器" Classes="secondary"
                          Click="OnDownloadClick" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ProgressBar Value="{Binding Progress}" Maximum="100"
                       IsVisible="{Binding IsDownloading}" />
          <TextBlock Text="{Binding DownloadStatus}" Classes="faint" TextWrapping="Wrap"
                     IsVisible="{Binding DownloadStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
