<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WMCL.App.Controls"
             x:Class="WMCL.App.Views.UpdateView"
             FontSize="{DynamicResource WmclFontBody}">
  <ScrollViewer Classes="page">
    <StackPanel Classes="pageStack">
      <Border Classes="card">
        <StackPanel Classes="cardBody">
          <StackPanel Classes="cardHeader">
            <TextBlock Text="更新" Classes="cardTitle" />
            <TextBlock Text="{Binding CurrentVersion}" Classes="muted" />
            <TextBlock Text="{Binding Runtime}" Classes="faint" />
          </StackPanel>
          <StackPanel Classes="formActions">
            <Button Content="检查更新" Classes="primary" Command="{Binding CheckCommand}" />
            <Button Content="下载更新" Command="{Binding DownloadCommand}" IsEnabled="{Binding CanDownloadUpdate}" />
            <Button Content="安装并重启" Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstallUpdate}" />
            <Button Content="取消" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancelUpdate}" />
          </StackPanel>
          <ProgressBar Value="{Binding Progress}" Maximum="100" IsVisible="{Binding IsBusy}" />
          <TextBlock Text="{Binding ProgressText}" Classes="faint" IsVisible="{Binding IsBusy}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Text="说明" Classes="cardTitle" />
          <TextBlock Text="更新来自 GitHub Releases（可在“设置 → 更新通道/更新方式”调整）。自动替换支持自包含运行形态；通过包管理器安装时请用包管理器更新。"
                     Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
