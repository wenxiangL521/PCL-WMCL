<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WMCL.App.Views.MicrosoftLoginView"
             xmlns:controls="using:WMCL.App.Controls"
             FontSize="{DynamicResource WmclFontBody}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="10">
      <TextBlock Text="微软登录" Classes="cardTitle" />
      <TextBlock Text="生成设备码后会自动复制并打开微软官方网页；请在网页中粘贴设备码完成登录。"
                 Classes="muted"
                 TextWrapping="Wrap"
                 IsVisible="{Binding HasVerificationUri}" />

      <TextBlock Text="{Binding VerificationUri}"
                 Classes="mono"
                 TextWrapping="Wrap"
                 IsVisible="{Binding HasVerificationUri}" />

      <Border Background="{DynamicResource WmclBlue8}"
              CornerRadius="{DynamicResource WmclCornerCard}"
              Padding="10"
              IsVisible="{Binding HasUserCode}">
        <SelectableTextBlock Text="{Binding UserCode}"
                   FontSize="30"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource WmclBlue2}" />
      </Border>

      <TextBlock Text="{Binding Message}"
                 Classes="faint"
                 TextWrapping="Wrap"
                 IsVisible="{Binding HasMessage}" />

      <controls:PclLoadingIndicator IsRunning="{Binding IsBusy}"
                                    IsVisible="{Binding IsBusy}"
                                    HorizontalAlignment="Center" />

      <TextBlock Text="{Binding Status}"
                 Classes="muted"
                 TextWrapping="Wrap" />

      <TextBlock Text="{Binding ClipboardStatus}" Classes="faint" TextWrapping="Wrap"
                 IsVisible="{Binding ClipboardStatus}" />
      <TextBlock Text="{Binding BrowserStatus}" Classes="faint" TextWrapping="Wrap"
                 IsVisible="{Binding BrowserStatus}" />

      <WrapPanel ItemSpacing="8" LineSpacing="8" HorizontalAlignment="Center">
        <Button Content="复制设备码" Classes="secondary"
                Command="{Binding CopyUserCodeCommand}" IsVisible="{Binding HasUserCode}"
                IsEnabled="{Binding IsBusy}" />
        <Button Content="重新获取设备码" Classes="secondary"
                Command="{Binding StartCommand}" IsVisible="{Binding CanRetry}" />
        <Button Content="打开登录页"
                Classes="primary"
                Command="{Binding OpenVerificationCommand}"
                IsVisible="{Binding HasVerificationUri}" />
        <Button Content="去设置"
                Classes="secondary"
                IsVisible="{Binding ShowConfigurationHint}"
                Click="OnOpenSettingsClick" />
        <Button x:Name="CancelButton"
                Content="返回"
                Click="OnCancelClick" />
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>