<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WMCL.App.Views.VersionSelectView">

  <Grid ColumnDefinitions="300,*">
    <Border Grid.Column="0" Background="{DynamicResource WmclSidebar}">
      <StackPanel Margin="15,15,15,12" Spacing="10">
        <TextBlock Text="版本目录" Classes="cardTitle" />
        <TextBlock Text="{Binding VersionsDirectory}"
                   Classes="faint"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding CountText}" Classes="muted" />
        <Button Content="打开 versions 目录"
                HorizontalAlignment="Stretch"
                Command="{Binding OpenFolderCommand}" />
        <Button Content="下载新版本"
                HorizontalAlignment="Stretch"
                Classes="secondary"
                Command="{Binding DownloadCommand}" />
        <TextBlock Text="单击右侧版本即可选择并返回启动页。"
                   Classes="faint"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0" />
      </StackPanel>
    </Border>

    <Border Grid.Column="1"
            Classes="card"
            Margin="25,15,25,15">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Text="已安装版本" Classes="cardTitle" />
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Versions}"
                 SelectedItem="{Binding SelectedVersion}"
                 PointerReleased="OnVersionListPointerReleased"
                 Margin="0,8,0,0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Subtitle}" Classes="faint" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="1"
                   Text="没有已安装版本，请点击左侧“下载新版本”。"
                   Classes="faint"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   IsVisible="{Binding !HasVersions}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
