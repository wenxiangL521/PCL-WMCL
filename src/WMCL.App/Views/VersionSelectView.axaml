<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WMCL.App.Controls"
             x:Class="WMCL.App.Views.VersionSelectView"
             Focusable="True">

  <UserControl.Styles>
    <Style Selector="Button.folderMenu">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource WmclTextMuted}" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="300,*">
    <Border Grid.Column="0" Background="{DynamicResource WmclSidebar}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="15,15,15,12" Spacing="8">
        <TextBlock Text="文件夹列表" Classes="cardTitle" />
        <ListBox ItemsSource="{Binding Folders}"
                 SelectedItem="{Binding SelectedFolder}"
                 MaxHeight="150">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Path}"
                             Classes="faint"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="⚙"
                        Classes="folderMenu"
                        ToolTip.Tip="文件夹菜单">
                  <Button.Flyout>
                    <MenuFlyout>
                      <MenuItem Header="重命名"
                                Tag="{Binding}"
                                Click="OnFolderMenuRenameClick" />
                      <MenuItem Header="刷新版本列表"
                                Tag="{Binding}"
                                Click="OnFolderMenuRefreshClick" />
                      <MenuItem Header="打开文件夹"
                                Tag="{Binding}"
                                Click="OnFolderMenuOpenClick" />
                      <MenuItem Header="移除文件夹"
                                Tag="{Binding}"
                                Click="OnFolderMenuRemoveClick" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="添加或导入" Classes="cardTitle" Margin="0,8,0,0" />
        <Button Content="添加已有文件夹"
                HorizontalAlignment="Stretch"
                Click="OnAddGameFolderClick" />
        <Button Content="新建 .minecraft 文件夹"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Click="OnCreateGameFolderClick" />
        <Button Content="{Binding ImportButtonText}"
                HorizontalAlignment="Stretch"
                Click="OnImportLocalModpackClick" />
        <TextBlock Text="{Binding ImportStatus}"
                   Classes="faint"
                   TextWrapping="Wrap"
                   IsVisible="{Binding ImportStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Button Content="移除文件夹"
                HorizontalAlignment="Stretch"
                Command="{Binding RemoveFolderCommand}"
                IsEnabled="{Binding CanRemoveFolder}" />

        <TextBlock Text="版本操作" Classes="cardTitle" Margin="0,8,0,0" />
        <Button Content="打开 versions 目录"
                HorizontalAlignment="Stretch"
                Command="{Binding OpenFolderCommand}" />
        <Button Content="下载新版本"
                HorizontalAlignment="Stretch"
                Classes="secondary"
                Command="{Binding DownloadCommand}" />
        <Button Content="{Binding HiddenToggleText}"
                HorizontalAlignment="Stretch"
                Command="{Binding ToggleHiddenVersionsCommand}" />
        <TextBlock Text="{Binding CountText}" Classes="faint" Margin="0,4,0,0" />
        <TextBlock Text="单击右侧版本即可选择并返回启动页；F11 显示/隐藏隐藏版本。"
                   Classes="faint"
                   TextWrapping="Wrap" />
      </StackPanel>
      </ScrollViewer>
    </Border>

    <ScrollViewer Grid.Column="1"
                  Margin="25,25,25,10"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="10">
        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <controls:InstalledVersionCard Margin="0,0,0,15" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Classes="card"
                IsVisible="{Binding !HasGroups}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="40">
          <StackPanel Spacing="10" Margin="15">
            <TextBlock Text="{Binding EmptyTitle}"
                       FontSize="19"
                       FontWeight="Bold"
                       Foreground="{DynamicResource WmclBlue2}"
                       HorizontalAlignment="Center" />
            <Border Height="2" Background="{DynamicResource WmclBlue3}" />
            <TextBlock Text="{Binding EmptyMessage}"
                       Classes="muted"
                       TextWrapping="Wrap"
                       MaxWidth="360" />
            <Button Content="下载游戏"
                    Classes="primary"
                    HorizontalAlignment="Center"
                    MinWidth="140"
                    IsVisible="{Binding !ShowHidden}"
                    Command="{Binding DownloadCommand}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
