<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WMCL.App.Views.VersionSelectView">

  <Grid ColumnDefinitions="300,*">
    <Border Grid.Column="0" Background="{DynamicResource WmclSidebar}">
      <StackPanel Margin="15,15,15,12" Spacing="10">
        <TextBlock Text="文件夹列表" Classes="cardTitle" />
        <Border Classes="card" Padding="10" Background="{DynamicResource WmclBlue8}">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding FolderName}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding GameDirectory}"
                       Classes="faint"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding CountText}" Classes="faint" />
          </StackPanel>
        </Border>

        <TextBlock Text="版本操作" Classes="cardTitle" Margin="0,8,0,0" />
        <Button Content="打开 versions 目录"
                HorizontalAlignment="Stretch"
                Command="{Binding OpenFolderCommand}" />
        <Button Content="下载新版本"
                HorizontalAlignment="Stretch"
                Classes="secondary"
                Command="{Binding DownloadCommand}" />
        <TextBlock Text="单击右侧版本即可选择并返回启动页。"
                   Classes="faint"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Column="1"
                  Margin="25,15,25,15"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="10">
        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card" Margin="0,0,0,10">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding Title}" Classes="cardTitle" />
                  <ListBox ItemsSource="{Binding Versions}"
                           Background="Transparent"
                           PointerReleased="OnVersionListPointerReleased">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Subtitle}" Classes="faint" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="没有已安装版本，请点击左侧“下载新版本”。"
                   Classes="faint"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,0"
                   IsVisible="{Binding !HasGroups}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
