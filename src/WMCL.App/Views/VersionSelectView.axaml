<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WMCL.App.Views.VersionSelectView">

  <Grid ColumnDefinitions="300,*">
    <Border Grid.Column="0"
            Background="{DynamicResource WmclSidebar}"
            BorderThickness="0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="15,15,15,12">
        <TextBlock Grid.Row="0" Text="已安装版本" Classes="cardTitle" Margin="5,0,0,8" />
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Versions}"
                 SelectedItem="{Binding SelectedVersion}"
                 PointerReleased="OnVersionListPointerReleased">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="1">
                <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Subtitle}" Classes="faint" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Row="2"
                Content="下载新版本"
                Classes="secondary"
                HorizontalAlignment="Stretch"
                Command="{Binding DownloadCommand}" />
      </Grid>
    </Border>

    <Border Grid.Column="1" Classes="card" Margin="25,15,25,15">
      <Grid RowDefinitions="*,Auto" RowSpacing="10">
      <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding SelectedVersionTitle}"
                     FontSize="24"
                     FontWeight="Bold"
                     Foreground="{DynamicResource WmclBlue2}" />
          <TextBlock Text="{Binding SelectedVersionInfo}" Classes="muted" />
          <TextBlock Text="{Binding VersionLoader, StringFormat='加载器：{0}'}" Classes="faint" />
          <TextBlock Text="{Binding VersionJava, StringFormat='运行时：{0}'}" Classes="faint" />
          <TextBlock Text="{Binding VersionPath}" Classes="faint" TextWrapping="Wrap" />
          <TextBlock Text="启动器只会在这里列出已安装的版本。需要安装新版本请点击左侧“下载新版本”。"
                     Classes="faint"
                     TextWrapping="Wrap"
                     Margin="0,10,0,0" />
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
        <Button Content="选择此版本" Classes="primary"
                Command="{Binding ConfirmCommand}"
                IsEnabled="{Binding HasVersions}" />
        <Button Content="版本设置" Classes="secondary"
                Command="{Binding OpenSettingsCommand}"
                IsEnabled="{Binding HasVersions}" />
      </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
