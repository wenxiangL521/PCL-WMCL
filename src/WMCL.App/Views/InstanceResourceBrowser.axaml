<views:ResourceBrowserView xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:WMCL.App.Views" xmlns:controls="using:WMCL.App.Controls" xmlns:motion="using:WMCL.App.Animation" x:Class="WMCL.App.Views.InstanceResourceBrowser"
             x:Name="Browser" FontSize="{DynamicResource WmclFontBody}">
 <Grid>

 <StackPanel Classes="pageStack">
  <StackPanel Classes="pageStack" IsVisible="{Binding !HasResourceDetail}">
   <Border Classes="card search">
    <StackPanel Spacing="16">
     <TextBlock Text="{Binding ContentTypeLabel, StringFormat='搜索{0}'}" Classes="cardTitle"/>
     <WrapPanel x:Name="SearchConditions" ItemSpacing="20" LineSpacing="11">
       <controls:WmclFormRow Label="名称" LabelWidth="44" MinimumInputWidth="0" Width="260">
        <TextBox x:Name="NameSearchTextBox" Text="{Binding DownloadSearchText}" ToolTip.Tip="{Binding DownloadSearchText}"/>
       </controls:WmclFormRow>
       <controls:WmclFormRow Label="来源" LabelWidth="44" MinimumInputWidth="0" Width="260">
        <ComboBox x:Name="SourceSearchComboBox" ItemsSource="{Binding Platforms}" SelectedItem="{Binding SelectedPlatform}"
                  ToolTip.Tip="{Binding SelectedPlatform}" HorizontalAlignment="Stretch"/>
       </controls:WmclFormRow>
       <controls:WmclFormRow Label="版本" LabelWidth="44" MinimumInputWidth="0" Width="260">
        <controls:VersionPicker x:Name="VersionSearchTextBox" ItemsSource="{Binding SearchGameVersions}" SelectedItem="{Binding SearchGameVersion, Mode=TwoWay}" Watermark="全部"/>
       </controls:WmclFormRow>
      </WrapPanel>
     <WrapPanel>
      <Button Content="搜索" Command="{Binding SearchDownloadsCommand}" Classes="primary" MinWidth="140" Height="35" Margin="0,0,20,0"/>
      <Button Content="重置条件" Command="{Binding ResetSearchCommand}" MinWidth="140" Height="35" Margin="0,0,20,0"/>

     </WrapPanel>
    </StackPanel>
   </Border>
    <controls:WmclEmptyState Title="输入条件开始搜索"
                              Description="可搜索 Modrinth / CurseForge 上的资源"
                              IsVisible="{Binding ShowSearchEmpty}">
      <controls:WmclEmptyState.Action>
        <Button Content="重置条件" Classes="tertiary" Command="{Binding ResetSearchCommand}" />
      </controls:WmclEmptyState.Action>
    </controls:WmclEmptyState>
    <Border Classes="hint error" IsVisible="{Binding IsSearchError}">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding DownloadStatus}" Classes="muted" TextWrapping="Wrap" />
        <Button Content="重试" Classes="secondary" HorizontalAlignment="Left" Command="{Binding SearchDownloadsCommand}" />
      </StackPanel>
    </Border>
    <Border Classes="card" Padding="12" IsVisible="{Binding ShowDownloadResults}">
    <ListBox x:Name="SearchResultList" Classes="resourceRows" motion:ListItemReveal.Enabled="True" ItemsSource="{Binding DownloadResults}" SelectedItem="{Binding SelectedDownloadProject}" AutoScrollToSelectedItem="False">
     <ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
      <controls:RemoteImage Url="{Binding IconUrl}" Width="{DynamicResource WmclResourceListIconSize}" Height="{DynamicResource WmclResourceListIconSize}" Stretch="Uniform"/>
      <StackPanel Grid.Column="1" Spacing="4">
      <TextBlock Text="{Binding Title}" FontSize="{DynamicResource WmclFontBody}" TextTrimming="CharacterEllipsis"/>
<TextBlock Text="{Binding Description}" FontSize="12" Classes="faint" TextTrimming="CharacterEllipsis"/>
       <TextBlock Text="{Binding Downloads, StringFormat='下载 {0:N0}'}" FontSize="11" Classes="faint"/>
       </StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Border>
   <Button Content="加载更多" Command="{Binding LoadMoreDownloadsCommand}" IsVisible="{Binding CanLoadMoreResources}" HorizontalAlignment="Center"/>
   <TextBlock Text="{Binding DownloadStatus}" Classes="faint" TextWrapping="Wrap" HorizontalAlignment="Center"/>
  </StackPanel>
  <StackPanel x:Name="ResourceDetailPanel" Spacing="15" IsVisible="{Binding HasResourceDetail}" motion:ResourceDetailMotion.Enabled="True">
   <Button x:Name="ReturnToResultsButton" Content="返回搜索结果" Click="OnReturnToResultsClick" HorizontalAlignment="Left" IsEnabled="{Binding !IsDownloadBusy}"/>
   <Border Classes="card detail">
    <StackPanel Classes="cardBody">
     <StackPanel Orientation="Horizontal" Spacing="12">
      <Button Content="{Binding ProjectPageText}" Command="{Binding OpenSelectedProjectCommand}" />
      <Button Content="复制名称" Command="{Binding CopyProjectNameCommand}" />
     </StackPanel>
     <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
      <controls:RemoteImage Url="{Binding SelectedDownloadProject.IconUrl}" Width="{DynamicResource WmclResourceDetailIconSize}" Height="{DynamicResource WmclResourceDetailIconSize}" Stretch="Uniform"/>
      <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{Binding SelectedDownloadProject.Title}" Classes="resourceTitle" />
      <TextBlock Text="{Binding SelectedDownloadProject.Description}" Classes="muted" TextWrapping="Wrap"/></StackPanel>
     </Grid>
     <controls:ResourceFavoritePicker DataContext="{Binding Favorite}"/>
    </StackPanel>
   </Border>
   <Border Classes="card detail">
    <StackPanel Classes="cardBody">
     <TextBlock Text="安装目标" Classes="cardTitle"/>
     <TextBlock x:Name="LockedTargetText" Text="{Binding SelectedInstance}" IsVisible="{Binding IsTargetLocked, ElementName=Browser}" TextWrapping="Wrap"/>
      <ComboBox x:Name="TargetInstanceComboBox" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance, Mode=OneWay}"
                SelectionChanged="OnTargetInstanceChanged" IsVisible="{Binding !IsTargetLocked, ElementName=Browser}"
                HorizontalAlignment="Stretch" IsEnabled="{Binding !IsDownloadBusy}"/>
     <StackPanel IsVisible="{Binding ShowDataPacks}" Spacing="8">
      <TextBlock Text="目标存档" Classes="faint"/>
      <ComboBox ItemsSource="{Binding DataPackWorlds}" SelectedItem="{Binding SelectedDataPackWorld}" HorizontalAlignment="Stretch"/>
     </StackPanel>
     <TextBlock Text="版本筛选" Classes="faint" IsVisible="{Binding HasResourceVersionFilters}"/>
     <ListBox Classes="versionFilters" ItemsSource="{Binding ResourceVersionFilters}" SelectedItem="{Binding SelectedResourceVersionFilter}" IsVisible="{Binding HasResourceVersionFilters}" HorizontalAlignment="Stretch">
      <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </StackPanel>
   </Border>
   <Border Classes="card detail">
    <StackPanel Classes="cardBody">
     <TextBlock Text="版本列表" Classes="cardTitle"/>
     <ItemsControl x:Name="VersionGroups" ItemsSource="{Binding ResourceVersionGroups}" IsEnabled="{Binding !IsDownloadBusy}" controls:ResourceSelectionNavigation.Request="{Binding FavoriteOpenRequest}">
      <ItemsControl.ItemTemplate><DataTemplate><controls:ResourceVersionGroupCard Margin="0,0,0,10"/></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <WrapPanel>
      <Button Content="保存文件" Click="OnSaveResourceFileClick" IsEnabled="{Binding CanSaveDownload}" Classes="secondary" Margin="0,0,15,0"/>
      <Button Content="安装所选版本" Command="{Binding InstallDownloadCommand}" IsEnabled="{Binding CanDownload}" Classes="primary" Margin="0,0,15,0"/>
      <Button Content="取消安装" Command="{Binding CancelDownloadCommand}" IsVisible="{Binding CanCancelDownload}" Classes="secondary" Margin="0,0,15,0"/>
     </WrapPanel>
     <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" IsVisible="{Binding IsDownloadBusy}"/>
     <TextBlock Text="{Binding DownloadStatus}" Classes="muted" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
  </StackPanel>
 </StackPanel>

  <controls:LoadingOverlay IsRunning="{Binding IsDownloadBusy}"
                            IsVisible="{Binding !HasResourceDetail}" />
 </Grid>
</views:ResourceBrowserView>
