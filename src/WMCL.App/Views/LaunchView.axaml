<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WMCL.App.Controls"
             xmlns:motion="using:WMCL.App.Animation"
             x:Class="WMCL.App.Views.LaunchView">

  <UserControl.Styles>
    <Style Selector="RadioButton.accountPill">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="13.5"
                  Padding="14,0"
                  MinHeight="27">
            <ContentPresenter Content="{TemplateBinding Content}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Setter Property="Background" Value="#22FFFFFF" />
      <Setter Property="Foreground" Value="{DynamicResource WmclText}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="27" />
    </Style>
    <Style Selector="RadioButton.accountPill:pointerover">
      <Setter Property="Background" Value="{DynamicResource WmclBlue8}" />
    </Style>
    <Style Selector="RadioButton.accountPill Path">
      <Setter Property="Fill" Value="{DynamicResource WmclBlue3}" />
    </Style>
    <Style Selector="RadioButton.accountPill TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource WmclBlue3}" />
    </Style>
    <Style Selector="RadioButton.accountPill:checked Path">
      <Setter Property="Fill" Value="White" />
    </Style>
    <Style Selector="RadioButton.accountPill:checked TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.accountPill:checked">
      <Setter Property="Background" Value="{DynamicResource WmclBlue3}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </UserControl.Styles>

  <!-- PCL2 PageLaunchLeft：300px 登录/启动区；PageLaunchRight：25px 外边距 + 日志卡片。 -->
  <Grid ColumnDefinitions="300,*">
    <Border Grid.Column="0"
            Background="{DynamicResource WmclSidebar}"
            BorderThickness="0">
      <Grid RowDefinitions="*,Auto,Auto,20" Margin="20,0">
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Center"
                    Spacing="8">
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      Spacing="6">
            <RadioButton x:Name="OnlineAccountRadio"
                         Classes="accountPill"
                         GroupName="AccountType"
                         IsChecked="{Binding IsMicrosoftAccount, Mode=OneWay}"
                         Click="OnOnlineAccountClick">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Path Data="M511.488256 95.184408c35.310345 22.516742 95.184408 55.78011 167.34033 84.437781 75.738131 29.681159 148.405797 40.93953 191.392304 45.033483v353.615193c0 73.691154-50.662669 164.781609-136.123938 244.101949C649.65917 901.181409 558.568716 942.12094 512 942.12094c-46.568716 0-137.65917-40.93953-222.096952-119.748126C204.441779 742.54073 153.77911 651.450275 153.77911 577.247376v-353.103448c42.474763-4.093953 116.165917-15.352324 191.904048-45.545227 75.226387-30.192904 133.565217-63.456272 165.805098-83.414293M512 0c-4.093953 0-8.187906 1.535232-11.258371 3.582209l-14.84058 10.234882c-1.023488 0.511744-67.550225 47.592204-170.410794 88.531735-100.813593 39.916042-198.556722 41.963018-199.58021 41.963018l-25.075462 0.511744c-10.746627 0.511744-18.934533 8.187906-18.934533 18.422789v414.000999c0 216.97951 286.064968 446.24088 440.09995 446.24088s440.09995-229.261369 440.09995-445.729136V163.758121c0-10.234883-8.69965-18.422789-18.934533-18.422789l-24.563718-0.511744c-1.023488 0-98.766617-2.046977-199.58021-41.963018-103.372314-40.93953-170.410795-88.01999-170.922538-88.531734L523.258371 3.582209c-3.070465-2.558721-7.164418-3.582209-11.258371-3.582209z M743.308346 410.930535l-260.477761 260.477761c-15.864068 15.864068-41.963018 15.864068-57.827087 0l-144.823588-144.823588c-15.864068-15.864068-15.864068-41.963018 0-57.827087 8.187906-8.187906 18.422789-11.770115 29.169415-11.770115 10.234883 0 20.981509 4.093953 29.169416 11.770115l115.654173 115.654173L685.993003 352.591704c15.864068-15.864068 41.963018-15.864068 57.827087 0 15.352324 16.375812 15.352324 42.474763-0.511744 58.338831z" Width="14" Height="14" Stretch="Uniform" />
              <TextBlock Text="正版" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
            <RadioButton x:Name="OfflineAccountRadio"
                         Classes="accountPill"
                         GroupName="AccountType"
                         IsChecked="{Binding IsOfflineAccount, Mode=OneWay}"
                         Click="OnOfflineAccountClick">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Path Data="M533.293176 788.841412a60.235294 60.235294 0 1 1 85.202824 85.202823l-42.616471 42.586353c-129.355294 129.385412-339.124706 129.385412-468.510117 0-129.385412-129.385412-129.385412-339.124706 0-468.510117l42.586353-42.616471a60.235294 60.235294 0 1 1 85.202823 85.202824l-42.61647 42.586352a210.823529 210.823529 0 1 0 298.164706 298.164706l42.586352-42.61647z m255.548236-255.548236l42.61647-42.586352a210.823529 210.823529 0 1 0-298.164706-298.164706l-42.586352 42.61647a60.235294 60.235294 0 1 1-85.202824-85.202823l42.616471-42.586353c129.355294-129.385412 339.124706-129.385412 468.510117 0 129.385412 129.385412 129.385412 339.124706 0 468.510117l-42.586353 42.616471a60.235294 60.235294 0 1 1-85.202823-85.202824zM192.542118 192.542118a60.235294 60.235294 0 0 1 85.202823 0l553.712941 553.712941a60.235294 60.235294 0 0 1-85.202823 85.202823L192.542118 277.744941a60.235294 60.235294 0 0 1 0-85.202823z" Width="14" Height="14" Stretch="Uniform" />
              <TextBlock Text="离线" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
            <RadioButton x:Name="AuthlibAccountRadio"
                         Classes="accountPill"
                         GroupName="AccountType"
                         IsVisible="{Binding IsAuthlibOptionVisible}"
                         IsChecked="{Binding IsAuthlibAccount, Mode=OneWay}"
                         Click="OnAuthlibAccountClick">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Path Data="M533.293176 788.841412a60.235294 60.235294 0 1 1 85.202824 85.202823l-42.616471 42.586353c-129.355294 129.385412-339.124706 129.385412-468.510117 0-129.385412-129.385412-129.385412-339.124706 0-468.510117l42.586353-42.616471a60.235294 60.235294 0 1 1 85.202823 85.202824l-42.61647 42.586352a210.823529 210.823529 0 1 0 298.164706 298.164706l42.586352-42.61647z m255.548236-255.548236l42.61647-42.586352a210.823529 210.823529 0 1 0-298.164706-298.164706l-42.586352 42.61647a60.235294 60.235294 0 1 1-85.202824-85.202823l42.616471-42.586353c129.355294-129.385412 339.124706-129.385412 468.510117 0 129.385412 129.385412 129.385412 339.124706 0 468.510117l-42.586353 42.616471a60.235294 60.235294 0 1 1-85.202823-85.202824zM192.542118 192.542118a60.235294 60.235294 0 0 1 85.202823 0l553.712941 553.712941a60.235294 60.235294 0 0 1-85.202823 85.202823L192.542118 277.744941a60.235294 60.235294 0 0 1 0-85.202823z" Width="14" Height="14" Stretch="Uniform" />
              <TextBlock Text="第三方" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          </StackPanel>

          <ComboBox ItemsSource="{Binding AuthlibAccounts}"
                    SelectedItem="{Binding SelectedAuthlibAccount}"
                    IsVisible="{Binding HasAuthlibAccounts}"
                    motion:Motion.AnimateOnVisible="True"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Server}" Classes="faint" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <StackPanel HorizontalAlignment="Center"
                      Spacing="4"
                      Margin="0,0,0,7">
            <Border Width="64" Height="64"
                    ClipToBounds="True"
                    Background="Transparent">
              <controls:SkinFaceImage Source="{Binding AccountSkin}"
                                      Width="56"
                                      Height="56" />
            </Border>
            <TextBlock Text="{Binding PlayerName}"
                       FontWeight="SemiBold"
                       FontSize="15"
                       IsVisible="{Binding !IsOfflineAccount}"
                       HorizontalAlignment="Center" />
          </StackPanel>

          <TextBox Text="{Binding PlayerName}"
                   Watermark="玩家名"
                   IsVisible="{Binding IsOfflineAccount}"
                   motion:Motion.AnimateOnVisible="True" />
          <Button x:Name="SkinClosetButton" Content="皮肤衣柜" Classes="secondary"
                  HorizontalAlignment="Center"
                  Click="OnSkinClosetClick"
                  IsVisible="{Binding IsAuthlibAccount}" />
          <StackPanel Spacing="7"
                      IsVisible="{Binding IsMicrosoftAccount}"
                      motion:Motion.AnimateOnVisible="True">
            <StackPanel Orientation="Horizontal" Spacing="7"
                        HorizontalAlignment="Center">
              <Button Content="皮肤与披风" Classes="secondary"
                      Click="OnOpenMsSkinClick"
                      IsVisible="{Binding !IsOfflineAccount}" />
              <Button Content="{Binding SkinEditorButtonText}"
                      Command="{Binding ToggleSkinEditorCommand}"
                      Classes="secondary" />
              <Button Content="刷新皮肤"
                      Command="{Binding RefreshSkinCommand}"
                      Classes="secondary"
                      IsVisible="{Binding !IsOfflineAccount}" />
              <Button Content="保存皮肤"
                      Classes="secondary"
                      Click="OnSaveSkinClick"
                      IsVisible="{Binding HasAccountSkinFile}" />
            </StackPanel>
            <Border x:Name="SkinEditorPanel"
                    IsVisible="{Binding IsSkinEditorVisible}"
                    motion:Motion.AnimateOnVisible="True">
              <StackPanel Spacing="7" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                  <ComboBox ItemsSource="{Binding SkinVariants}"
                            SelectedItem="{Binding SelectedSkinVariant}"
                            Width="95" />
                  <Button Content="修改皮肤" Classes="secondary"
                          Click="OnUploadSkinClick" />
                </StackPanel>
                <WrapPanel HorizontalAlignment="Center" ItemSpacing="7" LineSpacing="5"
                           IsVisible="{Binding HasCapes}">
                  <ComboBox x:Name="CapeBox" ItemsSource="{Binding Capes}"
                            SelectedItem="{Binding SelectedCape}" Width="135"
                            AutomationProperties.Name="披风">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Content="应用披风" Classes="secondary"
                          Command="{Binding ChangeCapeCommand}"
                          IsEnabled="{Binding !IsChangingCape}" />
                  <Button Content="刷新披风" Classes="secondary"
                          Command="{Binding RefreshCapesCommand}" />
                </WrapPanel>
                <TextBlock Text="{Binding CapeStatus}" Classes="faint" TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           IsVisible="{Binding CapeStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Button x:Name="CdkeyButton" Content="使用 CDKEY 兑换奖励" Classes="secondary"
                        Click="OnRedeemCdkeyClick" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="7" Margin="0,10,0,0">
          <ProgressBar Value="{Binding Progress}"
                       Maximum="100"
                       IsVisible="{Binding IsBusy}" />
          <TextBlock Text="{Binding ProgressText}"
                     Classes="faint"
                     IsVisible="{Binding IsBusy}"
                     TextTrimming="CharacterEllipsis" />
          <Button Classes="primary launchButton"
                  HorizontalAlignment="Stretch"
                  BorderBrush="{DynamicResource WmclBlue2}"
                  Command="{Binding LaunchCommand}"
                  IsEnabled="{Binding CanLaunch}">
            <StackPanel Spacing="1">
              <TextBlock Text="{Binding LaunchButtonText}"
                         FontSize="18"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource WmclBlue2}"
                         HorizontalAlignment="Center" />
              <TextBlock Text="{Binding LaunchButtonSubtitle}"
                         FontSize="10"
                         Foreground="{DynamicResource WmclTextFaint}"
                         HorizontalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Button>
          <Button Content="取消"
                  HorizontalAlignment="Stretch"
                  Command="{Binding CancelCommand}"
                  IsVisible="{Binding CanCancel}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="6" Margin="0,10,0,0">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
            <Button x:Name="VersionButton"
                    Content="版本选择"
                    HorizontalAlignment="Stretch"
                    Click="OnOpenVersionSelectClick" />
            <Button Grid.Column="1"
                    Content="设置"
                    Classes="secondary"
                    Command="{Binding OpenVersionSettingsCommand}"
                    IsEnabled="{Binding CanOpenVersionSettings}" />
          </Grid>
          <TextBlock Text="{Binding Status}"
                     Classes="faint"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Margin="25,25,25,10">
      <StackPanel Spacing="15">
        <Border IsVisible="{Binding HasModpackLaunchError}"
                Background="{DynamicResource WmclWarningBackground}"
                BorderBrush="{DynamicResource WmclWarningBorder}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="12">
          <StackPanel Spacing="8">
            <TextBlock Text="整合包更新未完成" FontWeight="SemiBold"
                       Foreground="{DynamicResource WmclWarningText}" />
            <TextBlock Text="必须完成作者要求的更新后才能启动。"
                       TextWrapping="Wrap" Foreground="{DynamicResource WmclWarningText}" />
            <TextBlock Text="{Binding ModpackLaunchError}" TextWrapping="Wrap"
                       Foreground="{DynamicResource WmclWarningText}" />
            <Button Content="重试启动" Classes="secondary" HorizontalAlignment="Left"
                    Command="{Binding LaunchCommand}" IsEnabled="{Binding CanLaunch}" />
          </StackPanel>
        </Border>
        <Border IsVisible="{Binding HasCrashReport}"
                Background="{DynamicResource WmclCrashBackground}"
                BorderBrush="{DynamicResource WmclCrashBorder}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="12">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding CrashTitle}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource WmclCrashTitle}" />
            <TextBlock Text="{Binding CrashDetails}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource WmclCrashText}" />
            <WrapPanel Orientation="Horizontal">
              <Button Content="保存报告" Classes="secondary" Command="{Binding SaveCrashReportCommand}" Margin="0,0,6,6" />
              <Button Content="诊断包" Classes="secondary" Command="{Binding SaveDiagnosticPackageCommand}" Margin="0,0,6,6" />
              <Button Content="崩溃报告" Classes="secondary" Command="{Binding OpenCrashReportCommand}" Margin="0,0,6,6" />
              <Button Content="打开日志" Classes="secondary" Command="{Binding OpenCrashLogCommand}" Margin="0,0,6,6" />
              <Button Content="日志目录" Classes="secondary" Command="{Binding OpenCrashLogFolderCommand}" Margin="0,0,6,6" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7">
              <TextBlock Text="Minecraft 新闻" FontSize="13" FontWeight="SemiBold"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="刷新" Classes="secondary"
                      Command="{Binding LoadHomeNewsCommand}" />
              <Button Grid.Column="2" Content="查看全部" Classes="secondary"
                      Click="OnOpenNewsClick" />
            </Grid>
            <ItemsControl ItemsSource="{Binding HomeNews}" IsVisible="{Binding HasHomeNews}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Width="300" Background="{DynamicResource WmclCard}" CornerRadius="5" Padding="8"
                          Cursor="Hand" ToolTip.Tip="在浏览器中打开"
                          PointerReleased="OnHomeNewsClick">
                    <Grid ColumnDefinitions="96,*" ColumnSpacing="8">
                      <Border Width="96" Height="64" CornerRadius="4" ClipToBounds="True"
                              Background="{DynamicResource WmclSidebar}"
                              IsVisible="{Binding HasImage}">
                        <controls:RemoteImage Url="{Binding Image}" Stretch="UniformToFill" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"
                                   MaxHeight="38" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding PublishDateText}" Classes="faint" />
                        <TextBlock Text="{Binding Description}" Classes="muted" FontSize="11"
                                   TextWrapping="Wrap" MaxHeight="30" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding HomeNewsStatus}" Classes="faint" TextWrapping="Wrap"
                       IsVisible="{Binding HomeNewsStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>

        <ContentControl Content="{Binding CustomHomePage}"
                        IsVisible="{Binding HasCustomHomePage}" />

        <Border Classes="card" IsVisible="{Binding HasLaunchLog}">
          <StackPanel Spacing="8">
            <TextBlock Text="启动日志"
                       FontSize="13"
                       FontWeight="SemiBold" />
            <Border Height="1" Background="{DynamicResource WmclBorder}" />
            <TextBox x:Name="LogBox"
                     Text="{Binding Log, Mode=OneWay}"
                     IsReadOnly="True"
                     Focusable="False"
                     IsTabStop="False"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     FontFamily="DejaVu Sans Mono, Noto Sans Mono, monospace"
                     FontSize="11"
                     Background="Transparent"
                     BorderThickness="0"
                     CornerRadius="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
