<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WMCL.App.Views.AuthlibLoginView"
             FontSize="{DynamicResource WmclFontBody}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="8">
      <TextBlock Text="第三方登录" Classes="cardTitle" />
      <TextBlock Text="使用 Yggdrasil / Authlib-Injector 认证服务器。登录后会把 authlib-injector 注入启动参数。"
                 Classes="muted" TextWrapping="Wrap" />

      <TextBox Text="{Binding Server}"
               Watermark="认证服务器 URL，例如 https://example.com/api/yggdrasil" />

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <TextBox Text="{Binding NideServerId}" Watermark="Nide 服务器 ID（可选）" />
        <Button Grid.Column="1" Content="使用 Nide" Classes="secondary"
                Command="{Binding UseNideCommand}" />
      </Grid>

      <TextBox Text="{Binding UserName}" Watermark="账号 / 邮箱" />
      <TextBox Text="{Binding Password}" Watermark="密码" PasswordChar="●" />

      <TextBlock Text="{Binding Status}" Classes="faint" TextWrapping="Wrap" />
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
        <Button Content="登录" Classes="primary"
                Command="{Binding LoginCommand}" IsEnabled="{Binding !IsBusy}" />
        <Button x:Name="CancelButton"
                Content="返回"
                Click="OnCancelClick" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>