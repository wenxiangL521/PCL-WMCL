<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:motion="clr-namespace:WMCL.App.Animation"
             x:Class="WMCL.App.Views.InstallView">
  <UserControl.Styles>
    <Style Selector="Button.minecraftHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="15,0" />
      <Setter Property="Height" Value="40" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.startPill">
      <Setter Property="Height" Value="35" />
      <Setter Property="MinWidth" Value="170" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="20,0" />
      <Setter Property="FontSize" Value="14" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">
    <ScrollViewer x:Name="PageScroll"
                  Grid.Row="0"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">
        <Border Classes="card" Padding="0" HorizontalAlignment="Stretch">
          <StackPanel>
            <Button Classes="minecraftHeader"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Click="OnToggleMinecraftClick"
                    ToolTip.Tip="展开/收起版本选择">
              <Grid ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="12"
                    HorizontalAlignment="Stretch">
                <TextBlock Text="Minecraft"
                           Classes="cardTitle"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Download.SelectedVersionTitle}"
                           Classes="faint"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2"
                           Text="⌄"
                           FontSize="15"
                           Foreground="{DynamicResource WmclTextMuted}"
                           VerticalAlignment="Center" />
              </Grid>
            </Button>
            <StackPanel Margin="15,0,15,15" Spacing="9"
                        IsVisible="{Binding IsMinecraftExpanded, FallbackValue=False}"
                        motion:Motion.AnimateOnVisible="True">
              <Grid ColumnDefinitions="*,Auto">
                <ComboBox ItemsSource="{Binding Download.Versions}"
                          SelectedItem="{Binding Download.SelectedVersion}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Id}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="已安装"
                                   Classes="faint"
                                   Foreground="{DynamicResource WmclBlue3}"
                                   IsVisible="{Binding IsInstalled}"
                                   Margin="8,0,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1"
                        Content="刷新"
                        Classes="secondary"
                        Command="{Binding Download.RefreshCommand}"
                        Margin="7,0,0,0" />
              </Grid>

              <TextBlock Text="{Binding Download.SelectedVersionInfo}"
                         Classes="muted"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding Download.GameDirectory}"
                         Classes="faint"
                         TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Button Content="校验 / 修复"
                        Classes="secondary"
                        Command="{Binding Download.VerifyCommand}"
                        IsEnabled="{Binding Download.CanVerify}" />
                <Button Content="取消"
                        Command="{Binding Download.CancelCommand}"
                        IsVisible="{Binding Download.CanCancel}" />
              </StackPanel>
              <ProgressBar Value="{Binding Download.Progress}"
                           Maximum="100"
                           IsVisible="{Binding Download.IsBusy}" />
              <TextBlock Text="{Binding Download.ProgressText}"
                         Classes="faint"
                         IsVisible="{Binding Download.IsBusy}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="0">
          <StackPanel>
            <Button Classes="minecraftHeader"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Tag="Fabric"
                    Click="OnComponentHeaderClick">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="●" Foreground="{DynamicResource WmclBlue2}"
                             IsVisible="{Binding IsFabricSelected}" />
                  <TextBlock Text="Fabric" Classes="cardTitle" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding FabricSummary}"
                           Classes="faint" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="⌄" FontSize="15"
                           Foreground="{DynamicResource WmclTextMuted}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <StackPanel Margin="15,0,15,15" Spacing="8"
                        IsVisible="{Binding IsFabricExpanded, FallbackValue=False}"
                        motion:Motion.AnimateOnVisible="True">
              <TextBlock Text="为当前 Minecraft 版本选择 Fabric Loader" Classes="faint" TextWrapping="Wrap" />
              <ComboBox ItemsSource="{Binding Mods.Loaders}"
                        SelectedItem="{Binding Mods.SelectedLoader}"
                        HorizontalAlignment="Stretch" />
              <TextBlock Text="{Binding Mods.Status}" Classes="faint" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="0">
          <StackPanel>
            <Button Classes="minecraftHeader"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Tag="Forge"
                    Click="OnComponentHeaderClick">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="●" Foreground="{DynamicResource WmclBlue2}"
                             IsVisible="{Binding IsForgeSelected}" />
                  <TextBlock Text="Forge" Classes="cardTitle" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ForgeSummary}"
                           Classes="faint" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="⌄" FontSize="15"
                           Foreground="{DynamicResource WmclTextMuted}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <StackPanel Margin="15,0,15,15" Spacing="8"
                        IsVisible="{Binding IsForgeExpanded, FallbackValue=False}"
                        motion:Motion.AnimateOnVisible="True">
              <TextBlock Text="为当前 Minecraft 版本选择 Forge 版本" Classes="faint" TextWrapping="Wrap" />
              <ComboBox ItemsSource="{Binding Mods.ForgelikeVersions}"
                        SelectedItem="{Binding Mods.SelectedForgelikeVersion}"
                        HorizontalAlignment="Stretch" />
              <TextBlock Text="{Binding Mods.ForgelikeStatus}" Classes="faint" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="0">
          <StackPanel>
            <Button Classes="minecraftHeader"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Tag="NeoForge"
                    Click="OnComponentHeaderClick">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="●" Foreground="{DynamicResource WmclBlue2}"
                             IsVisible="{Binding IsNeoForgeSelected}" />
                  <TextBlock Text="NeoForge" Classes="cardTitle" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding NeoForgeSummary}"
                           Classes="faint" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="⌄" FontSize="15"
                           Foreground="{DynamicResource WmclTextMuted}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <StackPanel Margin="15,0,15,15" Spacing="8"
                        IsVisible="{Binding IsNeoForgeExpanded, FallbackValue=False}"
                        motion:Motion.AnimateOnVisible="True">
              <TextBlock Text="为当前 Minecraft 版本选择 NeoForge 版本" Classes="faint" TextWrapping="Wrap" />
              <ComboBox ItemsSource="{Binding Mods.ForgelikeVersions}"
                        SelectedItem="{Binding Mods.SelectedForgelikeVersion}"
                        HorizontalAlignment="Stretch" />
              <TextBlock Text="{Binding Mods.ForgelikeStatus}" Classes="faint" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="0">
          <StackPanel>
            <Button Classes="minecraftHeader"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Tag="OptiFine"
                    Click="OnComponentHeaderClick">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="●" Foreground="{DynamicResource WmclBlue2}"
                             IsVisible="{Binding IsOptiFineSelected}" />
                  <TextBlock Text="OptiFine" Classes="cardTitle" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding OptiFineSummary}"
                           Classes="faint" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="⌄" FontSize="15"
                           Foreground="{DynamicResource WmclTextMuted}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <StackPanel Margin="15,0,15,15" Spacing="8"
                        IsVisible="{Binding IsOptiFineExpanded, FallbackValue=False}"
                        motion:Motion.AnimateOnVisible="True">
              <TextBlock Text="为当前 Minecraft 版本选择 OptiFine 版本" Classes="faint" TextWrapping="Wrap" />
              <ComboBox ItemsSource="{Binding Mods.OptiFineVersions}"
                        SelectedItem="{Binding Mods.SelectedOptiFineVersion}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Patch}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding Mods.OptiFineStatus}" Classes="faint" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="安装选项" Classes="cardTitle" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="仅安装原版" Classes="secondary" Click="OnUseVanillaClick" />
              <CheckBox Theme="{StaticResource PclCheckBoxTheme}"
                        Content="同时安装 OptiFine"
                        IsChecked="{Binding InstallOptiFineWithBase}"
                        IsVisible="{Binding CanAddOptiFine}"
                        Margin="0,2" />
            </StackPanel>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <TextBlock Text="实例名" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding InstanceName}"
                       Watermark="可选；留空使用加载器默认名称" />
            </Grid>
            <TextBlock Text="{Binding CombinedStatus}" Classes="faint" TextWrapping="Wrap" />
            <ProgressBar Value="{Binding CombinedProgress}" Maximum="100"
                         IsVisible="{Binding IsCombinedBusy}" />
            <TextBlock Text="{Binding CombinedProgressText}" Classes="faint"
                       TextWrapping="Wrap" IsVisible="{Binding IsCombinedBusy}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Button Grid.Row="1"
            Content="开始安装"
            Classes="primary startPill"
            HorizontalAlignment="Center"
            Margin="0,10,0,15"
            Command="{Binding InstallCombinedCommand}"
            IsEnabled="{Binding !IsCombinedBusy}" />
  </Grid>
</UserControl>
