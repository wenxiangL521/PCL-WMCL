<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WMCL.App.Views.InstallView">
  <UserControl.Styles>
    <Style Selector="Button.minecraftHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="15,0" />
      <Setter Property="Height" Value="40" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.startPill">
      <Setter Property="Height" Value="35" />
      <Setter Property="MinWidth" Value="170" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="20,0" />
      <Setter Property="FontSize" Value="14" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">
    <ScrollViewer x:Name="PageScroll"
                  Grid.Row="0"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">
        <Border Classes="card" Padding="0" HorizontalAlignment="Stretch">
          <StackPanel>
            <Button Classes="minecraftHeader"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Click="OnToggleMinecraftClick"
                    ToolTip.Tip="展开/收起版本选择">
              <Grid ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="12"
                    HorizontalAlignment="Stretch">
                <TextBlock Text="Minecraft"
                           Classes="cardTitle"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Download.SelectedVersionTitle}"
                           Classes="faint"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2"
                           Text="⌄"
                           FontSize="15"
                           Foreground="{DynamicResource WmclTextMuted}"
                           VerticalAlignment="Center" />
              </Grid>
            </Button>
            <StackPanel Margin="15,0,15,15" Spacing="9"
                        IsVisible="{Binding IsMinecraftExpanded, FallbackValue=False}">
              <Grid ColumnDefinitions="*,Auto">
                <ComboBox ItemsSource="{Binding Download.Versions}"
                          SelectedItem="{Binding Download.SelectedVersion}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Id}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="已安装"
                                   Classes="faint"
                                   Foreground="{DynamicResource WmclBlue3}"
                                   IsVisible="{Binding IsInstalled}"
                                   Margin="8,0,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1"
                        Content="刷新"
                        Classes="secondary"
                        Command="{Binding Download.RefreshCommand}"
                        Margin="7,0,0,0" />
              </Grid>

              <TextBlock Text="{Binding Download.SelectedVersionInfo}"
                         Classes="muted"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding Download.GameDirectory}"
                         Classes="faint"
                         TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Button Content="校验 / 修复"
                        Classes="secondary"
                        Command="{Binding Download.VerifyCommand}"
                        IsEnabled="{Binding Download.CanVerify}" />
                <Button Content="取消"
                        Command="{Binding Download.CancelCommand}"
                        IsVisible="{Binding Download.CanCancel}" />
              </StackPanel>
              <ProgressBar Value="{Binding Download.Progress}"
                           Maximum="100"
                           IsVisible="{Binding Download.IsBusy}" />
              <TextBlock Text="{Binding Download.ProgressText}"
                         Classes="faint"
                         IsVisible="{Binding Download.IsBusy}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="安装组件" Classes="cardTitle" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
              <TextBlock Text="基础加载器" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding BaseLoaderKinds}"
                        SelectedItem="{Binding SelectedBaseLoader}"
                        HorizontalAlignment="Stretch" />

              <TextBlock Grid.Row="1" Text="加载器版本" VerticalAlignment="Center"
                         IsVisible="{Binding IsFabricBase}" />
              <ComboBox Grid.Row="1" Grid.Column="1"
                        ItemsSource="{Binding Mods.Loaders}"
                        SelectedItem="{Binding Mods.SelectedLoader}"
                        HorizontalAlignment="Stretch"
                        IsVisible="{Binding IsFabricBase}" />

              <TextBlock Grid.Row="1" Text="Forge / NeoForge 版本" VerticalAlignment="Center"
                         IsVisible="{Binding IsForgelikeBase}" />
              <ComboBox Grid.Row="1" Grid.Column="1"
                        ItemsSource="{Binding Mods.ForgelikeVersions}"
                        SelectedItem="{Binding Mods.SelectedForgelikeVersion}"
                        HorizontalAlignment="Stretch"
                        IsVisible="{Binding IsForgelikeBase}" />

              <TextBlock Grid.Row="1" Text="OptiFine 版本" VerticalAlignment="Center"
                         IsVisible="{Binding IsOptiFineBase}" />
              <ComboBox Grid.Row="1" Grid.Column="1"
                        ItemsSource="{Binding Mods.OptiFineVersions}"
                        SelectedItem="{Binding Mods.SelectedOptiFineVersion}"
                        HorizontalAlignment="Stretch"
                        IsVisible="{Binding IsOptiFineBase}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Patch}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <CheckBox Theme="{StaticResource PclCheckBoxTheme}"
                        Grid.Row="2" Grid.Column="1"
                        Content="同时安装 OptiFine"
                        IsChecked="{Binding InstallOptiFineWithBase}"
                        IsVisible="{Binding CanAddOptiFine}"
                        Margin="0,2" />

              <TextBlock Grid.Row="3" Text="实例名" VerticalAlignment="Center" />
              <TextBox Grid.Row="3" Grid.Column="1"
                       Text="{Binding InstanceName}"
                       Watermark="可选；留空使用加载器默认名称" />
            </Grid>

            <TextBlock Text="{Binding CombinedStatus}"
                       Classes="faint"
                       TextWrapping="Wrap" />
            <ProgressBar Value="{Binding CombinedProgress}"
                         Maximum="100"
                         IsVisible="{Binding IsCombinedBusy}" />
            <TextBlock Text="{Binding CombinedProgressText}"
                       Classes="faint"
                       TextWrapping="Wrap"
                       IsVisible="{Binding IsCombinedBusy}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Button Grid.Row="1"
            Content="开始安装"
            Classes="primary startPill"
            HorizontalAlignment="Center"
            Margin="0,10,0,15"
            Command="{Binding InstallCombinedCommand}"
            IsEnabled="{Binding !IsCombinedBusy}" />
  </Grid>
</UserControl>
