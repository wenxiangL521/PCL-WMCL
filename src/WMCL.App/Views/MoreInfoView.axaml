<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WMCL.App.Controls"
             x:Class="WMCL.App.Views.MoreInfoView"
             FontSize="{DynamicResource WmclFontBody}">
  <ScrollViewer Classes="page">
    <Border Classes="card" VerticalAlignment="Top">
      <StackPanel Classes="pageStack">
        <controls:WmclCardHeader Title="{Binding Title}" Subtitle="{Binding Subtitle}" />
        <TextBlock Text="{Binding Body}" TextWrapping="Wrap" LineHeight="21" />
        <Button Content="{Binding ActionText}" Classes="secondary"
                Command="{Binding OpenActionCommand}" IsVisible="{Binding HasAction}"
                HorizontalAlignment="Left" />
        <TextBlock Text="{Binding Status}" Classes="faint" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
