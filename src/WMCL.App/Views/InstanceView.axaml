<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WMCL.App.Controls"
             x:Class="WMCL.App.Views.InstanceView">

  <UserControl.Styles>
    <Style Selector="ListBox#SectionList ListBoxItem">
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="ListBox#SectionList ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource WmclBlue7}" />
      <Setter Property="Foreground" Value="{DynamicResource WmclBlue2}" />
    </Style>
    <Style Selector="ListBox#SectionList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WmclBlue7}" />
      <Setter Property="Foreground" Value="{DynamicResource WmclBlue2}" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="150,*">
    <Border Background="{DynamicResource WmclSidebar}"
            BorderBrush="{DynamicResource WmclBorder}"
            BorderThickness="0,0,1,0">
      <ListBox x:Name="SectionList"
               SelectedIndex="0"
               SelectionChanged="OnSectionChanged"
               Background="Transparent"
               BorderThickness="0"
               Margin="6,12,6,0">
        <ListBoxItem Content="概览" Padding="12,8" />
        <ListBoxItem Content="服务器" Padding="12,8" />
        <ListBoxItem Content="导出与操作" Padding="12,8" />
        <ListBoxItem Content="实例设置" Padding="12,8" />
        <ListBoxItem Content="安装" Padding="12,8" />
        <ListBoxItem Content="Mod" Padding="12,8" />
        <ListBoxItem Content="资源包" Padding="12,8" />
        <ListBoxItem Content="存档" Padding="12,8" />
        <ListBoxItem Content="光影" Padding="12,8" />
      </ListBox>
    </Border>
    <Grid Grid.Column="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
        <Border Classes="card" x:Name="OverviewCard">
          <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBlock Text="实例信息" Classes="cardTitle" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1"
                    ItemsSource="{Binding Instances}"
                    SelectedItem="{Binding SelectedInstance}"
                    Width="220"
                    HorizontalAlignment="Right">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Id}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="2" Content="刷新" Classes="secondary"
                  Command="{Binding RefreshCommand}" Padding="10,3" MinHeight="28" />
        </Grid>
        <TextBlock Text="{Binding SelectedInstanceTitle}"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{DynamicResource WmclBlue2}" />
        <TextBlock Text="{Binding SelectedInstanceInfo}" Classes="muted" />
        <TextBlock Text="{Binding SelectedInstancePath}"
                   Classes="faint"
                   TextWrapping="Wrap" />

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <TextBox Text="{Binding InstanceLogoPath}" Watermark="实例图标路径（可选）" />
          <Button Grid.Column="1" Content="选择图标" Classes="secondary"
                  Click="OnChooseInstanceLogoClick" />
        </Grid>

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <CheckBox Theme="{StaticResource PclCheckBoxTheme}" Content="收藏" IsChecked="{Binding InstanceFavorite}" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Text="{Binding InstanceDescription}"
                   Watermark="实例描述（可选）" />
        </Grid>

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <TextBlock Text="分类" VerticalAlignment="Center" Classes="faint" />
          <StackPanel Grid.Column="1" Spacing="3">
            <ComboBox ItemsSource="{Binding InstanceCategoryOptions}"
                      SelectedItem="{Binding InstanceCategory}"
                      HorizontalAlignment="Stretch" />
            <TextBox Text="{Binding InstanceCategory}"
                     Watermark="或输入自定义分类（留空=未分类）" />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <TextBlock Text="版本隔离" VerticalAlignment="Center" Classes="faint" />
          <ComboBox Grid.Column="1"
                    ItemsSource="{Binding IsolationOptions}"
                    SelectedItem="{Binding InstanceIsolation}"
                    HorizontalAlignment="Stretch" />
        </Grid>

          </StackPanel>
        </Border>

        <Border Classes="card" x:Name="ServerCard">
          <StackPanel Spacing="10">
        <TextBlock Text="服务器" Classes="cardTitle" />
        <Border Background="{DynamicResource WmclBlue8}"
                CornerRadius="5"
                Padding="12"
                Margin="0,4,0,0">
          <StackPanel Spacing="6">
            <Expander Header="服务器列表" HorizontalAlignment="Stretch">
          <StackPanel Spacing="6">
            <ListBox ItemsSource="{Binding Servers}"
                     SelectedItem="{Binding SelectedServer}"
                     Height="120">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                    <Image Source="{Binding IconImage}" Width="28" Height="28"
                           IsVisible="{Binding HasIcon}" Stretch="Uniform" />
                    <StackPanel Grid.Column="1" Spacing="1">
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Address}" Classes="faint" />
                        <TextBlock Text="{Binding PingText}" Classes="faint" FontSize="11" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
              <TextBox Text="{Binding NewServerName}" Watermark="名称" />
              <TextBox Grid.Column="1" Text="{Binding NewServerAddress}" Watermark="地址：端口" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="添加" Classes="primary" Command="{Binding AddServerCommand}" />
              <Button Content="删除" Command="{Binding RemoveServerCommand}" />
              <Button Content="保存" Command="{Binding SaveServersNowCommand}" />
              <Button Content="Ping" Command="{Binding PingServerCommand}"
                      IsEnabled="{Binding !IsServerPinging}" />
              <Button Content="全部 Ping" Command="{Binding PingAllServersCommand}"
                      IsEnabled="{Binding !IsServerPinging}" />
              <Button Content="导入" Click="OnImportServersClick" />
              <Button Content="导出" Click="OnExportServersClick" />
            </StackPanel>
            <TextBlock Text="{Binding ServerStatus}" Classes="faint" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Image Source="{Binding ServerFavicon}" Width="28" Height="28"
                     IsVisible="{Binding HasServerFavicon}" Stretch="Uniform" />
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding ServerPingText}" Classes="faint" TextWrapping="Wrap" />
                <controls:MotdTextBlock Runs="{Binding ServerMotdRuns}"
                                        IsVisible="{Binding HasServerMotdRuns}"
                                        TextWrapping="Wrap" FontSize="12" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Expander>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="准备服务端文件" Classes="secondary"
                  Command="{Binding PrepareServerFilesCommand}" />
          <Button Content="启动服务端" Classes="secondary"
                  Command="{Binding StartServerCommand}" />
          <Button Content="停止服务端" Classes="secondary"
                  Command="{Binding StopServerCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding ServerFilesStatus}" Classes="faint" TextWrapping="Wrap" />
        <TextBox Text="{Binding ServerConsole}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 Height="140"
                 FontFamily="monospace"
                 TextWrapping="NoWrap"
                 Watermark="服务端输出" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Text="{Binding ServerCommand}"
                   Watermark="控制台命令，例如 say hello"
                   IsEnabled="{Binding IsServerRunning}" />
          <Button Grid.Column="1" Content="发送" Margin="8,0,0,0"
                  Command="{Binding SendServerCommandCommand}"
                  IsEnabled="{Binding IsServerRunning}" />
        </Grid>
        <TextBlock Text="server.properties" Classes="faint" />
        <TextBox Text="{Binding ServerPropertiesText}"
                 AcceptsReturn="True"
                 Height="100"
                 FontFamily="monospace"
                 Watermark="准备服务端文件后可编辑" />
        <Button Content="保存 server.properties" Classes="secondary"
                Command="{Binding SaveServerPropertiesCommand}" />

        <TextBlock Text="实例目录" FontWeight="SemiBold" />
            <TextBlock Text="与官方启动器兼容：versions/&lt;id&gt;/ 下保存版本 JSON、客户端 jar 与 natives。"
                       Classes="muted"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
          </StackPanel>
        </Border>

        <Border Classes="card" x:Name="ExportCard">
          <StackPanel Spacing="10">
        <TextBlock Text="导出与操作" Classes="cardTitle" />
        <Button Content="打开版本目录"
                HorizontalAlignment="Stretch"
                Command="{Binding OpenFolderCommand}" />
        <Button Content="打开游戏目录"
                HorizontalAlignment="Stretch"
                Classes="secondary"
                Command="{Binding OpenGameFolderCommand}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Text="{Binding ExportPath}" Watermark="导出路径（留空使用默认 exports 目录）" />
          <Button Grid.Column="1" Content="另存为" Classes="secondary"
                  Click="OnChooseExportPathClick" />
        </Grid>

        <Expander Header="导出选项" HorizontalAlignment="Stretch">
          <StackPanel Spacing="2">
            <CheckBox Theme="{StaticResource PclCheckBoxTheme}" Content="Mod" IsChecked="{Binding ExportMods}" />
            <CheckBox Theme="{StaticResource PclCheckBoxTheme}" Content="配置" IsChecked="{Binding ExportConfigs}" />
            <CheckBox Theme="{StaticResource PclCheckBoxTheme}" Content="资源包" IsChecked="{Binding ExportResourcePacks}" />
            <CheckBox Theme="{StaticResource PclCheckBoxTheme}" Content="光影" IsChecked="{Binding ExportShaderPacks}" />
            <CheckBox Theme="{StaticResource PclCheckBoxTheme}" Content="存档" IsChecked="{Binding ExportSaves}" />
            <CheckBox Theme="{StaticResource PclCheckBoxTheme}" Content="WMCL 配置" IsChecked="{Binding ExportWmcl}" />
            <CheckBox Theme="{StaticResource PclCheckBoxTheme}" Content="options.txt" IsChecked="{Binding ExportOptions}" />
          </StackPanel>
        </Expander>
        <Button Content="导出实例（备份 zip）"
                HorizontalAlignment="Stretch"
                Command="{Binding ExportInstanceCommand}" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="7">
          <Button Content="校验安装清单"
                  HorizontalAlignment="Stretch"
                  Classes="secondary"
                  Command="{Binding VerifyManifestCommand}" />
          <Button Grid.Column="1"
                  Content="修复基础文件"
                  HorizontalAlignment="Stretch"
                  Classes="secondary"
                  Command="{Binding RepairManifestCommand}"
                  IsEnabled="{Binding !IsRepairingManifest}" />
        </Grid>
        <TextBlock Text="{Binding ManifestStatus}" Classes="faint" TextWrapping="Wrap" />
        <Button Content="导出整合包 (.mrpack)"
                HorizontalAlignment="Stretch"
                Classes="secondary"
                Command="{Binding ExportModpackCommand}" />

        <Border Height="1"
                Background="{DynamicResource WmclBorder}"
                Margin="0,4" />

        <TextBlock Text="导入实例" Classes="cardTitle" />
        <TextBox Text="{Binding ImportPath}"
                 Watermark="/path/to/instance-export.zip" />
        <Button Content="导入 zip"
                HorizontalAlignment="Stretch"
                Classes="secondary"
                Command="{Binding ImportInstanceCommand}"
                IsEnabled="{Binding !IsImporting}" />

        <Border Height="1"
                Background="{DynamicResource WmclBorder}"
                Margin="0,4" />

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="克隆"
                  Command="{Binding CloneInstanceCommand}" />
          <Button Content="重命名"
                  Command="{Binding RenameInstanceCommand}" />
          <Button Content="删除实例"
                  Command="{Binding DeleteInstanceCommand}" />
        </StackPanel>

          </StackPanel>
        </Border>

        <Border Classes="card" x:Name="SettingsCard">
          <StackPanel Spacing="10">
        <TextBlock Text="实例设置" Classes="cardTitle" />

        <CheckBox Theme="{StaticResource PclCheckBoxTheme}" Content="内存使用全局设置"
                  IsChecked="{Binding UseGlobalMemory}" />
        <Grid ColumnDefinitions="90,*">
          <TextBlock Text="内存 (MB)" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="1"
                         Value="{Binding InstanceMemoryMb}"
                         Minimum="512"
                         Maximum="32768"
                         Increment="512"
                         IsEnabled="{Binding CanEditMemory}" />
        </Grid>

        <CheckBox Theme="{StaticResource PclCheckBoxTheme}" Content="Java 使用全局设置"
                  IsChecked="{Binding UseGlobalJava}" />
        <TextBox Text="{Binding InstanceJavaPath}"
                 Watermark="Java 路径（留空则自动选择）"
                 IsEnabled="{Binding CanEditJava}" />

        <TextBlock Text="额外 JVM 参数" Classes="faint" />
        <TextBox Text="{Binding InstanceJvmArgs}"
                 Watermark="-Dfoo=bar" />
        <TextBlock Text="额外游戏参数" Classes="faint" />
        <TextBox Text="{Binding InstanceGameArgs}"
                 Watermark="--fullscreen" />

        <CheckBox Theme="{StaticResource PclCheckBoxTheme}" Content="窗口大小使用全局设置"
                  IsChecked="{Binding UseGlobalWindow}" />
        <Grid ColumnDefinitions="90,*,Auto,*">
          <TextBlock Text="窗口宽高" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="1"
                         Value="{Binding InstanceWidth}"
                         Minimum="320"
                         Maximum="7680"
                         Increment="10"
                         IsEnabled="{Binding CanEditWindow}" />
          <TextBlock Grid.Column="2" Text="×" VerticalAlignment="Center" Margin="10,0" />
          <NumericUpDown Grid.Column="3"
                         Value="{Binding InstanceHeight}"
                         Minimum="240"
                         Maximum="4320"
                         Increment="10"
                         IsEnabled="{Binding CanEditWindow}" />
        </Grid>

        <TextBlock Text="自动加入服务器" Classes="faint" />
        <Grid ColumnDefinitions="*,100">
          <TextBox Text="{Binding InstanceServer}"
                   Watermark="服务器地址（留空不自动加入）" />
          <NumericUpDown Grid.Column="1"
                         Value="{Binding InstanceServerPort}"
                         Minimum="1"
                         Maximum="65535"
                         Margin="8,0,0,0" />
        </Grid>

        <TextBlock Text="第三方认证服务器" Classes="faint" />
        <TextBox Text="{Binding InstanceAuthServer}"
                 Watermark="留空使用启动页全局账号；例如 https://littleskin.cn/api/yggdrasil" />
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Text="名称" VerticalAlignment="Center" Margin="0,0,8,0" Classes="faint" />
          <TextBox Grid.Column="1" Text="{Binding InstanceAuthServerName}"
                   Watermark="显示名称（可选）" />
        </Grid>

        <TextBlock Text="插件目录（服务端）" Classes="faint" />
        <TextBox Text="{Binding InstancePluginDirectory}"
                 Watermark="留空使用 &lt;游戏目录&gt;/plugins；可填服务器 plugins 目录" />

        <TextBlock Text="启动前执行命令" Classes="faint" />
        <TextBox Text="{Binding InstancePreLaunchCommand}"
                 Watermark="例如 {java} -version；支持 {java}/{minecraft}/{verpath}/{name}" />
        <CheckBox Theme="{StaticResource PclCheckBoxTheme}" Content="等待命令执行完成后再启动游戏"
                  IsChecked="{Binding InstancePreLaunchWait}" />

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="保存实例设置"
                  Classes="primary"
                  Command="{Binding SaveInstanceSettingsCommand}" />
          <Button Content="重置"
                  Command="{Binding ResetInstanceSettingsCommand}" />
        </StackPanel>

        <TextBlock Text="{Binding Status}"
                   Classes="muted"
                   TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
