<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WMCL.App.Views.CleanroomView">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="12">
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="Cleanroom" Classes="cardTitle" />
          <TextBlock Text="Cleanroom 是 Minecraft 1.12.2 的 Forgelike 分支。这里只提供官方 GitHub Releases 的安装器下载；安装与实例创建需使用安装器完成。"
                     Classes="muted" TextWrapping="Wrap" />
          <Button Content="打开 Cleanroom 官网" Classes="secondary"
                  HorizontalAlignment="Left" Click="OnWebsiteClick" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="Minecraft 1.12.2" Classes="cardTitle" />
          <ItemsControl ItemsSource="{Binding Versions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" Margin="0,3"
                      MinHeight="42">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Medium" />
                    <TextBlock Text="{Binding Detail}" FontSize="11.5" Classes="faint" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7"
                              VerticalAlignment="Center">
                    <Button Content="安装" Classes="primary"
                            Click="OnInstallClick"
                            IsEnabled="{Binding $parent[ItemsControl].DataContext.CanInstall}" />
                    <Button Content="下载安装器" Classes="secondary"
                            Click="OnDownloadClick" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ProgressBar Value="{Binding Progress}" Maximum="100"
                       IsVisible="{Binding IsDownloading}" />
          <TextBlock Text="{Binding DownloadStatus}" Classes="faint" TextWrapping="Wrap"
                     IsVisible="{Binding DownloadStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <StackPanel Orientation="Horizontal" Spacing="8"
                      IsVisible="{Binding IsInstalling}">
            <Button Content="取消安装" Command="{Binding CancelInstallCommand}" Classes="secondary" />
            <TextBlock Text="{Binding InstallStatus}" Classes="faint" TextWrapping="Wrap"
                       VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding InstallStatus}" Classes="muted" TextWrapping="Wrap"
                     IsVisible="{Binding !IsInstalling}" />
          <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
