<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WMCL.App.ViewModels"
        x:Class="WMCL.App.Views.WelcomeWindow"
        Title="欢迎使用 PCL WMCL"
        Width="520" Height="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WmclPage}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://WMCL.UI/Styles/WmclColors.axaml" />
        <ResourceInclude Source="avares://WMCL.UI/Styles/WmclDimensions.axaml" />
        <ResourceInclude Source="avares://WMCL.UI/Styles/WmclIcons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Window.Styles>
    <StyleInclude Source="avares://WMCL.UI/Styles/WmclTheme.axaml" />
  </Window.Styles>
  <Grid RowDefinitions="*,Auto" Margin="24,16,24,16">
    <StackPanel Margin="0,8,0,0">
      <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold"
                 Foreground="{DynamicResource WmclBlue2}"/>
      <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{DynamicResource WmclTextMuted}"
                 Margin="0,4,0,16" TextWrapping="Wrap"/>
      <Border Background="{DynamicResource WmclCard}" CornerRadius="{DynamicResource WmclCornerWindow}" Padding="16">
        <StackPanel>
          <TextBlock Text="{Binding StepTitle}" FontSize="{DynamicResource WmclFontTitle}" FontWeight="SemiBold"
                     Foreground="{DynamicResource WmclText}"/>
          <TextBlock Text="{Binding StepDescription}" FontSize="13" Foreground="{DynamicResource WmclTextMuted}"
                     Margin="0,6,0,12" TextWrapping="Wrap"/>
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
            <Border Background="{DynamicResource WmclBlue6}" CornerRadius="{DynamicResource WmclCornerButton}" Padding="12,4"/>
            <Border Background="{DynamicResource WmclBlue3}" CornerRadius="{DynamicResource WmclCornerButton}" Padding="12,4"/>
            <Border Background="{DynamicResource WmclBlue1}" CornerRadius="{DynamicResource WmclCornerButton}" Padding="12,4"/>
          </Grid>
          <TextBlock Text="{Binding StepProgress}" FontSize="12"
                     Foreground="{DynamicResource WmclTextMuted}" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,8,0,0">
      <Button Grid.Column="0" Content="{Binding BackText}" Command="{Binding BackCommand}"
              Classes="secondary" IsEnabled="{Binding CanGoBack}"/>
      <Button Grid.Column="2" Content="{Binding NextText}" Command="{Binding NextCommand}"
              Classes="primary"/>
      <Button Grid.Column="3" Content="{Binding SkipText}" Command="{Binding SkipCommand}"
              Classes="secondary" Margin="8,0,0,0"/>
    </Grid>
  </Grid>
</Window>
