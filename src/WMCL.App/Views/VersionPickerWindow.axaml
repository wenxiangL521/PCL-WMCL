<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WMCL.App.Views.VersionPickerWindow"
        Title="选择 Minecraft 版本"
        Width="560" Height="560"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        KeyDown="OnKeyDown"
        Background="{DynamicResource WmclPage}">
  <Border Classes="card" Margin="12" Padding="16">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
      <TextBlock Text="选择 Minecraft 版本"
                 FontSize="18"
                 FontWeight="Bold"
                 Foreground="{DynamicResource WmclBlue2}" />
      <StackPanel Grid.Row="1" Spacing="4">
        <TextBox x:Name="SearchBox"
                 Watermark="搜索版本号，例如 1.21 / 26.3 / snapshot"
                 TextChanged="OnSearchChanged" />
        <TextBlock x:Name="ResultText"
                   Classes="faint"
                   Text="加载官方版本…" />
      </StackPanel>
      <TreeView Grid.Row="2"
                x:Name="VersionTree"
                Background="Transparent"
                SelectionChanged="OnSelectionChanged"
                DoubleTapped="OnDoubleTapped">
        <TreeView.Styles>
          <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
          </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
          <TreeDataTemplate ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="2,1">
              <StackPanel IsVisible="{Binding IsVersion}" Spacing="1">
                <TextBlock Text="{Binding Version.Id}" FontSize="14" FontWeight="Medium" />
                <TextBlock Text="{Binding Version.Subtitle}" FontSize="11" Classes="faint" />
              </StackPanel>
              <TextBlock Text="{Binding Title}"
                         IsVisible="{Binding IsGroup}"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource WmclBlue2}"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="{Binding Status}"
                         Classes="faint"
                         Foreground="{DynamicResource WmclBlue3}"
                         VerticalAlignment="Center" />
            </Grid>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
      <StackPanel Grid.Row="3"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8">
        <Button Content="取消" Click="OnCancel" />
        <Button Content="选择" Classes="primary" Click="OnConfirm" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
