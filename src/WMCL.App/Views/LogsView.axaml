<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WMCL.App.Controls"
             x:Class="WMCL.App.Views.LogsView"
             FontSize="{DynamicResource WmclFontBody}">
  <ScrollViewer Classes="page">
    <StackPanel Classes="pageStack">
      <Border Classes="card">
        <StackPanel Classes="cardBody">
          <controls:WmclCardHeader Title="日志" Subtitle="{Binding LogsDirectory}">
            <controls:WmclCardHeader.Action>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="导出诊断包" Classes="primary" Command="{Binding ExportBundleCommand}" />
                <Button Content="刷新" Command="{Binding RefreshCommand}" />
                <Button Content="打开目录" Classes="secondary" Command="{Binding OpenFolderCommand}" />
              </StackPanel>
            </controls:WmclCardHeader.Action>
          </controls:WmclCardHeader>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ListBox ItemsSource="{Binding Logs}" SelectedItem="{Binding SelectedLog}" MinHeight="260">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="2,1">
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding DateText}" Classes="faint" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" Classes="faint" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="1" Spacing="6" Width="140">
              <Button Content="打开日志" Classes="primary" Command="{Binding OpenSelectedCommand}" />
              <Button Content="删除日志" Command="{Binding DeleteSelectedCommand}" />
              <Button Content="清理历史" Command="{Binding ClearOldCommand}" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
