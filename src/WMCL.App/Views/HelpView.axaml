<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WMCL.App.Controls"
             x:Class="WMCL.App.Views.HelpView"
             FontSize="{DynamicResource WmclFontBody}">
  <Grid ColumnDefinitions="220,*">
    <Border Classes="card" Margin="0,0,12,0" Padding="12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="7">
          <controls:WmclCardHeader Title="帮助" />
          <controls:MySearchBox Text="{Binding SearchText}" Watermark="搜索帮助" />
          <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" HorizontalAlignment="Stretch" />
          <TextBlock Text="{Binding Status}" Classes="faint" />
        </StackPanel>
        <ListBox ItemsSource="{Binding FilteredTopics}" SelectedItem="{Binding SelectedTopic}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Summary}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <Border Grid.Column="1" Classes="card">
      <ScrollViewer Classes="page">
        <StackPanel Classes="cardBody" IsVisible="{Binding HasSelectedTopic}">
          <TextBlock Text="{Binding SelectedTopic.Title}" Classes="resourceTitle" />
          <TextBlock Text="{Binding SelectedTopic.Summary}" Classes="muted" TextWrapping="Wrap" />
          <Border Height="1" Background="{DynamicResource WmclBorder}" />
          <TextBlock Text="{Binding SelectedTopic.Body}" TextWrapping="Wrap" LineHeight="22" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
