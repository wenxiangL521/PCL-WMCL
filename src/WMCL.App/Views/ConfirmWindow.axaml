<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WMCL.App.Views.ConfirmWindow"
        Width="520"
        MinHeight="210"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WmclPage}">

  <Window.Styles>
    <Style Selector="TextBlock.warning">
      <Setter Property="Foreground" Value="{DynamicResource WmclDanger}" />
    </Style>
  </Window.Styles>

  <Border Classes="card" Margin="20">
    <DockPanel LastChildFill="True">
      <StackPanel DockPanel.Dock="Bottom"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8"
                  Margin="0,18,0,0">
        <Button x:Name="CancelButton" Content="取消" Classes="secondary" Click="OnCancel" />
        <Button x:Name="ConfirmButton" Content="确定删除" Classes="primary" Click="OnConfirm" />
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock x:Name="TitleText"
                   FontSize="{DynamicResource WmclFontDialogTitle}"
                   FontWeight="Bold" />
        <ScrollViewer MaxHeight="260"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <TextBlock x:Name="MessageText"
                     FontSize="{DynamicResource WmclFontBody}"
                     Foreground="{DynamicResource WmclTextMuted}"
                     LineHeight="20"
                     TextWrapping="Wrap" />
        </ScrollViewer>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
