<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WMCL.App.Views.ConfirmWindow"
        Width="480"
        Height="230"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WmclPage}">

  <Border Classes="card" Margin="20">
    <DockPanel LastChildFill="True">
      <StackPanel DockPanel.Dock="Bottom"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8"
                  Margin="0,18,0,0">
        <Button x:Name="CancelButton" Content="取消" Click="OnCancel" />
        <Button x:Name="ConfirmButton" Content="确定删除" Classes="primary" Click="OnConfirm" />
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock x:Name="TitleText" Classes="h2" />
        <TextBlock x:Name="MessageText"
                   Classes="muted"
                   TextWrapping="Wrap" />
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
