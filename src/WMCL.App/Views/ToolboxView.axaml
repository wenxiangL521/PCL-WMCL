<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WMCL.App.Views.ToolboxView">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="12">
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="百宝箱" Classes="cardTitle" />
          <TextBlock Text="常用目录与诊断工具" Classes="muted" />

          <Grid ColumnDefinitions="140,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
            <TextBlock Text="日志目录" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding LogsDirectory}" IsReadOnly="True" />
            <Button Grid.Column="2" Content="打开" Classes="secondary" Command="{Binding OpenLogsCommand}" />

            <TextBlock Grid.Row="1" Text="游戏目录" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GameDirectory}" IsReadOnly="True" />
            <Button Grid.Row="1" Grid.Column="2" Content="打开" Classes="secondary" Command="{Binding OpenGameCommand}" />

            <TextBlock Grid.Row="2" Text="配置目录" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ConfigDirectory}" IsReadOnly="True" />
            <Button Grid.Row="2" Grid.Column="2" Content="打开" Classes="secondary" Command="{Binding OpenConfigCommand}" />
          </Grid>

          <TextBlock Text="{Binding Status}" Classes="faint" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="自定义下载" Classes="cardTitle" />
          <TextBlock Text="从任意 http/https 地址下载文件，适合临时下载服务端、资源包等。"
                     Classes="muted" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="7">
            <TextBlock Text="URL" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding CustomDownloadUrl}"
                     Watermark="https://example.com/file.zip" />
            <TextBlock Grid.Row="1" Text="文件名" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CustomDownloadFileName}"
                     Watermark="留空使用 URL 文件名" />
            <TextBlock Grid.Row="2" Text="保存目录" VerticalAlignment="Center" />
            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox Text="{Binding CustomDownloadFolder}" />
              <Button Grid.Column="1" Content="选择" Classes="secondary" Click="OnChooseDownloadFolderClick" />
            </Grid>
            <TextBlock Grid.Row="3" Text="进度" VerticalAlignment="Center" />
            <StackPanel Grid.Row="3" Grid.Column="1" Spacing="3">
              <ProgressBar Value="{Binding CustomDownloadProgress}" Maximum="100"
                           IsVisible="{Binding IsCustomDownloading}" />
              <TextBlock Text="{Binding CustomDownloadStatus}" Classes="faint" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="开始下载" Classes="primary"
                    Command="{Binding StartCustomDownloadCommand}"
                    IsEnabled="{Binding CanStartCustomDownload}" />
            <Button Content="取消" Command="{Binding CancelCustomDownloadCommand}"
                    IsVisible="{Binding IsCustomDownloading}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" VerticalAlignment="Top">
        <StackPanel Spacing="6">
          <TextBlock Text="说明" Classes="cardTitle" />
          <TextBlock Text="PCL2 的百宝箱包含大量内置工具；当前版本先提供目录入口、日志和自定义下载，后续继续补充。"
                     Classes="muted"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
