<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:WMCL.App.Controls"
        x:Class="WMCL.App.Views.OfflineSkinWindow"
        Title="离线皮肤"
        Width="700" Height="560"
        WindowStartupLocation="CenterOwner"
        FontSize="{DynamicResource WmclFontBody}">
  <Grid RowDefinitions="Auto,*" Margin="18" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="3">
        <TextBlock Text="离线皮肤" Classes="resourceTitle" />
        <TextBlock Text="仅本地保存；装了 CustomSkinLoader 的实例会在启动时自动同步。" Classes="faint" TextWrapping="Wrap" />
      </StackPanel>
      <Button Content="关闭" Classes="skinAction" Grid.Column="1" Click="OnClose" />
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="220,*" ColumnSpacing="16">
      <Grid RowDefinitions="*,Auto,Auto,Auto" RowSpacing="8">
        <Border Background="{DynamicResource WmclLogBackground}" CornerRadius="{DynamicResource WmclCornerCard}"
                BorderBrush="{DynamicResource WmclBlue6}" BorderThickness="1" MinHeight="180">
          <controls:SkinModelPreview x:Name="CharacterPreview" Focusable="True" />
        </Border>
        <TextBlock Grid.Row="1" x:Name="PlayerNameText" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <UniformGrid Grid.Row="2" Columns="3">
          <Button Content="正面" Classes="skinAction" Click="OnFront" Margin="0,0,4,0" />
          <Button Content="背面" Classes="skinAction" Click="OnBack" Margin="0,0,4,0" />
          <Button Content="重置" Classes="skinAction" Click="OnResetView" />
        </UniformGrid>
        <StackPanel Grid.Row="3" Spacing="4">
          <TextBlock Text="左拖旋转 · 滚轮缩放 · 右拖平移" Classes="faint" TextWrapping="Wrap" TextAlignment="Center" />
          <TextBlock x:Name="PreviewStatusText" Classes="faint" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
      </Grid>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12">
          <Border Classes="panel" Padding="12">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="皮肤" Classes="cardTitle" VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="EditButton" Content="编辑皮肤" Classes="skinAction" Click="OnEditSkin" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <TextBlock Text="皮肤模型" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" x:Name="ModelBox" HorizontalAlignment="Stretch">
                  <ComboBoxItem Content="auto" />
                  <ComboBoxItem Content="classic" />
                  <ComboBoxItem Content="slim" />
                </ComboBox>
              </Grid>
              <TextBlock x:Name="SkinModelHintText" Classes="faint" TextWrapping="Wrap" />
              <WrapPanel ItemSpacing="7" LineSpacing="7">
                <Button Content="修改皮肤" Classes="skinAction" Click="OnPickSkin" />
                <Button Content="刷新皮肤" Classes="skinAction" Click="OnRefresh" />
                <Button Content="保存皮肤" Classes="skinAction" Click="OnSaveSkin" />
                <Button Content="移除皮肤" Classes="skinAction" Click="OnRemove" />
              </WrapPanel>
              <TextBlock x:Name="StatusText" Classes="faint" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
