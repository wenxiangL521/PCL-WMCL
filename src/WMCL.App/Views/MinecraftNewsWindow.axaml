<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:WMCL.App.Controls"
        x:Class="WMCL.App.Views.MinecraftNewsWindow"
        Title="Minecraft 新闻"
        Width="900" Height="650"
        MinWidth="420" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WmclPage}">
  <Border Classes="card" Margin="12" Padding="14">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <StackPanel Spacing="2">
          <TextBlock Text="Minecraft 新闻" Classes="resourceTitle" />
          <TextBlock Text="来自 Minecraft 官方新闻源" Classes="faint" />
        </StackPanel>
        <Button Grid.Column="1" Content="刷新" Click="OnRefresh" VerticalAlignment="Center" />
        <Button Grid.Column="2" Content="关闭" Click="OnClose" VerticalAlignment="Center" />
      </Grid>

      <Grid Grid.Row="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="NewsItemsControl" HorizontalAlignment="Stretch">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <controls:ResponsiveNewsPanel MinItemWidth="260" ColumnSpacing="10" RowSpacing="10" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="panel newsCard" Padding="10" HorizontalAlignment="Stretch"
                        Cursor="Hand" ToolTip.Tip="{Binding Title}"
                        PointerReleased="OnCardClick">
                  <StackPanel Spacing="6">
                    <Viewbox Classes="newsImageFrame" Stretch="Uniform" HorizontalAlignment="Stretch"
                             IsVisible="{Binding HasImage}">
                      <Border Width="160" Height="90" CornerRadius="{DynamicResource WmclCornerCard}" ClipToBounds="True"
                              Background="{DynamicResource WmclCard}">
                        <controls:RemoteImage Url="{Binding Image}" Stretch="UniformToFill" />
                      </Border>
                    </Viewbox>
                    <TextBlock Classes="newsTitle" Text="{Binding Title}" FontWeight="SemiBold" FontSize="{DynamicResource WmclFontTitle}"
                               TextWrapping="Wrap" ToolTip.Tip="{Binding Title}" />
                    <TextBlock Text="{Binding Author}" Classes="faint" />
                    <TextBlock Text="{Binding PublishDateText}" Classes="faint" />
                    <TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap"
                               MaxHeight="48" TextTrimming="CharacterEllipsis" />
                    <Button Content="阅读更多" Classes="secondary" HorizontalAlignment="Left"
                            Click="OnReadMore" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <controls:WmclEmptyState x:Name="EmptyState" Title="没有可显示的新闻"
                                   Description="请检查网络后刷新。"
                                   IsVisible="False" />
      </Grid>

      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock x:Name="StatusText" Classes="faint" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button x:Name="LoadMoreButton" Grid.Column="1" Content="加载更多" Classes="secondary"
                Click="OnLoadMore" IsVisible="False" />
      </Grid>
    </Grid>
  </Border>
</Window>
