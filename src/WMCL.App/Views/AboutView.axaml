<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WMCL.App.Views.AboutView">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="12" MaxWidth="760" HorizontalAlignment="Center">
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="原版 PCL 作者：龙腾猫跃（LTCat）"
                     FontWeight="SemiBold" />
          <TextBlock Text="PCL (WMCL) 是第三方独立重写版本，由 wenxiangL 维护，与 PCL 官方无隶属关系。"
                     Classes="muted" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="赞助原作者" Classes="secondary"
                    Command="{Binding OpenSponsorCommand}" />
            <Button Content="购买 Minecraft 正版" Classes="secondary"
                    Command="{Binding OpenPurchaseCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="PCL (WMCL)"
                       FontSize="30"
                       FontWeight="Bold"
                       FontStyle="Italic"
                       Foreground="{DynamicResource WmclBlue3}" />
            <TextBlock Text="wenxiangL Minecraft Launcher"
                       FontSize="12"
                       Foreground="{DynamicResource WmclTextMuted}"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,5" />
          </StackPanel>
          <TextBlock Text="{Binding Version}" Classes="muted" />
          <TextBlock Text="{Binding Runtime}" Classes="faint" />
          <Border Height="1" Background="{DynamicResource WmclBorder}" Margin="0,2" />
          <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Attribution}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="更新" Classes="cardTitle" />
          <WrapPanel Orientation="Horizontal">
            <Button Content="检查更新" Classes="secondary"
                    Command="{Binding CheckUpdateCommand}" Margin="0,0,7,7" />
            <Button Content="下载更新包"
                    Command="{Binding DownloadUpdateCommand}"
                    IsEnabled="{Binding CanDownloadUpdate}" Margin="0,0,7,7" />
            <Button Content="安装更新并重启" Classes="primary"
                    Command="{Binding InstallUpdateCommand}"
                    IsEnabled="{Binding CanInstallUpdate}" Margin="0,0,7,7" />
          </WrapPanel>
          <ProgressBar Value="{Binding UpdateProgress}" Maximum="100"
                       IsVisible="{Binding IsUpdating}" />
          <TextBlock Text="{Binding UpdateProgressText}" Classes="faint"
                     IsVisible="{Binding IsUpdating}" />
          <TextBlock Text="{Binding UpdateStatus}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="环境与许可" Classes="cardTitle" />
          <TextBlock Text="{Binding Status}" Classes="faint" />
          <WrapPanel Orientation="Horizontal">
            <Button Content="打开原版仓库" Classes="secondary"
                    Command="{Binding OpenProjectCommand}" Margin="0,0,7,7" />
            <Button Content="打开日志目录" Classes="secondary"
                    Command="{Binding OpenLogsCommand}" Margin="0,0,7,7" />
          </WrapPanel>
          <Border Height="1" Background="{DynamicResource WmclBorder}" />
          <TextBlock Text="原版 PCL2 使用《PCL 分发有限许可》（非 OSI 开源许可）。PCL (WMCL) 按该许可标注原作者、保留许可并公开源代码；Minecraft 是付费游戏，请支持正版。"
                     Classes="muted"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
