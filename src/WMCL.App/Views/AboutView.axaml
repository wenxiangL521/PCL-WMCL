<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WMCL.App.Controls"
             x:Class="WMCL.App.Views.AboutView"
             FontSize="{DynamicResource WmclFontBody}">

  <UserControl.Styles>
    <Style Selector="Grid.aboutRow">
      <Setter Property="MinHeight" Value="44" />
    </Style>
    <!-- 关于页右侧动作按钮统一尺寸，文字居中，避免一个个按内容宽度变化。 -->
    <Style Selector="Grid.aboutRow > Button">
      <Setter Property="Width" Value="132" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer Classes="page">
    <StackPanel Classes="pageStack">

      <!-- 关于：作者、原版项目、正版购买，行式布局对齐 PCL 关于页。 -->
      <Border Classes="card">
        <StackPanel Classes="cardBody" Spacing="10">
          <controls:WmclCardHeader Title="关于" Subtitle="Plain Craft Launcher (PCL) WMCL · 第三方独立重写" />
          <Grid Classes="aboutRow" ColumnDefinitions="44,*,Auto">
            <Border Width="34" Height="34" ClipToBounds="True">
              <Border.Clip><EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17" /></Border.Clip>
              <Image Width="40" Height="40" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="avares://WMCL.App/Assets/About/ltcat.jpg" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="龙腾猫跃（LTCat）" FontWeight="SemiBold" />
              <TextBlock Text="Plain Craft Launcher 原作者" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="2" Content="赞助原作者" Classes="primary" Command="{Binding OpenSponsorCommand}" VerticalAlignment="Center" />
          </Grid>
          <Grid Classes="aboutRow" ColumnDefinitions="44,*,Auto">
            <Border Width="34" Height="34" ClipToBounds="True">
              <Border.Clip><EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17" /></Border.Clip>
              <Image Width="40" Height="40" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="avares://WMCL.App/Assets/About/grass.png" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="Minecraft" FontWeight="SemiBold" />
              <TextBlock Text="Minecraft 是付费游戏，请支持正版" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="2" Content="购买正版" Command="{Binding OpenPurchaseCommand}" VerticalAlignment="Center" />
          </Grid>
          <Grid Classes="aboutRow" ColumnDefinitions="44,*,Auto">
            <Border Width="34" Height="34" ClipToBounds="True">
              <Border.Clip><EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17" /></Border.Clip>
              <Image Width="40" Height="40" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="avares://WMCL.App/Assets/About/wmcl.png" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="Plain Craft Launcher (PCL) WMCL" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Version}" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Runtime}" Classes="faint" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="2" Content="检查更新" Command="{Binding CheckUpdateCommand}" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Text="{Binding Description}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- 特别鸣谢：实际使用的开源项目与服务。 -->
      <Border Classes="card">
        <StackPanel Classes="cardBody" Spacing="10">
          <controls:WmclCardHeader Title="特别鸣谢" Subtitle="以下项目与服务让 WMCL 成为可能" />
          <Grid Classes="aboutRow" ColumnDefinitions="44,*,Auto">
            <Border Width="34" Height="34" ClipToBounds="True">
              <Border.Clip><EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17" /></Border.Clip>
              <Image Width="40" Height="40" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="avares://WMCL.App/Assets/About/bmclapi.png" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="BMCLAPI" FontWeight="SemiBold" />
              <TextBlock Text="提供 Minecraft 下载镜像源" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="2" Content="打开主页" Command="{Binding OpenBmclApiCommand}" VerticalAlignment="Center" />
          </Grid>
          <Grid Classes="aboutRow" ColumnDefinitions="44,*,Auto">
            <Border Width="34" Height="34" ClipToBounds="True">
              <Border.Clip><EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17" /></Border.Clip>
              <Image Width="40" Height="40" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="avares://WMCL.App/Assets/About/pcl2.png" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="Plain Craft Launcher 2" FontWeight="SemiBold" />
              <TextBlock Text="本项目的交互与视觉规格来源" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="2" Content="打开原版仓库" Command="{Binding OpenProjectCommand}" VerticalAlignment="Center" />
          </Grid>
          <Grid Classes="aboutRow" ColumnDefinitions="44,*,Auto">
            <Border Width="34" Height="34" ClipToBounds="True">
              <Border.Clip><EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17" /></Border.Clip>
              <Image Width="40" Height="40" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="avares://WMCL.App/Assets/About/deepseek.png" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="DeepSeek" FontWeight="SemiBold" />
              <TextBlock Text="在开发与代码整理中提供 AI 辅助" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="2" Content="打开官网" Command="{Binding OpenDeepSeekCommand}" VerticalAlignment="Center" />
          </Grid>
          <Grid Classes="aboutRow" ColumnDefinitions="44,*,Auto">
            <Border Width="34" Height="34" ClipToBounds="True">
              <Border.Clip><EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17" /></Border.Clip>
              <Image Width="40" Height="40" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="avares://WMCL.App/Assets/About/pclce.png" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="PCL-CE" FontWeight="SemiBold" />
              <TextBlock Text="本项目部分交互与视觉来源" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="2" Content="打开仓库" Command="{Binding OpenPclCeCommand}" VerticalAlignment="Center" />
          </Grid>
          <Grid Classes="aboutRow" ColumnDefinitions="44,*,Auto">
            <Border Width="34" Height="34" ClipToBounds="True">
              <Border.Clip><EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17" /></Border.Clip>
              <Image Width="40" Height="40" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="avares://WMCL.App/Assets/About/pclme.png" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="PCL-ME" FontWeight="SemiBold" />
              <TextBlock Text="本项目部分交互与视觉来源" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="2" Content="打开仓库" Command="{Binding OpenPclMeCommand}" VerticalAlignment="Center" />
          </Grid>
          <Grid Classes="aboutRow" ColumnDefinitions="44,*,Auto">
            <Border Width="34" Height="34" ClipToBounds="True">
              <Border.Clip><EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17" /></Border.Clip>
              <Image Width="40" Height="40" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="avares://WMCL.App/Assets/About/easytier.png" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="EasyTier" FontWeight="SemiBold" />
              <TextBlock Text="提供联机虚拟网络核心" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="2" Content="GitHub 页面" Command="{Binding OpenEasyTierCommand}" VerticalAlignment="Center" />
          </Grid>
          <Grid Classes="aboutRow" ColumnDefinitions="44,*,Auto">
            <Border Width="34" Height="34" ClipToBounds="True">
              <Border.Clip><EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17" /></Border.Clip>
              <Image Width="40" Height="40" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="avares://WMCL.App/Assets/About/astral.png" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="Astral" FontWeight="SemiBold" />
              <TextBlock Text="提供 Astral 联机房间与中转节点" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="2" Content="打开官网" Command="{Binding OpenAstralCommand}" VerticalAlignment="Center" />
          </Grid>
          <Grid Classes="aboutRow" ColumnDefinitions="44,*,Auto">
            <Border Width="34" Height="34" ClipToBounds="True">
              <Border.Clip><EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17" /></Border.Clip>
              <Image Width="40" Height="40" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="avares://WMCL.App/Assets/About/terracotta.png" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="Terracotta（陶瓦联机）" FontWeight="SemiBold" />
              <TextBlock Text="联机进程封装；按其 AGPL-3.0 许可调用未修改的二进制" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="2" Content="GitHub 页面" Command="{Binding OpenTerracottaCommand}" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Text="{Binding Attribution}" Classes="faint" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- 更新 -->
      <Border Classes="card">
        <StackPanel Classes="cardBody">
          <controls:WmclCardHeader Title="更新" Subtitle="检查、下载并安装新版本" />
          <WrapPanel Orientation="Horizontal">
            <Button Content="检查更新" Classes="secondary" Command="{Binding CheckUpdateCommand}" Margin="0,0,7,7" />
            <Button Content="下载更新包" Command="{Binding DownloadUpdateCommand}" IsEnabled="{Binding CanDownloadUpdate}" Margin="0,0,7,7" />
            <Button Content="安装更新并重启" Classes="primary" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding CanInstallUpdate}" Margin="0,0,7,7" />
            <Button Content="取消" Command="{Binding CancelUpdateCommand}" IsVisible="{Binding CanCancelUpdate}" Margin="0,0,7,7" />
          </WrapPanel>
          <ProgressBar Value="{Binding UpdateProgress}" Maximum="100" IsVisible="{Binding IsUpdating}" />
          <TextBlock Text="{Binding UpdateProgressText}" Classes="faint" IsVisible="{Binding IsUpdating}" />
          <TextBlock Text="{Binding UpdateStatus}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- 环境与许可 -->
      <Border Classes="card">
        <StackPanel Classes="cardBody">
          <controls:WmclCardHeader Title="环境与许可" />
          <TextBlock Text="{Binding Status}" Classes="faint" TextWrapping="Wrap" />
          <WrapPanel Orientation="Horizontal">
            <Button Content="打开日志目录" Classes="secondary" Command="{Binding OpenLogsCommand}" Margin="0,0,7,7" />
          </WrapPanel>
          <Border Height="1" Background="{DynamicResource WmclBorder}" />
          <TextBlock Text="原版 PCL2 使用《PCL 分发有限许可》（非 OSI 开源许可）。Plain Craft Launcher (PCL) WMCL 按该许可标注原作者、保留许可并公开源代码；Minecraft 是付费游戏，请支持正版。"
                     Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
