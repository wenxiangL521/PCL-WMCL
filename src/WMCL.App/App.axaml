<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WMCL.App.ViewModels"
             xmlns:views="using:WMCL.App.Views"
             xmlns:controls="using:WMCL.App.Controls"
             x:Class="WMCL.App.App"
             RequestedThemeVariant="Light">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://WMCL.UI/Styles/WmclColors.axaml" />
        <ResourceInclude Source="avares://WMCL.UI/Styles/WmclDimensions.axaml" />
        <ResourceInclude Source="avares://WMCL.UI/Styles/WmclIcons.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <ControlTheme x:Key="PclCheckBoxTheme" TargetType="CheckBox">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="FontSize" Value="{DynamicResource WmclFontBody}" />
        <Setter Property="Foreground" Value="{DynamicResource WmclText}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate>
              <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                <Border x:Name="CheckBoxBorder"
                        Width="18" Height="18"
                        CornerRadius="{DynamicResource WmclCornerButton}"
                        BorderThickness="1.1"
                        BorderBrush="{DynamicResource WmclText}"
                        Background="{DynamicResource WmclOverlayButtonBase}"
                        VerticalAlignment="Center"
                        RenderTransformOrigin="50%,50%">
                  <Border.Transitions>
                    <Transitions>
                      <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
                    </Transitions>
                  </Border.Transitions>
                  <Path x:Name="CheckBoxCheck"
                        Data="M0,6L1.5,4.5 4.5,7.5 10.5,1.5 12,3 4.5,10.5 0,6z"
                        Width="12" Height="12"
                        Stretch="Uniform"
                        Fill="{DynamicResource WmclBlue2}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0"
                        RenderTransformOrigin="50%,50%">
                    <Path.Transitions>
                      <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                        <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
                      </Transitions>
                    </Path.Transitions>
                  </Path>
                </Border>
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Grid.Column="1"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style Selector="^:checked /template/ Border#CheckBoxBorder">
          <Setter Property="BorderBrush" Value="{DynamicResource WmclBlue2}" />
        </Style>
        <Style Selector="^ /template/ Path#CheckBoxCheck">
          <Setter Property="RenderTransform" Value="scale(0.4)" />
        </Style>
        <Style Selector="^:checked /template/ Path#CheckBoxCheck">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="^:pressed /template/ Border#CheckBoxBorder">
          <Setter Property="RenderTransform" Value="scale(0.86)" />
        </Style>
        <Style Selector="^:checked:pressed /template/ Border#CheckBoxBorder">
          <Setter Property="BorderBrush" Value="{DynamicResource WmclBlue1}" />
        </Style>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type controls:MySearchBox}" TargetType="controls:MySearchBox">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate>
              <Border Background="{DynamicResource WmclOverlayButtonBase}"
                      BorderBrush="{DynamicResource WmclBlue5}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource WmclCornerButton}"
                      Padding="8,3">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                  <Path Data="{StaticResource WmclIconSearch}"
                        Width="16" Height="16" Stretch="Uniform"
                        Stroke="{DynamicResource WmclTextMuted}" StrokeThickness="1.7"
                        StrokeLineCap="Round" StrokeJoin="Round"
                        VerticalAlignment="Center" />
                  <TextBox x:Name="PART_TextBox" Grid.Column="1"
                           Background="Transparent" BorderThickness="0"
                           FontSize="{DynamicResource WmclFontInput}"
                           MinWidth="40"
                           Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                           Watermark="{TemplateBinding Watermark}" />
                  <Button x:Name="PART_ClearButton" Grid.Column="2"
                          Classes="iconButton size16"
                          IsVisible="{TemplateBinding IsClearButtonVisible}"
                          VerticalAlignment="Center">
                    <Path Data="{StaticResource WmclIconClose}" Width="12" Height="12" Stretch="Uniform" />
                  </Button>
                </Grid>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </ControlTheme>

      <ControlTheme x:Key="{x:Type controls:WmclFormRow}" TargetType="controls:WmclFormRow">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate>
              <Grid x:Name="PART_FormLayout" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PART_FormLabel" Text="{TemplateBinding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ContentPresenter x:Name="PART_FormContent" Grid.Column="1" Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="Stretch" MinWidth="0" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://WMCL.UI/Styles/WmclTheme.axaml" />
    <StyleInclude Source="avares://WMCL.UI/Styles/WmclPage.axaml" />
    <StyleInclude Source="avares://WMCL.UI/Styles/WmclTaskControls.axaml" />
    <Style Selector="Popup">
      <Setter Property="InheritsTransform" Value="True" />
    </Style>
  </Application.Styles>

  <Application.DataTemplates>
    <DataTemplate DataType="vm:LaunchViewModel">
      <views:LaunchView />
    </DataTemplate>
    <DataTemplate DataType="vm:VersionSelectViewModel">
      <views:VersionSelectView />
    </DataTemplate>
    <DataTemplate DataType="vm:DownloadViewModel">
      <views:DownloadView />
    </DataTemplate>
    <DataTemplate DataType="vm:CleanroomViewModel">
      <views:CleanroomView />
    </DataTemplate>
    <DataTemplate DataType="vm:LabyModViewModel">
      <views:LabyModView />
    </DataTemplate>
    <DataTemplate DataType="vm:InstanceViewModel">
      <views:InstanceView />
    </DataTemplate>
    <DataTemplate DataType="vm:ModsViewModel">
      <views:ModsView />
    </DataTemplate>
    <DataTemplate DataType="vm:ModpackViewModel">
      <views:ModpackView />
    </DataTemplate>
    <DataTemplate DataType="vm:ResourceFavoritesViewModel">
      <views:ResourceFavoritesView />
    </DataTemplate>
    <DataTemplate DataType="vm:InstanceContentViewModel">
      <views:InstanceContentView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="vm:GameManageViewModel">
      <views:GameManageView />
    </DataTemplate>
    <DataTemplate DataType="vm:LogsViewModel">
      <views:LogsView />
    </DataTemplate>
    <DataTemplate DataType="vm:UpdateViewModel">
      <views:UpdateView />
    </DataTemplate>
    <DataTemplate DataType="vm:AboutViewModel">
      <views:AboutView />
    </DataTemplate>
    <DataTemplate DataType="vm:LinkViewModel">
      <views:LinkView />
    </DataTemplate>
    <DataTemplate DataType="vm:LinkSettingsViewModel">
      <views:LinkSettingsView />
    </DataTemplate>
    <DataTemplate DataType="vm:MorePageViewModel">
      <views:MoreInfoView />
    </DataTemplate>
    <DataTemplate DataType="vm:FeedbackViewModel">
      <views:FeedbackView />
    </DataTemplate>
    <DataTemplate DataType="vm:ToolboxViewModel">
      <views:ToolboxView />
    </DataTemplate>
    <DataTemplate DataType="vm:HelpViewModel">
      <views:HelpView />
    </DataTemplate>
    <DataTemplate DataType="vm:InstallViewModel">
      <views:InstallView />
    </DataTemplate>
    <DataTemplate DataType="vm:TaskManagerViewModel">
      <views:TaskManagerView />
    </DataTemplate>
  </Application.DataTemplates>

</Application>
