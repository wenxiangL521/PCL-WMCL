<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WMCL.App.ViewModels"
             xmlns:views="using:WMCL.App.Views"
             xmlns:controls="using:WMCL.App.Controls"
             xmlns:launch="using:WMCL.App.Features.Launch"
             xmlns:link="using:WMCL.App.Features.Link"
             xmlns:instances="using:WMCL.App.Features.Instances"
             xmlns:mods="using:WMCL.App.Features.Mods"
             xmlns:settings="using:WMCL.App.Features.Settings"
             xmlns:downloads="using:WMCL.App.Features.Downloads"
             xmlns:resources="using:WMCL.App.Features.Resources"
             xmlns:more="using:WMCL.App.Features.More"
             xmlns:tasks="using:WMCL.App.Features.Tasks"
             xmlns:versions="using:WMCL.App.Features.Versions"
             x:Class="WMCL.App.App"
             RequestedThemeVariant="Light">

  <Application.Resources>
    <ResourceDictionary>
      <FontFamily x:Key="WmclUiFontFamily">avares://WMCL.UI/Assets/Fonts#HarmonyOS Sans, Noto Sans CJK SC, Noto Sans SC, Source Han Sans CN, Microsoft YaHei UI, Microsoft YaHei, PingFang SC, Hiragino Sans GB, WenQuanYi Micro Hei, sans-serif</FontFamily>

      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://WMCL.UI/Styles/WmclColors.axaml" />
        <ResourceInclude Source="avares://WMCL.UI/Styles/WmclDimensions.axaml" />
        <ResourceInclude Source="avares://WMCL.UI/Styles/WmclIcons.axaml" />
        <ResourceInclude Source="avares://WMCL.UI/Styles/WmclControlThemes.axaml" />
        <ResourceInclude Source="avares://WMCL.App/Styles/WmclAppControlThemes.axaml" />
      </ResourceDictionary.MergedDictionaries>



    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://WMCL.UI/Styles/WmclTheme.axaml" />
    <StyleInclude Source="avares://WMCL.UI/Styles/WmclPage.axaml" />
    <StyleInclude Source="avares://WMCL.UI/Styles/WmclTaskControls.axaml" />
    <StyleInclude Source="avares://WMCL.UI/Styles/WmclRoomCard.axaml" />
    <StyleInclude Source="avares://WMCL.UI/Styles/WmclFlyout.axaml" />
    <StyleInclude Source="avares://WMCL.UI/Styles/WmclCompactList.axaml" />
    <StyleInclude Source="avares://WMCL.UI/Styles/WmclActionBar.axaml" />
    <Style Selector="Popup">
      <Setter Property="InheritsTransform" Value="True" />
    </Style>
  </Application.Styles>

  <Application.DataTemplates>
    <DataTemplate DataType="launch:LaunchViewModel">
      <launch:LaunchView ShowLeftPane="False" />
    </DataTemplate>
    <DataTemplate DataType="versions:VersionSelectViewModel">
      <views:VersionSelectView />
    </DataTemplate>
    <DataTemplate DataType="downloads:DownloadViewModel">
      <downloads:DownloadView />
    </DataTemplate>
    <DataTemplate DataType="downloads:CleanroomViewModel">
      <downloads:CleanroomView />
    </DataTemplate>
    <DataTemplate DataType="downloads:LabyModViewModel">
      <downloads:LabyModView />
    </DataTemplate>
    <DataTemplate DataType="instances:InstanceViewModel">
      <instances:InstanceView />
    </DataTemplate>
    <DataTemplate DataType="mods:ModsViewModel">
      <mods:ModsView />
    </DataTemplate>
    <DataTemplate DataType="downloads:ModpackViewModel">
      <views:ModpackView />
    </DataTemplate>
    <DataTemplate DataType="resources:ResourceFavoritesViewModel">
      <views:ResourceFavoritesView />
    </DataTemplate>
    <DataTemplate DataType="instances:InstanceContentViewModel">
      <views:InstanceContentView />
    </DataTemplate>
    <DataTemplate DataType="settings:SettingsViewModel">
      <settings:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="settings:GameManageViewModel">
      <views:GameManageView />
    </DataTemplate>
    <DataTemplate DataType="settings:LogsViewModel">
      <views:LogsView />
    </DataTemplate>
    <DataTemplate DataType="settings:UpdateViewModel">
      <views:UpdateView />
    </DataTemplate>
    <DataTemplate DataType="more:AboutViewModel">
      <views:AboutView />
    </DataTemplate>
    <DataTemplate DataType="link:LinkViewModel">
      <link:LinkView />
    </DataTemplate>
    <DataTemplate DataType="link:LinkSettingsViewModel">
      <link:LinkSettingsView />
    </DataTemplate>
    <DataTemplate DataType="link:AstralViewModel">
      <link:AstralView />
    </DataTemplate>
    <DataTemplate DataType="more:MorePageViewModel">
      <views:MoreInfoView />
    </DataTemplate>
    <DataTemplate DataType="more:FeedbackViewModel">
      <views:FeedbackView />
    </DataTemplate>
    <DataTemplate DataType="more:ToolboxViewModel">
      <views:ToolboxView />
    </DataTemplate>
    <DataTemplate DataType="more:HelpViewModel">
      <views:HelpView />
    </DataTemplate>
    <DataTemplate DataType="downloads:InstallViewModel">
      <downloads:InstallView />
    </DataTemplate>
    <DataTemplate DataType="tasks:TaskManagerViewModel">
      <views:TaskManagerView />
    </DataTemplate>
  </Application.DataTemplates>

</Application>
