<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WMCL.App.ViewModels"
             xmlns:views="using:WMCL.App.Views"
             x:Class="WMCL.App.App"
             RequestedThemeVariant="Light">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://WMCL.UI/Styles/WmclColors.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <ControlTheme x:Key="PclCheckBoxTheme" TargetType="CheckBox">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource WmclText}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate>
              <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                <Border x:Name="CheckBoxBorder"
                        Width="18" Height="18"
                        CornerRadius="3"
                        BorderThickness="1.1"
                        BorderBrush="{DynamicResource WmclText}"
                        Background="#55FFFFFF"
                        VerticalAlignment="Center">
                  <Path x:Name="CheckBoxCheck"
                        Data="M0,6L1.5,4.5 4.5,7.5 10.5,1.5 12,3 4.5,10.5 0,6z"
                        Width="12" Height="12"
                        Stretch="Uniform"
                        Fill="{DynamicResource WmclBlue2}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="False" />
                </Border>
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Grid.Column="1"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style Selector="^:checked /template/ Border#CheckBoxBorder">
          <Setter Property="BorderBrush" Value="{DynamicResource WmclBlue2}" />
        </Style>
        <Style Selector="^:checked /template/ Path#CheckBoxCheck">
          <Setter Property="IsVisible" Value="True" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://WMCL.UI/Styles/WmclTheme.axaml" />
  </Application.Styles>

  <Application.DataTemplates>
    <DataTemplate DataType="vm:LaunchViewModel">
      <views:LaunchView />
    </DataTemplate>
    <DataTemplate DataType="vm:VersionSelectViewModel">
      <views:VersionSelectView />
    </DataTemplate>
    <DataTemplate DataType="vm:DownloadViewModel">
      <views:DownloadView />
    </DataTemplate>
    <DataTemplate DataType="vm:InstanceViewModel">
      <views:InstanceView />
    </DataTemplate>
    <DataTemplate DataType="vm:ModsViewModel">
      <views:ModsView />
    </DataTemplate>
    <DataTemplate DataType="vm:ModpackViewModel">
      <views:ModpackView />
    </DataTemplate>
    <DataTemplate DataType="vm:InstanceContentViewModel">
      <views:InstanceContentView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="vm:AboutViewModel">
      <views:AboutView />
    </DataTemplate>
    <DataTemplate DataType="vm:LinkViewModel">
      <views:LinkView />
    </DataTemplate>
    <DataTemplate DataType="vm:MorePageViewModel">
      <views:MoreInfoView />
    </DataTemplate>
    <DataTemplate DataType="vm:HelpViewModel">
      <views:HelpView />
    </DataTemplate>
    <DataTemplate DataType="vm:InstallViewModel">
      <views:InstallView />
    </DataTemplate>
  </Application.DataTemplates>

</Application>
