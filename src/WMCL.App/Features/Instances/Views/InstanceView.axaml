<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WMCL.App.Controls"
             xmlns:views="using:WMCL.App.Views"
             x:Class="WMCL.App.Features.Instances.InstanceView"
             FontSize="{DynamicResource WmclFontBody}">

  <UserControl.Styles>
    <Style Selector="ListBox#SectionList ListBoxItem">
      <Setter Property="CornerRadius" Value="{DynamicResource WmclCornerCard}" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="ListBox#SectionList ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource WmclBlue7}" />
      <Setter Property="Foreground" Value="{DynamicResource WmclBlue2}" />
    </Style>
    <Style Selector="ListBox#SectionList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WmclBlue7}" />
      <Setter Property="Foreground" Value="{DynamicResource WmclBlue2}" />
    </Style>
    <Style Selector="ListBox#SectionList ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource WmclBlue2}" />
    </Style>
    <Style Selector="ListBox#SectionList ListBoxItem:selected Path">
      <Setter Property="Stroke" Value="{DynamicResource WmclBlue2}" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="152,*" IsEnabled="{Binding !IsManagingInstance}">
    <Border Background="{DynamicResource WmclSidebar}"
            BorderBrush="{DynamicResource WmclBorder}"
            BorderThickness="0,0,1,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ListBox x:Name="SectionList"
               Classes="subTabs"
               SelectedIndex="{Binding SelectedSectionIndex, Mode=TwoWay}"
               Background="Transparent"
               BorderThickness="0"
               Margin="6,12,6,12">
        <ListBoxItem Content="概览" Padding="12,8" Height="36" IsVisible="{Binding ShowOverviewSection}" />
        <ListBoxItem Padding="0" Height="36" IsVisible="{Binding ShowSettingsSection}">
          <Grid ColumnDefinitions="*,Auto" Margin="12,0,6,0">
            <TextBlock Text="设置" VerticalAlignment="Center" />
            <Button x:Name="SettingsResetButton" Grid.Column="1" Classes="iconButton size16"
                    ToolTip.Tip="初始化实例设置" Click="OnResetSectionClick">
              <Path Data="{StaticResource WmclIconRotateCcw}" Width="16" Height="16" Stretch="Uniform" />
            </Button>
          </Grid>
        </ListBoxItem>
        <ListBoxItem Content="修改" Padding="12,8" Height="36" IsVisible="{Binding ShowModifySection}" />
        <ListBoxItem Content="Mod 管理" Padding="12,8" Height="36" IsVisible="{Binding ShowModsSection}" />
        <ListBoxItem Padding="0" Height="36" IsVisible="{Binding ShowExportSection}">
          <Grid ColumnDefinitions="*,Auto" Margin="12,0,6,0">
            <TextBlock Text="导出" VerticalAlignment="Center" />
            <Button x:Name="ExportRefreshButton" Grid.Column="1" Classes="iconButton size16"
                    ToolTip.Tip="刷新" Click="OnRefreshSectionClick">
              <Path Data="{StaticResource WmclIconRefresh}" Width="16" Height="16" Stretch="Uniform" />
            </Button>
          </Grid>
        </ListBoxItem>
        <ListBoxItem Content="服务器" Padding="12,8" Height="36" IsVisible="{Binding ShowServerSection}" />
        <ListBoxItem Content="资源包" Padding="12,8" Height="36" IsVisible="{Binding ShowResourcePackSection}" />
        <ListBoxItem Content="存档" Padding="12,8" Height="36" IsVisible="{Binding ShowSaveSection}" />
        <ListBoxItem Content="光影" Padding="12,8" Height="36" IsVisible="{Binding ShowShaderSection}" />
        <ListBoxItem Content="截图" Padding="12,8" Height="36" IsVisible="{Binding ShowScreenshotSection}" />
      </ListBox>
      </ScrollViewer>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="20,12,20,0">
        <TextBlock Text="当前实例" Classes="cardTitle" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Instances}"
                  SelectedItem="{Binding SelectedInstance}" Width="220">
          <ComboBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Id}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="2" Content="刷新" Classes="secondary"
                Command="{Binding RefreshCommand}" Padding="10,3" MinHeight="30" />
      </Grid>
      <Grid Grid.Row="1" x:Name="SectionHost">
      <ScrollViewer x:Name="PageScroll" Classes="page" Margin="{DynamicResource WmclPagePadding}">
        <StackPanel Classes="pageStack">
        <Border Classes="card" x:Name="OverviewCard" IsVisible="True">
          <StackPanel Classes="cardBody">
        <TextBlock Text="实例信息" Classes="cardTitle" />
        <TextBlock Text="{Binding SelectedInstanceTitle}" Classes="resourceTitle" />
        <TextBlock Text="{Binding SelectedInstanceInfo}" Classes="muted" />
        <TextBlock Text="{Binding SelectedInstancePath}"
                   Classes="faint"
                   TextWrapping="Wrap" />

        <StackPanel Classes="form">
          <controls:WmclFormRow Label="实例图标">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding InstanceLogoPath}" PlaceholderText="实例图标路径（可选）" />
              <Button Grid.Column="1" Content="选择图标" Classes="secondary" Click="OnChooseInstanceLogoClick" />
            </Grid>
          </controls:WmclFormRow>
          <controls:WmclFormRow Label="收藏与描述">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <CheckBox Theme="{StaticResource PclCheckBoxTheme}" Content="收藏" IsChecked="{Binding InstanceFavorite}" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding InstanceDescription}" PlaceholderText="实例描述（可选）" />
            </Grid>
          </controls:WmclFormRow>
          <controls:WmclFormRow Label="分类">
            <StackPanel Spacing="3">
              <ComboBox ItemsSource="{Binding InstanceCategoryOptions}" SelectedItem="{Binding InstanceCategory}"
                        HorizontalAlignment="Stretch" />
              <TextBox Text="{Binding InstanceCategory}" PlaceholderText="或输入自定义分类（留空=未分类）" />
            </StackPanel>
          </controls:WmclFormRow>
          <controls:WmclFormRow Label="版本分类">
            <ComboBox ItemsSource="{Binding VersionCardTypeOptions}" SelectedItem="{Binding InstanceVersionCardType}"
                      HorizontalAlignment="Stretch"
                      ToolTip.Tip="控制该版本出现在版本列表的哪个卡片；自动时按原版规则分类。隐藏后可在版本列表按 F11 查看。" />
          </controls:WmclFormRow>
          <controls:WmclFormRow Label="版本隔离">
            <ComboBox ItemsSource="{Binding IsolationOptions}" SelectedItem="{Binding InstanceIsolation}"
                      HorizontalAlignment="Stretch" />
          </controls:WmclFormRow>
        </StackPanel>

          </StackPanel>
        </Border>

        <Border Classes="card" x:Name="ServerCard" IsVisible="False">
          <StackPanel Classes="cardBody">
        <TextBlock Text="服务器" Classes="cardTitle" />
        <Border Background="{DynamicResource WmclBlue8}"
                CornerRadius="{DynamicResource WmclCornerCard}"
                Padding="12"
                Margin="0,4,0,0">
          <StackPanel Spacing="6">
            <Expander Header="服务器列表" Classes="cardSection" HorizontalAlignment="Stretch">
          <StackPanel Spacing="6">
            <ListBox ItemsSource="{Binding Servers}"
                     SelectedItem="{Binding SelectedServer}"
                     MinHeight="120">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                    <Image Source="{Binding IconImage}" Width="28" Height="28"
                           IsVisible="{Binding HasIcon}" Stretch="Uniform" />
                    <StackPanel Grid.Column="1" Spacing="1">
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Address}" Classes="faint" />
                        <TextBlock Text="{Binding PingText}" Classes="faint" FontSize="11" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
              <TextBox Text="{Binding NewServerName}" PlaceholderText="名称" />
              <TextBox Grid.Column="1" Text="{Binding NewServerAddress}" PlaceholderText="地址：端口" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="添加" Classes="primary" Command="{Binding AddServerCommand}" />
              <Button Content="删除" Command="{Binding RemoveServerCommand}" />
              <Button Content="保存" Command="{Binding SaveServersNowCommand}" />
              <Button Content="Ping" Command="{Binding PingServerCommand}"
                      IsEnabled="{Binding !IsServerPinging}" />
              <Button Content="全部 Ping" Command="{Binding PingAllServersCommand}"
                      IsEnabled="{Binding !IsServerPinging}" />
              <Button Content="导入" Click="OnImportServersClick" />
              <Button Content="导出" Click="OnExportServersClick" />
            </StackPanel>
            <TextBlock Text="{Binding ServerStatus}" Classes="faint" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Image Source="{Binding ServerFavicon}" Width="28" Height="28"
                     IsVisible="{Binding HasServerFavicon}" Stretch="Uniform" />
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding ServerPingText}" Classes="faint" TextWrapping="Wrap" />
                <controls:MotdTextBlock Runs="{Binding ServerMotdRuns}"
                                        IsVisible="{Binding HasServerMotdRuns}"
                                        TextWrapping="Wrap" FontSize="12" />
                <ItemsControl ItemsSource="{Binding ServerModList}"
                              IsVisible="{Binding HasServerModList}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="card" Margin="0,0,4,0" Padding="4,2" CornerRadius="{DynamicResource WmclCornerButton}">
                        <TextBlock Text="{Binding ModId}" FontSize="11" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Expander>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="准备服务端文件" Classes="secondary"
                  Command="{Binding PrepareServerFilesCommand}" />
          <Button Content="启动服务端" Classes="secondary"
                  Command="{Binding StartServerCommand}"
                  IsEnabled="{Binding !IsServerRunning}" />
          <Button Content="停止服务端" Classes="secondary"
                  Command="{Binding StopServerCommand}"
                  IsEnabled="{Binding IsServerRunning}" />
        </StackPanel>
        <TextBlock Text="{Binding ServerFilesStatus}" Classes="faint" TextWrapping="Wrap" />
        <TextBox Text="{Binding ServerConsole}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 MinHeight="140"
                 FontFamily="monospace"
                 TextWrapping="NoWrap"
                 PlaceholderText="服务端输出" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Text="{Binding ServerCommand}"
                   PlaceholderText="控制台命令，例如 say hello"
                   IsEnabled="{Binding IsServerRunning}" />
          <Button Grid.Column="1" Content="发送" Margin="8,0,0,0"
                  Command="{Binding SendServerCommandCommand}"
                  IsEnabled="{Binding IsServerRunning}" />
        </Grid>
        <TextBlock Text="server.properties" Classes="faint" />
        <TextBox Text="{Binding ServerPropertiesText}"
                 AcceptsReturn="True"
                 Height="100"
                 FontFamily="monospace"
                 PlaceholderText="准备服务端文件后可编辑" />
        <Button Content="保存 server.properties" Classes="secondary"
                Command="{Binding SaveServerPropertiesCommand}" />

        <TextBlock Text="实例目录" FontWeight="SemiBold" />
            <TextBlock Text="与官方启动器兼容：versions/&lt;id&gt;/ 下保存版本 JSON、客户端 jar 与 natives。"
                       Classes="muted"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
          </StackPanel>
        </Border>

        <Border Classes="card" x:Name="ExportCard" IsVisible="False">
          <StackPanel Classes="cardBody">
            <TextBlock Text="导出当前实例" Classes="cardTitle" />
            <controls:WmclFormRow Label="导出用途">
              <ComboBox ItemsSource="{Binding ExportModes}" SelectedItem="{Binding ExportMode}" IsEnabled="{Binding !IsExporting}" />
            </controls:WmclFormRow>
            <TextBlock Text="{Binding ExportExplanation}" Classes="muted" TextWrapping="Wrap" />
            <controls:WmclFormRow Label="分享格式" IsVisible="{Binding IsModpackExport}">
              <ComboBox ItemsSource="{Binding ExportFormats}" SelectedItem="{Binding ExportFormat}" IsEnabled="{Binding !IsExporting}" />
            </controls:WmclFormRow>
            <controls:WmclFormRow Label="保存到">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding ExportPath}" PlaceholderText="留空使用系统下载目录（Downloads），不覆盖已有文件" IsEnabled="{Binding !IsExporting}" />
                <Button Grid.Column="1" Content="选择位置" Classes="secondary" Click="OnChooseExportPathClick" IsEnabled="{Binding !IsExporting}" />
              </Grid>
            </controls:WmclFormRow>
            <Expander x:Name="ExportContentsSection" Header="选择导出内容" Classes="cardSection" HorizontalAlignment="Stretch">
              <StackPanel Spacing="5" IsEnabled="{Binding !IsExporting}">
                <CheckBox Theme="{StaticResource PclCheckBoxTheme}" Content="Mod" IsChecked="{Binding ExportMods}" />
                <CheckBox Theme="{StaticResource PclCheckBoxTheme}" Content="配置" IsChecked="{Binding ExportConfigs}" />
                <CheckBox Theme="{StaticResource PclCheckBoxTheme}" Content="资源包" IsChecked="{Binding ExportResourcePacks}" />
                <CheckBox Theme="{StaticResource PclCheckBoxTheme}" Content="光影" IsChecked="{Binding ExportShaderPacks}" />
                <CheckBox Theme="{StaticResource PclCheckBoxTheme}" Content="存档" IsChecked="{Binding ExportSaves}" />
                <CheckBox Theme="{StaticResource PclCheckBoxTheme}" Content="WMCL 配置" IsChecked="{Binding ExportWmcl}" />
                <CheckBox Theme="{StaticResource PclCheckBoxTheme}" Content="options.txt" IsChecked="{Binding ExportOptions}" />
                <TextBlock Text="分享存档会包含游玩进度，请只在确定需要时勾选。" Classes="faint" TextWrapping="Wrap" />
                <StackPanel Spacing="6" IsVisible="{Binding IsModpackExport}">
                  <CheckBox x:Name="UseExportFileSelectionToggle" Theme="{StaticResource PclCheckBoxTheme}"
                            Content="按文件/文件夹选择（仅导出勾选项）" IsChecked="{Binding UseExportFileSelection}" />
                  <StackPanel Spacing="6" IsVisible="{Binding UseExportFileSelection}">
                    <WrapPanel ItemSpacing="7" LineSpacing="7">
                      <Button Content="刷新文件清单" Command="{Binding RefreshExportFilesCommand}" IsEnabled="{Binding !IsLoadingExportFiles}" />
                      <Button Content="全选" Command="{Binding SelectAllExportFilesCommand}" />
                      <Button Content="全不选" Command="{Binding ClearExportFileSelectionCommand}" />
                      <TextBlock Text="{Binding ExportSelectionCount}" Classes="faint" VerticalAlignment="Center" />
                    </WrapPanel>
                    <controls:PclLoadingIndicator IsRunning="{Binding IsLoadingExportFiles}"
                                                IsVisible="{Binding IsLoadingExportFiles}"
                                                HorizontalAlignment="Left" />
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl x:Name="ExportFileChoices" ItemsSource="{Binding ExportFiles}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="8" Margin="0,1">
                              <controls:LocalResourceIcon SourcePath="{Binding FullPath}" Kind="{Binding IconKind}" Width="18" Height="18" />
                              <CheckBox Grid.Column="1" Theme="{StaticResource PclCheckBoxTheme}" IsChecked="{Binding IsSelected}" ToolTip.Tip="{Binding RelativePath}">
                                <TextBlock Text="{Binding RelativePath}" TextTrimming="CharacterEllipsis" />
                              </CheckBox>
                              <TextBlock Grid.Column="2" Text="{Binding SizeText}" Classes="faint" VerticalAlignment="Center" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{Binding ExportFileSelectionStatus}" Classes="faint" TextWrapping="Wrap" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Expander>
            <Button Content="{Binding ExportButtonText}" HorizontalAlignment="Stretch" Classes="primary"
                    Command="{Binding ExportCommand}" IsEnabled="{Binding !IsExporting}" />
            <TextBlock Text="{Binding Status}" Classes="faint" TextWrapping="Wrap" />
            <Expander x:Name="MaintenanceToolsSection" Header="维护工具（不属于导出）" Classes="cardSection" HorizontalAlignment="Stretch">
              <StackPanel Spacing="8">
                <WrapPanel ItemSpacing="7" LineSpacing="7">
                  <Button Content="打开版本目录" Command="{Binding OpenFolderCommand}" />
                  <Button Content="打开游戏目录" Command="{Binding OpenGameFolderCommand}" />
                  <Button Content="校验安装清单" Command="{Binding VerifyManifestCommand}" />
                  <Button Content="修复游戏与整合包文件" Command="{Binding RepairManifestCommand}" IsEnabled="{Binding CanRepairManifest}" />
                  <Button Content="取消修复" Command="{Binding RepairManifestCancelCommand}" IsVisible="{Binding IsRepairingManifest}" />
                </WrapPanel>
                <TextBlock Text="{Binding ManifestStatus}" Classes="faint" TextWrapping="Wrap" />
                <TextBlock Text="已有存档文件仅检查是否存在，修复不会覆盖游玩进度。" Classes="faint" TextWrapping="Wrap" />
                <StackPanel IsVisible="{Binding IsMcbbsModpack}" Spacing="6">
                  <Button Content="更新整合包内容" Command="{Binding UpdateModpackContentCommand}" />
                  <Button Content="取消整合包更新" IsVisible="{Binding IsUpdatingModpack}" Command="{Binding UpdateModpackContentCancelCommand}" />
                </StackPanel>
                <WrapPanel ItemSpacing="7" LineSpacing="7">
                  <Button Content="克隆" Command="{Binding CloneInstanceCommand}" />
                  <Button Content="重命名" Command="{Binding RenameInstanceCommand}" />
                  <Button Content="删除实例" Command="{Binding DeleteInstanceCommand}" />
                  <Button Content="回收站" Command="{Binding ToggleTrashCommand}" IsVisible="{Binding IsTrashEnabled}" />
                </WrapPanel>
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding ShowTrash}">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="回收站" Classes="cardTitle" VerticalAlignment="Center" />
              <Button Content="刷新" Command="{Binding RefreshTrashCommand}" Classes="secondary" />
              <Button Content="清空回收站" Command="{Binding ClearTrashCommand}" Classes="secondary" />
            </StackPanel>
            <TextBlock Text="{Binding TrashStatus}" Classes="faint" />
            <ItemsControl ItemsSource="{Binding TrashEntries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="card" Margin="0,4" Padding="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding VersionId}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding DeletedAt, StringFormat='删除于 {0:yyyy-MM-dd HH:mm}'}"
                                 Classes="faint" VerticalAlignment="Center" />
                      <Button Content="恢复" Command="{Binding $parent[ItemsControl].DataContext.RestoreFromTrashCommand}"
                              CommandParameter="{Binding}" Classes="secondary" />
                      <Button Content="永久删除" Command="{Binding $parent[ItemsControl].DataContext.PermanentDeleteFromTrashCommand}"
                              CommandParameter="{Binding}" Classes="secondary" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="card" x:Name="SettingsCard" IsVisible="False">
          <StackPanel Classes="cardBody">
        <TextBlock Text="实例设置" Classes="cardTitle" />

        <StackPanel Classes="form">
          <CheckBox Theme="{StaticResource PclCheckBoxTheme}" Content="内存使用全局设置"
                    IsChecked="{Binding UseGlobalMemory}" />
          <controls:WmclFormRow Label="内存 (MB)">
            <NumericUpDown Value="{Binding InstanceMemoryMb}" Minimum="512" Maximum="32768"
                           Increment="512" IsEnabled="{Binding CanEditMemory}" />
          </controls:WmclFormRow>

          <CheckBox Theme="{StaticResource PclCheckBoxTheme}" Content="Java 使用全局设置"
                    IsChecked="{Binding UseGlobalJava}" />
          <controls:WmclFormRow Label="Java 版本">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
              <ComboBox ItemsSource="{Binding InstanceJavaRuntimes}"
                        SelectedItem="{Binding SelectedInstanceJavaRuntime}"
                        PlaceholderText="自动选择（或从已发现的 Java 中选择）"
                        IsEnabled="{Binding CanEditJava}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                      <TextBlock Text="{Binding MajorVersion, StringFormat='Java {0}'}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="{Binding Architecture}" Classes="faint" />
                      <TextBlock Grid.Column="2" Text="{Binding Home}" Classes="faint"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                    </Grid>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="1" Content="重新扫描" Classes="secondary"
                      Command="{Binding RefreshInstanceJavaCommand}" IsEnabled="{Binding CanEditJava}" />
            </Grid>
          </controls:WmclFormRow>
          <controls:WmclFormRow Label="Java 路径">
            <TextBox Text="{Binding InstanceJavaPath}" PlaceholderText="Java 路径（留空则自动选择）"
                     IsEnabled="{Binding CanEditJava}" ToolTip.Tip="{Binding InstanceJavaStatus}" />
          </controls:WmclFormRow>
          <controls:WmclFormRow Label="额外 JVM 参数">
            <TextBox Text="{Binding InstanceJvmArgs}" PlaceholderText="-Dfoo=bar" />
          </controls:WmclFormRow>
          <controls:WmclFormRow Label="额外游戏参数">
            <TextBox Text="{Binding InstanceGameArgs}" PlaceholderText="--fullscreen" />
          </controls:WmclFormRow>

          <CheckBox Theme="{StaticResource PclCheckBoxTheme}" Content="窗口大小使用全局设置"
                    IsChecked="{Binding UseGlobalWindow}" />
          <controls:WmclFormRow Label="窗口宽高">
            <Grid ColumnDefinitions="*,Auto,*">
              <NumericUpDown Value="{Binding InstanceWidth}" Minimum="320" Maximum="7680"
                             Increment="10" IsEnabled="{Binding CanEditWindow}" />
              <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" Margin="10,0" />
              <NumericUpDown Grid.Column="2" Value="{Binding InstanceHeight}" Minimum="240" Maximum="4320"
                             Increment="10" IsEnabled="{Binding CanEditWindow}" />
            </Grid>
          </controls:WmclFormRow>
          <controls:WmclFormRow Label="初始堆大小 (MB)">
            <TextBox Text="{Binding InstanceInitialHeap}" PlaceholderText="0 = 使用全局值" />
          </controls:WmclFormRow>
          <controls:WmclFormRow Label="GC 策略">
            <ComboBox ItemsSource="{Binding GcStrategies}" SelectedItem="{Binding InstanceGcStrategy}" />
          </controls:WmclFormRow>
          <controls:WmclFormRow Label="自动加入服务器">
            <Grid ColumnDefinitions="*,100">
              <TextBox Text="{Binding InstanceServer}" PlaceholderText="服务器地址（留空不自动加入）" />
              <NumericUpDown Grid.Column="1" Value="{Binding InstanceServerPort}" Minimum="1" Maximum="65535"
                             Margin="8,0,0,0" />
            </Grid>
          </controls:WmclFormRow>
          <controls:WmclFormRow Label="第三方认证服务器">
            <TextBox Text="{Binding InstanceAuthServer}"
                     PlaceholderText="留空使用启动页全局账号；例如 https://littleskin.cn/api/yggdrasil" />
          </controls:WmclFormRow>
          <controls:WmclFormRow Label="认证显示名称">
            <TextBox Text="{Binding InstanceAuthServerName}" PlaceholderText="显示名称（可选）" />
          </controls:WmclFormRow>
          <controls:WmclFormRow Label="插件目录（服务端）">
            <TextBox Text="{Binding InstancePluginDirectory}"
                     PlaceholderText="留空使用 &lt;游戏目录&gt;/plugins；可填服务器 plugins 目录" />
          </controls:WmclFormRow>
          <controls:WmclFormRow Label="启动前执行命令">
            <TextBox Text="{Binding InstancePreLaunchCommand}"
                     PlaceholderText="例如 {java} -version；支持 {java}/{minecraft}/{verpath}/{name}" />
          </controls:WmclFormRow>
          <CheckBox Theme="{StaticResource PclCheckBoxTheme}" Content="等待命令执行完成后再启动游戏"
                    IsChecked="{Binding InstancePreLaunchWait}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="保存实例设置"
                  Classes="primary"
                  Command="{Binding SaveInstanceSettingsCommand}" />
          <Button Content="重置"
                  Command="{Binding ResetInstanceSettingsCommand}" />
        </StackPanel>

        <TextBlock Text="{Binding Status}"
                   Classes="muted"
                   TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        </StackPanel>
      </ScrollViewer>
      <views:ScreenshotView x:Name="ScreenshotCard" IsVisible="False" Margin="{DynamicResource WmclPagePadding}" />
      <ContentControl x:Name="EmbeddedPageHost" Content="{Binding EmbeddedPage}" IsVisible="False"
                      Margin="{DynamicResource WmclPagePadding}" IsEnabled="{Binding !IsSectionPreparing}"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      <controls:LoadingOverlay IsRunning="{Binding IsSectionPreparing}" />
      <controls:LoadingOverlay IsRunning="{Binding IsExporting}" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
