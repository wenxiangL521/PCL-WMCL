<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WMCL.App.Controls"
             xmlns:motion="using:WMCL.App.Animation"
             x:Class="WMCL.App.Features.Launch.LaunchView"
             FontSize="{DynamicResource WmclFontBody}">

  <UserControl.Styles>
    <Style Selector="Border.accountMenu">
      <Setter Property="Background" Value="{DynamicResource WmclCard}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WmclBlue6}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource WmclCornerCard}" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="translateY(6px)" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="CubicEaseOut" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.accountMenu.open">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="translateY(0px)" />
    </Style>
    <Style Selector="ListBox.accountList ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WmclCard}" />
    </Style>
    <Style Selector="ListBox.accountList ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WmclBlue7}" />
    </Style>
    <Style Selector="ListBox.accountList ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WmclBlue6}" />
    </Style>
    <Style Selector="Button.playerName">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="CornerRadius" Value="{DynamicResource WmclCornerCard}" />
    </Style>
    <Style Selector="Button.playerName:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WmclCard}" />
    </Style>
    <Style Selector="RadioButton.accountPill">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{DynamicResource WmclCornerCapsule}"
                  Padding="14,0"
                  MinHeight="27">
            <ContentPresenter Content="{TemplateBinding Content}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Setter Property="Background" Value="{DynamicResource WmclOverlayCapsule}" />
      <Setter Property="Foreground" Value="{DynamicResource WmclText}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="27" />
    </Style>
    <Style Selector="RadioButton.accountPill:pointerover">
      <Setter Property="Background" Value="{DynamicResource WmclBlue8}" />
    </Style>
    <Style Selector="RadioButton.accountPill Path">
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="{DynamicResource WmclBlue3}" />
      <Setter Property="StrokeThickness" Value="1.7" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="RadioButton.accountPill TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource WmclBlue3}" />
    </Style>
    <Style Selector="RadioButton.accountPill:checked Path">
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="White" />
    </Style>
    <Style Selector="RadioButton.accountPill:checked TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.accountPill:checked">
      <Setter Property="Background" Value="{DynamicResource WmclBlue3}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </UserControl.Styles>

  <!-- PCL2 PageLaunchLeft：300px 登录/启动区；PageLaunchRight：25px 外边距 + 日志卡片。 -->
  <Grid ColumnDefinitions="300,*">
    <Border Grid.Column="0"
            Background="{DynamicResource WmclSidebar}"
            BorderThickness="0">
      <Grid RowDefinitions="*,Auto,Auto" Margin="20,0,20,12">
        <Grid Grid.Row="0">
          <StackPanel x:Name="AccountPanel"
                      VerticalAlignment="Center"
                      Spacing="8">
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      Spacing="6">
            <RadioButton x:Name="OnlineAccountRadio"
                         Classes="accountPill"
                         GroupName="AccountType"
                         IsChecked="{Binding IsMicrosoftAccount, Mode=OneWay}"
                         Click="OnOnlineAccountClick">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Path Data="M511.488256 95.184408c35.310345 22.516742 95.184408 55.78011 167.34033 84.437781 75.738131 29.681159 148.405797 40.93953 191.392304 45.033483v353.615193c0 73.691154-50.662669 164.781609-136.123938 244.101949C649.65917 901.181409 558.568716 942.12094 512 942.12094c-46.568716 0-137.65917-40.93953-222.096952-119.748126C204.441779 742.54073 153.77911 651.450275 153.77911 577.247376v-353.103448c42.474763-4.093953 116.165917-15.352324 191.904048-45.545227 75.226387-30.192904 133.565217-63.456272 165.805098-83.414293M512 0c-4.093953 0-8.187906 1.535232-11.258371 3.582209l-14.84058 10.234882c-1.023488 0.511744-67.550225 47.592204-170.410794 88.531735-100.813593 39.916042-198.556722 41.963018-199.58021 41.963018l-25.075462 0.511744c-10.746627 0.511744-18.934533 8.187906-18.934533 18.422789v414.000999c0 216.97951 286.064968 446.24088 440.09995 446.24088s440.09995-229.261369 440.09995-445.729136V163.758121c0-10.234883-8.69965-18.422789-18.934533-18.422789l-24.563718-0.511744c-1.023488 0-98.766617-2.046977-199.58021-41.963018-103.372314-40.93953-170.410795-88.01999-170.922538-88.531734L523.258371 3.582209c-3.070465-2.558721-7.164418-3.582209-11.258371-3.582209z M743.308346 410.930535l-260.477761 260.477761c-15.864068 15.864068-41.963018 15.864068-57.827087 0l-144.823588-144.823588c-15.864068-15.864068-15.864068-41.963018 0-57.827087 8.187906-8.187906 18.422789-11.770115 29.169415-11.770115 10.234883 0 20.981509 4.093953 29.169416 11.770115l115.654173 115.654173L685.993003 352.591704c15.864068-15.864068 41.963018-15.864068 57.827087 0 15.352324 16.375812 15.352324 42.474763-0.511744 58.338831z" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
              <TextBlock Text="正版" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
            <RadioButton x:Name="OfflineAccountRadio"
                         Classes="accountPill"
                         GroupName="AccountType"
                         IsChecked="{Binding IsOfflineAccount, Mode=OneWay}"
                         Click="OnOfflineAccountClick">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Path Data="M533.293176 788.841412a60.235294 60.235294 0 1 1 85.202824 85.202823l-42.616471 42.586353c-129.355294 129.385412-339.124706 129.385412-468.510117 0-129.385412-129.385412-129.385412-339.124706 0-468.510117l42.586353-42.616471a60.235294 60.235294 0 1 1 85.202823 85.202824l-42.61647 42.586352a210.823529 210.823529 0 1 0 298.164706 298.164706l42.586352-42.61647z m255.548236-255.548236l42.61647-42.586352a210.823529 210.823529 0 1 0-298.164706-298.164706l-42.586352 42.61647a60.235294 60.235294 0 1 1-85.202824-85.202823l42.616471-42.586353c129.355294-129.385412 339.124706-129.385412 468.510117 0 129.385412 129.385412 129.385412 339.124706 0 468.510117l-42.586353 42.616471a60.235294 60.235294 0 1 1-85.202823-85.202824zM192.542118 192.542118a60.235294 60.235294 0 0 1 85.202823 0l553.712941 553.712941a60.235294 60.235294 0 0 1-85.202823 85.202823L192.542118 277.744941a60.235294 60.235294 0 0 1 0-85.202823z" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
              <TextBlock Text="离线" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
            <RadioButton x:Name="AuthlibAccountRadio"
                         Classes="accountPill"
                         GroupName="AccountType"
                         IsChecked="{Binding IsAuthlibAccount, Mode=OneWay}"
                         Click="OnAuthlibAccountClick">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Path Data="M533.293176 788.841412a60.235294 60.235294 0 1 1 85.202824 85.202823l-42.616471 42.586353c-129.355294 129.385412-339.124706 129.385412-468.510117 0-129.385412-129.385412-129.385412-339.124706 0-468.510117l42.586353-42.616471a60.235294 60.235294 0 1 1 85.202823 85.202824l-42.61647 42.586352a210.823529 210.823529 0 1 0 298.164706 298.164706l42.586352-42.61647z m255.548236-255.548236l42.61647-42.586352a210.823529 210.823529 0 1 0-298.164706-298.164706l-42.586352 42.61647a60.235294 60.235294 0 1 1-85.202824-85.202823l42.616471-42.586353c129.355294-129.385412 339.124706-129.385412 468.510117 0 129.385412 129.385412 129.385412 339.124706 0 468.510117l-42.586353 42.616471a60.235294 60.235294 0 1 1-85.202823-85.202824zM192.542118 192.542118a60.235294 60.235294 0 0 1 85.202823 0l553.712941 553.712941a60.235294 60.235294 0 0 1-85.202823 85.202823L192.542118 277.744941a60.235294 60.235294 0 0 1 0-85.202823z" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
              <TextBlock Text="第三方" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          </StackPanel>


          <Border x:Name="AccountDetail" Height="150">
            <StackPanel Spacing="6" VerticalAlignment="Top">
              <StackPanel HorizontalAlignment="Center" Spacing="4">
            <Border x:Name="AvatarButton" Width="64" Height="64"
                    ClipToBounds="True"
                    Cursor="Hand"
                    CornerRadius="{DynamicResource WmclCornerCard}"
                    Background="Transparent">
              <Border.ContextMenu>
                <ContextMenu>
                  <MenuItem x:Name="AvatarSkinMenuItem" Header="皮肤" Click="OnAvatarSkinMenuClick" />
                  <MenuItem x:Name="AvatarRefreshMenuItem" Header="刷新皮肤" Click="OnAvatarRefreshMenuClick" />
                </ContextMenu>
              </Border.ContextMenu>
              <controls:SkinFaceImage Source="{Binding AccountSkin}"
                                      Width="64"
                                      Height="64"
                                      IsHitTestVisible="False" />
            </Border>
            <Button x:Name="PlayerNameButton" Classes="playerName"
                    HorizontalAlignment="Center"
                    Click="OnPlayerNameClick">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding PlayerName}" FontWeight="SemiBold"
                           FontSize="{DynamicResource WmclFontBody}" VerticalAlignment="Center" />
                <Path Data="{StaticResource WmclIconChevronDown}" Width="12" Height="12"
                      Stretch="Uniform" VerticalAlignment="Center"
                      Fill="{DynamicResource WmclBlue3}" />
              </StackPanel>
            </Button>
              <Popup x:Name="AccountPopup"
                     PlacementTarget="{Binding #PlayerNameButton}"
                     Placement="Bottom"
                     IsLightDismissEnabled="True"
                     IsOpen="False">
                <Border x:Name="AccountPopupPanel" Classes="accountMenu" Width="260">
<StackPanel Spacing="8" MinWidth="240">
                  <TextBlock Text="帐号列表" Classes="faint" />
                  <ListBox Classes="accountList" ItemsSource="{Binding MicrosoftAccounts}"
                           SelectedItem="{Binding SelectedMicrosoftAccount}"
                           IsVisible="{Binding IsMicrosoftAccount}"
                           MaxHeight="200">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <ListBox Classes="accountList" ItemsSource="{Binding AuthlibAccounts}"
                           SelectedItem="{Binding SelectedAuthlibAccount}"
                           IsVisible="{Binding IsAuthlibAccount}"
                           MaxHeight="200">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Server}" Classes="faint" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <StackPanel Spacing="6" IsVisible="{Binding IsOfflineAccount}">
                    <ListBox Classes="accountList" ItemsSource="{Binding OfflineRoles}"
                             SelectedItem="{Binding SelectedOfflineRole}"
                             MaxHeight="200" />
                    <TextBlock Text="重命名选中角色" Classes="faint" />
                    <TextBox Text="{Binding OfflineRoleName}" PlaceholderText="修改后立即生效" />
                  </StackPanel>
                  <Border Height="1" Background="{DynamicResource WmclDivider}" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Button Classes="secondary" Content="删除选中" HorizontalAlignment="Stretch"
                            IsVisible="{Binding IsMicrosoftAccount}" Click="OnDeleteMicrosoftAccountClick" />
                    <Button Classes="secondary" Content="删除选中" HorizontalAlignment="Stretch"
                            IsVisible="{Binding IsAuthlibAccount}" Click="OnDeleteAuthlibAccountClick" />
                    <Button Classes="secondary" Content="删除选中" HorizontalAlignment="Stretch"
                            IsVisible="{Binding IsOfflineAccount}" Click="OnDeleteOfflineRoleClick" />
                    <Button Grid.Column="1" Classes="taskAction" Content="{Binding AddAccountLabel}"
                            Click="OnAddAccountClick" />
                  </Grid>
                </StackPanel>
                </Border>
              </Popup>
          </StackPanel>
          <Button x:Name="MicrosoftReloginButton" Content="微软登录已失效，点此重新登录" Classes="secondary"
                  HorizontalAlignment="Stretch" Click="OnMicrosoftReloginClick"
                  IsVisible="{Binding MicrosoftLoginExpired}" />
            </StackPanel>
          </Border>
          </StackPanel>
          <ContentControl x:Name="LoginHost"
                          HorizontalAlignment="Stretch"
                          ClipToBounds="True"
                          IsVisible="False" />
        </Grid>

        <StackPanel Grid.Row="1" Spacing="7" Margin="0,10,0,0">
          <ProgressBar Value="{Binding Progress}"
                       Maximum="100"
                       IsVisible="{Binding IsBusy}" />
          <TextBlock Text="{Binding ProgressText}"
                     Classes="faint"
                     IsVisible="{Binding IsBusy}"
                     TextTrimming="CharacterEllipsis" />
          <Grid>
            <Button Classes="primary launchButton"
                    HorizontalAlignment="Stretch"
                    Padding="30,0,30,18"
                    Command="{Binding LaunchCommand}"
                    IsEnabled="{Binding CanLaunch}">
              <TextBlock Text="{Binding LaunchButtonText}"
                         FontSize="{DynamicResource WmclFontCta}"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center" />
            </Button>
            <TextBlock Text="{Binding LaunchButtonSubtitle}"
                       FontSize="{DynamicResource WmclFontFaint}"
                       Foreground="{DynamicResource WmclTextMuted}"
                       Margin="15,0,15,8"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       IsHitTestVisible="False"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding LaunchButtonSubtitle}" />
          </Grid>
          <Button Content="取消"
                  HorizontalAlignment="Stretch"
                  Command="{Binding CancelCommand}"
                  IsVisible="{Binding CanCancel}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="6" Margin="0,10,0,0">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
            <Button x:Name="VersionButton"
                    Content="版本选择"
                    HorizontalAlignment="Stretch"
                    Click="OnOpenVersionSelectClick" />
            <Button Grid.Column="1"
                    Content="设置"
                    Classes="secondary"
                    Command="{Binding OpenVersionSettingsCommand}"
                    IsEnabled="{Binding CanOpenVersionSettings}" />
          </Grid>
          <TextBlock Text="{Binding Status}"
                     Classes="faint"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

<ScrollViewer Classes="page" Grid.Column="1"
                   Margin="25,25,25,10">
      <StackPanel Classes="pageStack">
        <StackPanel Spacing="2" Margin="0,0,0,4">
          <TextBlock Classes="pageTitle" Text="启动" />
          <TextBlock Classes="pageSubtitle" Text="选择版本并启动游戏" />
        </StackPanel>
        <Border IsVisible="{Binding HasModpackLaunchError}"
                Background="{DynamicResource WmclWarningBackground}"
                BorderBrush="{DynamicResource WmclWarningBorder}"
                BorderThickness="1"
                CornerRadius="{DynamicResource WmclCornerCard}"
                Padding="12">
          <StackPanel Spacing="8">
            <TextBlock Text="整合包更新未完成" FontWeight="SemiBold"
                       Foreground="{DynamicResource WmclWarningText}" />
            <TextBlock Text="必须完成作者要求的更新后才能启动。"
                       TextWrapping="Wrap" Foreground="{DynamicResource WmclWarningText}" />
            <TextBlock Text="{Binding ModpackLaunchError}" TextWrapping="Wrap"
                       Foreground="{DynamicResource WmclWarningText}" />
            <Button Content="重试启动" Classes="secondary" HorizontalAlignment="Left"
                    Command="{Binding LaunchCommand}" IsEnabled="{Binding CanLaunch}" />
          </StackPanel>
        </Border>
        <Border IsVisible="{Binding HasGameFileCheckError}"
                Background="{DynamicResource WmclWarningBackground}"
                BorderBrush="{DynamicResource WmclWarningBorder}"
                BorderThickness="1"
                CornerRadius="{DynamicResource WmclCornerCard}"
                Padding="12">
          <StackPanel Spacing="8">
            <TextBlock Text="游戏文件校验未完成" FontWeight="SemiBold"
                       Foreground="{DynamicResource WmclWarningText}" />
            <TextBlock Text="缺失或损坏的文件尚未修复，已停止启动；请检查网络或下载源后重试。"
                       TextWrapping="Wrap" Foreground="{DynamicResource WmclWarningText}" />
            <TextBlock Text="{Binding GameFileCheckError}" TextWrapping="Wrap"
                       Foreground="{DynamicResource WmclWarningText}" />
            <Button Content="重试校验并启动" Classes="secondary" HorizontalAlignment="Left"
                    Command="{Binding LaunchCommand}" IsEnabled="{Binding CanLaunch}" />
          </StackPanel>
        </Border>
        <Border IsVisible="{Binding HasCrashReport}"
                Background="{DynamicResource WmclCrashBackground}"
                BorderBrush="{DynamicResource WmclCrashBorder}"
                BorderThickness="1"
                CornerRadius="{DynamicResource WmclCornerCard}"
                Padding="12">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding CrashTitle}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource WmclCrashTitle}" />
            <TextBlock Text="{Binding CrashDetails}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource WmclCrashText}" />
            <WrapPanel Orientation="Horizontal">
              <Button Content="保存报告" Classes="secondary" Command="{Binding SaveCrashReportCommand}" Margin="0,0,6,6" />
              <Button Content="诊断包" Classes="secondary" Command="{Binding SaveDiagnosticPackageCommand}" Margin="0,0,6,6" />
              <Button Content="崩溃报告" Classes="secondary" Command="{Binding OpenCrashReportCommand}" Margin="0,0,6,6" />
              <Button Content="打开日志" Classes="secondary" Command="{Binding OpenCrashLogCommand}" Margin="0,0,6,6" />
              <Button Content="日志目录" Classes="secondary" Command="{Binding OpenCrashLogFolderCommand}" Margin="0,0,6,6" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border x:Name="HomeNewsCard" Classes="card" IsVisible="{Binding IsHomeNewsVisible}">
          <StackPanel Spacing="8">
            <controls:WmclCardHeader Title="Minecraft 新闻">
              <controls:WmclCardHeader.Action>
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Button Content="刷新" Classes="secondary" Command="{Binding LoadHomeNewsCommand}" />
                  <Button Content="查看全部" Classes="secondary" Click="OnOpenNewsClick" />
                </StackPanel>
              </controls:WmclCardHeader.Action>
            </controls:WmclCardHeader>
            <ItemsControl x:Name="HomeNewsItemsControl" ItemsSource="{Binding HomeNewsDisplay}" IsVisible="{Binding HasHomeNews}"
                          HorizontalAlignment="Stretch">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <controls:ResponsiveNewsPanel MinItemWidth="360" ColumnSpacing="8" RowSpacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="homeNewsItem" Background="{DynamicResource WmclCard}" CornerRadius="{DynamicResource WmclCornerCard}" Padding="8"
                          HorizontalAlignment="Stretch" Cursor="Hand" ToolTip.Tip="{Binding Title}"
                          PointerReleased="OnHomeNewsClick">
                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.4*" MinWidth="72" MaxWidth="112" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Viewbox Classes="newsImageFrame" Stretch="Uniform" HorizontalAlignment="Stretch"
                               VerticalAlignment="Top" IsVisible="{Binding HasImage}">
                        <Border Width="160" Height="90" CornerRadius="{DynamicResource WmclCornerButton}" ClipToBounds="True"
                                Background="{DynamicResource WmclSidebar}">
                          <controls:RemoteImage Url="{Binding Image}" Stretch="UniformToFill" />
                        </Border>
                      </Viewbox>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Classes="newsTitle" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"
                                   ToolTip.Tip="{Binding Title}" />
                        <TextBlock Text="{Binding PublishDateText}" Classes="faint" />
                        <TextBlock Text="{Binding Description}" Classes="muted" FontSize="11"
                                   TextWrapping="Wrap" MaxHeight="30" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <controls:PclLoadingIndicator IsRunning="{Binding IsHomeNewsLoading}"
                                          IsVisible="{Binding IsHomeNewsLoading}"
                                          HorizontalAlignment="Left" />
            <Grid IsVisible="{Binding HomeNewsStatus, Converter={x:Static StringConverters.IsNullOrEmpty}}">
              <controls:WmclEmptyState Title="暂无新闻"
                                       Description="点击刷新获取 Minecraft 最新动态"
                                       IsVisible="{Binding !HasHomeNews}">
              <controls:WmclEmptyState.Action>
                <Button Classes="tertiary" Content="刷新新闻"
                        Command="{Binding LoadHomeNewsCommand}" />
              </controls:WmclEmptyState.Action>
              </controls:WmclEmptyState>
            </Grid>
            <TextBlock Text="{Binding HomeNewsStatus}" Classes="faint" TextWrapping="Wrap"
                       IsVisible="{Binding HomeNewsStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>

        <ContentControl Content="{Binding CustomHomePage}"
                        IsVisible="{Binding HasCustomHomePage}" />

        <Border Classes="card" IsVisible="{Binding HasLaunchLog}">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="启动日志" Classes="cardTitle" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="导出日志" Classes="secondary"
                      Command="{Binding ExportLogsCommand}" />
            </Grid>
            <Border Height="1" Background="{DynamicResource WmclBorder}" />
            <TextBox x:Name="LogBox"
                     Text="{Binding Log, Mode=OneWay}"
                     IsReadOnly="True"
                     Focusable="False"
                     IsTabStop="False"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     FontFamily="DejaVu Sans Mono, Noto Sans Mono, monospace"
                     FontSize="11"
                     Background="Transparent"
                     BorderThickness="0"
                     CornerRadius="0"
                     MinHeight="170"
                     MaxHeight="280"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            <TextBlock Text="{Binding LogExportStatus}" Classes="faint" TextWrapping="Wrap"
                       IsVisible="{Binding LogExportStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

