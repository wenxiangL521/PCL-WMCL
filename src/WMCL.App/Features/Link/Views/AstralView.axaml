<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WMCL.App.Controls"
             xmlns:motion="using:WMCL.App.Animation"
             x:Class="WMCL.App.Features.Link.AstralView"
             FontSize="{DynamicResource WmclFontBody}">
  <ScrollViewer Classes="page" x:Name="AstralScroll">
    <!-- 内容不足一屏时垂直居中：上下留白行吸收多余高度 -->
    <Grid RowDefinitions="*,Auto,*" MinHeight="{Binding #AstralScroll.Bounds.Height}">
    <StackPanel Grid.Row="1" Classes="pageStack" MaxWidth="520" HorizontalAlignment="Stretch">

      <!-- 已连接 -->
      <Border Classes="card" IsVisible="{Binding IsConnected}"
              motion:Motion.AnimateOnVisible="True">
        <StackPanel Classes="cardBody" Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="9" Height="9" Fill="{DynamicResource WmclSuccess}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ConnectedNetwork}" FontSize="{DynamicResource WmclFontTitle}" FontWeight="SemiBold" />
            <TextBlock Text="已连接" Classes="faint" VerticalAlignment="Center" />
          </StackPanel>
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
            <TextBlock Text="虚拟 IP" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding ConnectedIp}" FontSize="16" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="复制 IP" Classes="secondary" Command="{Binding CopyIpCommand}" />
            <Button Grid.Column="3" Content="离开房间" Command="{Binding LeaveCommand}" />
          </Grid>
          <StackPanel Spacing="6">
            <TextBlock Text="分享链接" Classes="cardTitle" Margin="0,4,0,0" />
            <TextBlock Text="短链（AstralGame 客户端可直接打开）" Classes="faint" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding ShareLink}" IsReadOnly="True" PlaceholderText="短链服务不可用，请使用下方长链" />
              <Button Grid.Column="1" Content="复制" Classes="secondary"
                      Command="{Binding CopyShortLinkCommand}" IsEnabled="{Binding IsConnected}" />
            </Grid>
            <TextBlock Text="长链（离线邀请，任何 Astral 客户端都能解析）" Classes="faint" Margin="0,6,0,0" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding LongShareLink}" IsReadOnly="True" PlaceholderText="创建房间后生成" />
              <Button Grid.Column="1" Content="复制" Classes="secondary"
                      Command="{Binding CopyLongLinkCommand}" />
            </Grid>
          </StackPanel>
          <TextBlock Text="房间成员" Classes="cardTitle" Margin="0,4,0,0" />
          <TextBlock Text="正在等待其他成员加入…" Classes="faint" IsVisible="{Binding !HasMembers}" />
          <ItemsControl ItemsSource="{Binding Members}" IsVisible="{Binding HasMembers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,120,80,80" ColumnSpacing="8" Margin="0,3">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding VirtualIp}" Classes="muted" />
                  <TextBlock Grid.Column="2" Text="{Binding Latency}" Classes="faint" />
                  <TextBlock Grid.Column="3" Text="{Binding Tunnel}" Classes="faint" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding Status}" Classes="faint" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- 首页：创建 / 加入 -->
      <StackPanel Spacing="10" IsVisible="{Binding ShowHome}" VerticalAlignment="Center"
                  motion:Motion.AnimateOnVisible="True">
        <Button Classes="roomCard" Command="{Binding ShowCreateCommand}" Padding="25,22,30,22"
                BorderThickness="1" BorderBrush="{DynamicResource WmclBlue5}"
                Background="{DynamicResource WmclBlue7}">
          <Grid ColumnDefinitions="26,*" ColumnSpacing="12">
            <Path Width="26" Height="26" VerticalAlignment="Top" Stretch="Uniform" Fill="{DynamicResource WmclBlue3}"
                  Data="M384 128v192h256a64 64 0 0 1 64 64v256h192V128H384zM320 320V128a64 64 0 0 1 64-64h512a64 64 0 0 1 64 64v512a64 64 0 0 1-64 64h-192v192a64 64 0 0 1-64 64H128a64 64 0 0 1-64-64V384a64 64 0 0 1 64-64h192z m320 384H384a64 64 0 0 1-64-64V384H128v512h512v-192z m0-64V384H384v256h256z" />
            <StackPanel Grid.Column="1" Spacing="10">
              <TextBlock Text="创建房间" FontSize="{DynamicResource WmclFontTitle}" FontWeight="SemiBold" Foreground="{DynamicResource WmclBlue2}" />
              <TextBlock Text="生成分享链接，邀请朋友加入你的网络。" FontSize="{DynamicResource WmclFontBody}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Button>
        <Button Classes="roomCard" Command="{Binding ShowJoinCommand}" Padding="25,22,30,22"
                BorderThickness="1" BorderBrush="{DynamicResource WmclDivider}"
                Background="{DynamicResource WmclCard}">
          <Grid ColumnDefinitions="26,*" ColumnSpacing="12">
            <Path Width="26" Height="26" VerticalAlignment="Top" Stretch="Uniform" Fill="{DynamicResource WmclBlue3}"
                  Data="m399,355l-92.5,101.6c-13.7,13.7-10.6,36.4,4.6,47c13.7,9.1,30.3,7.6,41-4.5l127.4-138.1c16.7-18.2,18.2-47,0-66.8l-125.9-141.1c-12.1-13.7-34.9-15.2-47,0c-12.1,12.1-12.1,31.9,0,44l92.5,98.6H28.8c-16.7,0-28.8,13.7-28.8,28.8s13.7,28.8,28.8,28.8h370.2v1.5ZM625.7,0H224.6c-44,0-78.9,34.9-78.9,78.9v101.6c0,15.2,12.1,27.3,27.3,27.3s27.3-12.1,27.3-27.3v-98.6c0-15.2,12.1-27.3,27.3-27.3h387.5c15.2,0,27.3,12.1,27.3,27.3v493c0,15.2-12.1,27.3-27.3,27.3H229.2c-15.2,0-27.3-12.1-27.3-27.3v-101.6c0-16.7-13.7-28.8-28.8-28.8s-28.8,13.7-28.8,28.8v98.6c0,44,34.9,78.9,78.9,78.9h407.2c44,0,67.9-34.9,67.9-78.9V78.9c-4.6-44-28.4-78.9-72.4-78.9Z" />
            <StackPanel Grid.Column="1" Spacing="10">
              <TextBlock Text="加入房间" FontSize="{DynamicResource WmclFontTitle}" FontWeight="SemiBold" Foreground="{DynamicResource WmclText}" />
              <TextBlock Text="粘贴邀请码添加房间，再选择加入。" FontSize="{DynamicResource WmclFontBody}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Button>
      </StackPanel>

      <!-- 创建房间 -->
      <Border Classes="card" IsVisible="{Binding ShowCreateForm}"
              motion:Motion.AnimateOnVisible="True">
        <StackPanel Classes="cardBody" Spacing="8">
          <controls:WmclCardHeader Title="创建房间" Subtitle="可自定义房间名、网络名与密钥，留空自动生成。" />
          <controls:WmclFormRow Label="房间名">
            <TextBox Text="{Binding NewRoomName}" PlaceholderText="我的房间" />
          </controls:WmclFormRow>
          <controls:WmclFormRow Label="是否保护">
            <CheckBox Theme="{StaticResource PclCheckBoxTheme}" IsChecked="{Binding IsProtectedRoom}"
                      Content="保护房间（自动生成房间号与密码）" />
          </controls:WmclFormRow>
          <controls:WmclFormRow Label="房间号" IsVisible="{Binding !IsProtectedRoom}">
            <TextBox Text="{Binding NewRoomNetwork}" PlaceholderText="留空自动生成 astral-xxxxxx" />
          </controls:WmclFormRow>
          <controls:WmclFormRow Label="房间密码" IsVisible="{Binding !IsProtectedRoom}">
            <TextBox Text="{Binding NewRoomSecret}" PlaceholderText="可留空，留空即无密码" />
          </controls:WmclFormRow>
          <controls:WmclFormRow Label="中转服务器">
            <StackPanel Spacing="4">
              <TextBlock Text="勾选本次房间携带的中转节点；都不勾选时使用公共中继。" Classes="faint" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding CreateRelays}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Theme="{StaticResource PclCheckBoxTheme}" IsChecked="{Binding IsSelected}"
                              Content="{Binding Display}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </controls:WmclFormRow>
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button Content="创建房间" Classes="primary" Command="{Binding CreateRoomCommand}" />
            <Button Content="返回" Classes="secondary" Command="{Binding GoHomeCommand}" />
          </WrapPanel>
          <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- 加入房间：房间列表在上，添加房间可展开 -->
      <StackPanel Spacing="10" IsVisible="{Binding ShowJoinPanel}"
                  motion:Motion.AnimateOnVisible="True">
        <Border Classes="card">
          <StackPanel Classes="cardBody" Spacing="8">
            <TextBlock Text="房间列表" Classes="cardTitle" />
            <TextBlock Text="加入过的房间会记在这里，点选后加入。" Classes="faint" TextWrapping="Wrap" />
            <TextBlock Text="还没有添加过房间。" Classes="faint" IsVisible="{Binding !HasRooms}" />
            <ListBox ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" MaxHeight="220"
                     IsVisible="{Binding HasRooms}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Summary}" Classes="faint" />
                      <TextBlock Text="{Binding TypeText, StringFormat='类型：{0}'}" Classes="faint" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding LastUsed, StringFormat='{}{0:MM-dd HH:mm}'}"
                               Classes="faint" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button Content="加入选中房间" Classes="primary" Command="{Binding JoinSelectedCommand}" />
              <Button Content="删除记录" Classes="secondary" Command="{Binding RemoveRoomCommand}" />
              <Button Content="返回" Classes="secondary" Command="{Binding GoHomeCommand}" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <Expander Theme="{StaticResource WmclTaskSectionTheme}" IsExpanded="False">
          <Expander.Header>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="添加房间" FontWeight="SemiBold" />
              <TextBlock Text="粘贴 Astral / Astral Game 邀请" Classes="faint" VerticalAlignment="Center" />
            </StackPanel>
          </Expander.Header>
          <StackPanel Spacing="8" Margin="12,0,12,12">
            <TextBox Text="{Binding InviteText}" AcceptsReturn="True" MinHeight="64" MaxHeight="96"
                     PlaceholderText="astral://room?code=… 或 AG1.…" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Preview}" Classes="faint" TextWrapping="Wrap"
                       IsVisible="{Binding Preview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <WrapPanel ItemSpacing="8">
              <Button Content="添加房间" Classes="primary" Command="{Binding AddRoomCommand}" />
              <Button Content="预览" Classes="secondary" Command="{Binding PreviewInviteCommand}" />
            </WrapPanel>
          </StackPanel>
        </Expander>
      </StackPanel>

    </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
