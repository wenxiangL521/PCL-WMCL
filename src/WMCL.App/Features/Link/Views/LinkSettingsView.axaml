<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WMCL.App.Controls"
             x:Class="WMCL.App.Features.Link.LinkSettingsView"
             FontSize="{DynamicResource WmclFontBody}">
  <ScrollViewer Classes="page">
    <StackPanel Classes="pageStack" DataContext="{Binding Connection}">
      <Border Classes="card">
        <StackPanel Classes="cardBody">
          <controls:WmclCardHeader Title="连接选项" Subtitle="选择联机后端与连接模式。" />
          <StackPanel Classes="form">
            <controls:WmclFormRow Label="联机方式">
              <ComboBox ItemsSource="{Binding Backends}" SelectedItem="{Binding SelectedBackend}"
                        HorizontalAlignment="Stretch" IsEnabled="{Binding IsIdle}" />
            </controls:WmclFormRow>
            <controls:WmclFormRow Label="模式" IsVisible="{Binding IsEasyTier}">
              <ComboBox ItemsSource="{Binding ConnectionModes}" SelectedItem="{Binding ConnectionMode}"
                        HorizontalAlignment="Stretch" IsEnabled="{Binding IsIdle}" />
            </controls:WmclFormRow>
          </StackPanel>
        </StackPanel>
      </Border>
      <Expander x:Name="AdvancedSettingsSection" Classes="cardSection" Header="高级设置" HorizontalAlignment="Stretch" IsExpanded="False">
        <StackPanel Classes="pageStack">
          <StackPanel IsVisible="{Binding IsEasyTier}" Classes="cardBody">
            <controls:WmclFormRow Label="自定义节点">
              <TextBox x:Name="PeerTextBox" Text="{Binding Peer}" IsEnabled="{Binding IsIdle}"
                       PlaceholderText="tcp://public.easytier.cn:11010" TextWrapping="Wrap" AcceptsReturn="True"
                       MinHeight="64" MaxHeight="120" VerticalContentAlignment="Top"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       ToolTip.Tip="房主和加入者必须连接至少一个相同节点；多个节点用逗号或换行分隔。" />
            </controls:WmclFormRow>
            <WrapPanel>
              <Button Classes="taskAction" Content="获取公共节点" Command="{Binding DiscoverNodesCommand}" Margin="0,0,12,8" />
              <Button Classes="taskAction" Content="测试节点" Command="{Binding TestPeersCommand}" Margin="0,0,12,8" />
              <Button Classes="taskAction" Content="自动选择节点" Command="{Binding AutoSelectPeerCommand}" Margin="0,0,0,8" />
            </WrapPanel>
            <TextBlock Text="{Binding PeerTestText}" Classes="faint" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel IsVisible="{Binding IsAstral}">
          <StackPanel Spacing="8" DataContext="{Binding Astral}">
            <TextBlock Text="Astral 设置" Classes="groupTitle" />
            <TextBlock Text="用户名" />
            <TextBox Text="{Binding Username}" PlaceholderText="默认跟随当前账号" />
            <WrapPanel ItemSpacing="8">
              <TextBlock Text="{Binding AccountNameHint}" Classes="faint" VerticalAlignment="Center" />
              <Button Classes="taskAction" Content="跟随账号名" Command="{Binding UseAccountNameCommand}" />
            </WrapPanel>
            <TextBlock Text="虚拟 IP（可选）" />
            <TextBox Text="{Binding VirtualIp}" PlaceholderText="如 10.126.126.5，留空自动分配" />
            <TextBlock Text="中转服务器" />
            <ListBox ItemsSource="{Binding Relays}" SelectedItem="{Binding SelectedRelay}" MaxHeight="140"
                     IsVisible="{Binding HasRelays}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Display}" />
                    <TextBlock Text="启用" Classes="faint" IsVisible="{Binding Enabled}" />
                    <TextBlock Text="禁用" Classes="faint" IsVisible="{Binding !Enabled}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding NewRelayUri}" PlaceholderText="tcp://host:port" />
              <TextBox Grid.Column="1" Text="{Binding NewRelayName}" PlaceholderText="备注（可选）" />
              <Button Grid.Column="2" Classes="taskAction" Content="添加" Command="{Binding AddRelayCommand}" />
              <Button Grid.Column="3" Classes="taskAction" Content="删除" Command="{Binding RemoveRelayCommand}" />
            </Grid>
            <WrapPanel ItemSpacing="8">
              <Button Classes="taskAction" Content="启用 / 禁用选中" Command="{Binding ToggleRelayCommand}" />
            </WrapPanel>
          </StackPanel>
          </StackPanel>
          <StackPanel IsVisible="{Binding IsTerracotta}" Spacing="8">
            <TextBlock Text="陶瓦可执行文件" />
            <TextBox x:Name="TerracottaPathTextBox" Text="{Binding TerracottaExecutablePath}" PlaceholderText="留空自动下载" IsEnabled="{Binding IsIdle}"
                     ToolTip.Tip="{Binding TerracottaExecutablePath}" TextWrapping="NoWrap"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden" />
            <Button Classes="taskAction" Content="选择文件" Click="OnChooseTerracottaClick" IsEnabled="{Binding IsIdle}" HorizontalAlignment="Left" />
            <TextBlock Text="陶瓦由 Terracotta 提供，与 EasyTier 手动房间使用不同的房间码。"
                       Classes="faint" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel IsVisible="{Binding IsEasyTier}" Spacing="8">
            <TextBlock Text="{Binding PublicIp}" Classes="faint" TextWrapping="Wrap" IsVisible="{Binding PublicIp, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding NatText}" Classes="faint" TextWrapping="Wrap" IsVisible="{Binding NatText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding PeerSummary}" Classes="faint" TextWrapping="Wrap" IsVisible="{Binding PeerSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="EasyTier 日志" Classes="faint" IsVisible="{Binding Log, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBox Text="{Binding Log}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="90" MaxHeight="220"
                     IsVisible="{Binding Log, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Focusable="False" IsTabStop="False" BorderThickness="0"
                     Background="{DynamicResource WmclLogBackground}" />
          </StackPanel>
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
