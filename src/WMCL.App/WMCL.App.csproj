<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup Label="Feature 命名空间">
    <Using Include="WMCL.App.ViewModels" />
    <Using Include="WMCL.App.Views" />
    <Using Include="WMCL.App.Features.Launch" />
    <Using Include="WMCL.App.Features.Link" />
    <Using Include="WMCL.App.Features.Instances" />
    <Using Include="WMCL.App.Features.Mods" />
    <Using Include="WMCL.App.Features.Settings" />
    <Using Include="WMCL.App.Features.Downloads" />
    <Using Include="WMCL.App.Features.Resources" />
    <Using Include="WMCL.App.Features.More" />
    <Using Include="WMCL.App.Features.Accounts" />
    <Using Include="WMCL.App.Features.Tasks" />
    <Using Include="WMCL.App.Features.Versions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Locales 仅作为 EmbeddedResource 打包（LocaleInstaller 运行时读取），
         从 AvaloniaResource 排除，避免同一文件被打包两次。 -->
    <AvaloniaResource Include="Assets/**" Exclude="Assets/Locales/*" />
    <EmbeddedResource Include="Assets/Locales/*.yaml" />
    <InternalsVisibleTo Include="WMCL.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WMCL.UI\WMCL.UI.csproj" />
    <ProjectReference Include="..\WMCL.Core\WMCL.Core.csproj" />
    <ProjectReference Include="..\WMCL.Link\WMCL.Link.csproj" />
    <ProjectReference Include="..\WMCL.Minecraft\WMCL.Minecraft.csproj" />
    <ProjectReference Include="..\WMCL.Download\WMCL.Download.csproj" />
    <ProjectReference Include="..\WMCL.Launch\WMCL.Launch.csproj" />
    <ProjectReference Include="..\WMCL.Modding\WMCL.Modding.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <!-- 覆盖 Avalonia 传递依赖的漏洞版本（GHSA-xrw6-gwf8-vvr9）。 -->
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.2.2</Version>
    <ApplicationIcon>Assets/wmcl-icon.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
