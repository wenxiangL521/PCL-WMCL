<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 浮层容器统一成卡片样式，避免默认灰色底 -->
  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource WmclCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclBlue6}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource WmclCornerCard}" />
    <Setter Property="Padding" Value="10" />
  </Style>
</Styles>
