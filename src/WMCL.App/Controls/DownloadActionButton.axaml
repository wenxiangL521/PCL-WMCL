<Button xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WMCL.App.Controls.DownloadActionButton"
        Classes="downloadAction" Height="52" MinWidth="0" MinHeight="0" Margin="20"
        Padding="0" BorderThickness="0" CornerRadius="20.8" Cursor="Hand"
        Foreground="{DynamicResource WmclBlue8}"
        FontSize="16" FontWeight="Normal" FocusAdorner="{x:Null}" Transitions="{x:Null}">
  <Button.Styles>
    <Style Selector="Button.downloadAction">
      <Setter Property="Background" Value="{DynamicResource WmclBlue3}" />
    </Style>
    <Style Selector="Button.downloadAction:pointerover">
      <Setter Property="Background" Value="{DynamicResource WmclBlue4}" />
    </Style>
    <Style Selector="Button.downloadAction:disabled">
      <Setter Property="Background" Value="{DynamicResource WmclTextFaint}" />
    </Style>
    <Style Selector="Button.downloadAction:focus-visible /template/ Border#FocusBorder">
      <Setter Property="BorderBrush" Value="{DynamicResource WmclBlue2}" />
    </Style>
  </Button.Styles>
  <Button.Template>
    <ControlTemplate>
      <Grid Name="ShowPanel" Background="Transparent" RenderTransformOrigin="50%,50%">
        <Grid Name="PressPanel" Margin="0,10,0,0" RenderTransformOrigin="50%,50%" IsHitTestVisible="False">
          <Border Name="ColorBorder" Background="{TemplateBinding Background}" CornerRadius="20.8"
                  BoxShadow="0 0 10 0 #33000000" />
          <StackPanel Orientation="Horizontal" Margin="20,0">
            <Path Name="DownloadIcon" Stretch="Uniform" Width="18" Height="18" Margin="2,12,0,12"
                  Fill="{TemplateBinding Foreground}" RenderTransformOrigin="50%,50%" RenderTransform="scale(0.95)"
                  Data="M955 610h-59c-15 0-29 13-29 29v196c0 15-13 29-29 29h-649c-15 0-29-13-29-29v-196c0-15-13-29-29-29h-59c-15 0-29 13-29 29V905c0 43 35 78 78 78h787c43 0 78-35 78-78V640c0-15-13-29-29-29zM492 740c11 11 29 11 41 0l265-265c11-11 11-29 0-41l-41-41c-11-11-29-11-41 0l-110 110c-11 11-33 3-33-13V68C571 53 555 39 541 39h-59c-15 0-29 13-29 29v417c0 17-21 25-33 13l-110-110c-11-11-29-11-41 0L226 433c-11 11-11 29 0 41L492 740z" />
            <TextBlock Name="ActionText" Text="{TemplateBinding Content}" FontSize="16"
                       Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"
                       Margin="12,0,0,0.8" />
          </StackPanel>
          <Border Name="FocusBorder" CornerRadius="20.8" BorderThickness="1" BorderBrush="Transparent" />
        </Grid>
      </Grid>
    </ControlTemplate>
  </Button.Template>
</Button>
