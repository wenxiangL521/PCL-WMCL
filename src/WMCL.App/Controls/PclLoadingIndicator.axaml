<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WMCL.App.Controls.PclLoadingIndicator"
             MinWidth="50" MinHeight="50">
  <Button Name="RetryButton" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0"
          HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
    <Button.Template>
      <ControlTemplate>
        <ContentPresenter Background="{TemplateBinding Background}" Content="{TemplateBinding Content}" />
      </ControlTemplate>
    </Button.Template>
    <StackPanel>
      <Grid Width="60" Height="47" HorizontalAlignment="Center">
        <Path Name="Pickaxe" Stretch="Uniform" Height="35" Margin="10,6,0,0" StrokeThickness="2"
              HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="30,30"
              Data="M 963.6 858.2 410.816 305.504 C 508.116 213.304 609.204 196.8 711.104 128.6 837.11367 49.573762 879.34045 50.334062 751.5 49.5 611.3 52 471.8 96.2 353.3 182.4 309.8 155.7 252.1 161.2 214.5 198.9 176.9 236.6 171.3 294.2 198 337.7 111.8 456.3 67.6 595.8 65.1 735.9 63.315254 883.82034 65.077966 837.29308 144.2 695.488 212.4 593.588 228.888 492.4 321.088 395.2 L 873.9 948 c 0.60001 0.59999 1.6 0.6 2.2 0 l 87.5 -87.5 c 0.6 -0.7 0.6 -1.6 0 -2.3 z" />
        <Path Name="LeftFragment" Width="3" Height="5" Margin="7,41,0,0" Opacity="0" Stretch="Uniform"
              Data="M0,0L2,0L1,4" RenderTransformOrigin="50%,50%" HorizontalAlignment="Left" VerticalAlignment="Top">
          <Path.RenderTransform><RotateTransform Angle="-45" /></Path.RenderTransform>
        </Path>
        <Path Name="RightFragment" Width="3" Height="5" Margin="14,41,0,0" Opacity="0" Stretch="Uniform"
              Data="M0,0L2,0L1,4" RenderTransformOrigin="50%,50%" HorizontalAlignment="Left" VerticalAlignment="Top">
          <Path.RenderTransform><RotateTransform Angle="45" /></Path.RenderTransform>
        </Path>
        <Path Name="ErrorIcon" Width="17" Height="17" Margin="4,23,0,0" Stretch="Uniform" Opacity="0"
              RenderTransformOrigin="50%,50%"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              Data="F1 M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z" />
        <Rectangle Name="Ground" Width="25" Height="2" VerticalAlignment="Bottom" HorizontalAlignment="Left" />
      </Grid>
      <TextBlock Name="LoadingText" FontSize="16" Margin="0,10,0,0" TextWrapping="Wrap"
                 HorizontalAlignment="Center" TextAlignment="Center" />
    </StackPanel>
  </Button>
</UserControl>
