<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WMCL.App.Controls.MyHint">
  <UserControl.Template>
    <ControlTemplate>
      <Border x:Name="PART_Border" Classes="hint">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <ContentPresenter x:Name="PART_Content" Content="{TemplateBinding Content}" />
          <ContentPresenter x:Name="PART_Action" Grid.Column="1" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </ControlTemplate>
  </UserControl.Template>
</UserControl>
