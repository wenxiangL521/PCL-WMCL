<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WMCL.App.Controls.InstalledVersionCard">
  <UserControl.Styles>
    <Style Selector="Button.versionHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="15,0,16,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource WmclBlue1}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="0:0:0.09" />
        </Transitions>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
            <ContentPresenter Content="{TemplateBinding Content}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.versionHeader:pointerover, Button.versionHeader:focus-visible">
      <Setter Property="Foreground" Value="{DynamicResource WmclBlue2}" />
    </Style>
    <Style Selector="ListBox.versionList">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="20,0,18,18" />
    </Style>
    <Style Selector="ListBox.versionList ListBoxItem">
      <Setter Property="Height" Value="42" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.versionRowAction">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="MaxWidth" Value="30" />
      <Setter Property="MaxHeight" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Background="Transparent"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              Padding="0"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              RenderTransformOrigin="50%,50%" />
          </Border>        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="StackPanel.rowActions">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.072" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem:pointerover StackPanel.rowActions, ListBoxItem:focus-within StackPanel.rowActions">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
        </Transitions>
      </Setter>
    </Style>
  </UserControl.Styles>

  <Border Classes="card" Padding="0">
    <StackPanel>
      <Button x:Name="HeaderButton" Classes="versionHeader"
              Command="{Binding ToggleCommand}"
              AutomationProperties.Name="{Binding DisplayTitle}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding DisplayTitle}" FontSize="13" FontWeight="Bold"
                     Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
          <Path x:Name="Chevron" Grid.Column="1" Width="10" Height="6"
                Data="M2,4 l-2,2 10,10 10,-10 -2,-2 -8,8 -8,-8 z"
                Fill="{Binding $parent[Button].Foreground}" Stretch="Uniform"
                RenderTransformOrigin="50%,50%" VerticalAlignment="Center" />
        </Grid>
      </Button>

      <Border x:Name="ContentClip" Height="0" ClipToBounds="True">
        <ListBox x:Name="VersionList" Classes="versionList"
                 SelectionMode="Single"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid x:Name="VersionRowLayout" ColumnDefinitions="2,38,*,111" Height="42" ClipToBounds="True">
                <Image Grid.Column="1" Source="{Binding IconImage}" Margin="4,5,3,5" Stretch="Fill" />
                <StackPanel Grid.Column="2" Margin="4,0,8,2" VerticalAlignment="Center" ClipToBounds="True">
                  <Grid ColumnDefinitions="*,Auto" ClipToBounds="True">
                    <TextBlock Text="{Binding Id}" FontSize="13" FontWeight="Medium"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding TitleSuffix}" FontSize="12" Opacity="0.6" MaxWidth="120"
                               TextTrimming="CharacterEllipsis" />
                  </Grid>
                  <TextBlock Text="{Binding InfoText}" FontSize="12" Opacity="0.6"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="3" Classes="rowActions" Orientation="Horizontal"
                            Width="102" Height="30" Spacing="6"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0,5,0">
                  <Button Classes="rowAction iconButton versionRowAction favorite" Click="OnFavoriteClick"
                          AutomationProperties.Name="{Binding FavoriteTooltip}" ToolTip.Tip="{Binding FavoriteTooltip}">
                    <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Path Data="M8 14.2 C8 14.2 1.8 10.5 1.8 5.9 C1.8 3.5 3.6 1.8 5.8 1.8 C6.9 1.8 7.7 2.3 8 3.0 C8.3 2.3 9.1 1.8 10.2 1.8 C12.4 1.8 14.2 3.5 14.2 5.9 C14.2 10.5 8 14.2 8 14.2 Z"
                            Fill="Transparent" Stroke="{DynamicResource WmclTextMuted}"
                            StrokeThickness="1.2" IsVisible="{Binding !IsFavorite}" />
                      <Path Data="M8 14.2 C8 14.2 1.8 10.5 1.8 5.9 C1.8 3.5 3.6 1.8 5.8 1.8 C6.9 1.8 7.7 2.3 8 3.0 C8.3 2.3 9.1 1.8 10.2 1.8 C12.4 1.8 14.2 3.5 14.2 5.9 C14.2 10.5 8 14.2 8 14.2 Z"
                            Fill="{DynamicResource WmclBlue2}" IsVisible="{Binding IsFavorite}" />
                    </Grid>
                  </Button>
                  <Button Classes="rowAction iconButton versionRowAction" Click="OnSettingsClick" ToolTip.Tip="版本设置"
                          IsVisible="{Binding !IsErrorVersion}">
                    <Path Data="{StaticResource WmclIconGear}" Width="16" Height="16" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Button>
                  <Button Classes="rowAction iconButton versionRowAction" Click="OnOpenFolderClick" ToolTip.Tip="打开版本目录"
                          IsVisible="{Binding IsErrorVersion}">
                    <Path Data="{StaticResource WmclIconFolderOpen}" Width="16" Height="16" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Button>
                  <Button Classes="rowAction iconButton versionRowAction" ToolTip.Tip="版本操作"
                          AutomationProperties.Name="版本操作">
                    <Path Data="{StaticResource WmclIconMore}" Width="16" Height="16" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Button.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="版本设置" Tag="{Binding}" Click="OnMenuSettingsClick" />
                        <MenuItem Header="打开版本目录" Tag="{Binding}" Click="OnMenuOpenClick" />
                        <MenuItem Header="隐藏/显示版本" Tag="{Binding}" Click="OnMenuHideClick" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
