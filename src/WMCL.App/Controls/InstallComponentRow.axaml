<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WMCL.App.Controls"
             xmlns:vm="clr-namespace:WMCL.App.ViewModels"
             x:Class="WMCL.App.Controls.InstallComponentRow" Height="42">
  <UserControl.Styles>
    <Style Selector="controls|InstallComponentRow:pointerover Button#SelectButton, controls|InstallComponentRow:focus-within Button#SelectButton">
      <Setter Property="Background" Value="{DynamicResource WmclEntryHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WmclBlue6}" />
    </Style>
    <Style Selector="controls|ComponentActionButton">
      <Setter Property="Width" Value="25" />
      <Setter Property="Height" Value="25" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource WmclBlue4}" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PressPanel" RenderTransformOrigin="50%,50%" Background="Transparent">
            <Path Name="Icon" Data="{Binding Icon}" Margin="5" Stretch="Uniform" Fill="{TemplateBinding Foreground}"
                  RenderTransformOrigin="50%,50%">
              <Path.RenderTransform>
                <ScaleTransform ScaleX="{Binding IconScale}" ScaleY="{Binding IconScale}" />
              </Path.RenderTransform>
            </Path>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="controls|ComponentActionButton:pointerover, controls|ComponentActionButton:focus-visible">
      <Setter Property="Foreground" Value="{DynamicResource WmclBlue2}" />
    </Style>
    <Style Selector="controls|ComponentActionButton:disabled">
      <Setter Property="Foreground" Value="{DynamicResource WmclTextMuted}" />
    </Style>
  </UserControl.Styles>
  <Grid>
    <Button Name="SelectButton" Classes="componentEntry" Command="{Binding SelectCommand}"
            AutomationProperties.Name="{Binding Title}">
      <Grid Name="TextLayout" ColumnDefinitions="2,38,*,4">
        <Image Grid.Column="1" Source="{Binding IconImage}" Margin="4,5,3,5" Stretch="Fill" />
        <StackPanel Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontSize="14" Margin="0,0,0,2" TextTrimming="CharacterEllipsis"
                     Foreground="{Binding $parent[Button].Foreground}" />
          <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Foreground="{Binding $parent[Button].Foreground}" />
        </StackPanel>
      </Grid>
    </Button>
    <ItemsControl Name="Actions" ItemsSource="{Binding Actions}" Margin="0,0,5,0" Opacity="0"
                  HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="vm:InstallComponentAction">
          <controls:ComponentActionButton Command="{Binding Command}" ToolTip.Tip="{Binding Title}"
                                          AutomationProperties.Name="{Binding Title}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
