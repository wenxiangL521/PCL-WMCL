<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WMCL.App.Controls.InstallMinecraftCard">
  <UserControl.Styles>
    <Style Selector="Button.minecraftHeader">
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="15,0,16,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource WmclBlue1}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
            <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.minecraftHeader:pointerover, Button.minecraftHeader:focus-visible">
      <Setter Property="Foreground" Value="{DynamicResource WmclBlue2}" />
    </Style>
    <Style Selector="Button.minecraftHeader:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource WmclBlue3}" />
    </Style>
    <Style Selector="Button.minecraftRestore">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="6.75" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    <Style Selector="Button.minecraftRestore:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource WmclBlue2}" />
    </Style>
  </UserControl.Styles>
  <Border Classes="card" Padding="0">
    <Grid Height="40">
      <Button Name="HeaderButton" Classes="minecraftHeader" Command="{Binding OpenVersionCatalogCommand}"
              AutomationProperties.Name="选择 Minecraft 版本">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Minecraft" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                     Foreground="{Binding $parent[Button].Foreground}" />
          <Path Grid.Column="1" Width="10" Height="6" Stretch="Uniform"
                Data="M2,4 l-2,2 10,10 10,-10 -2,-2 -8,8 -8,-8 z"
                Fill="{Binding $parent[Button].Foreground}" RenderTransformOrigin="50%,50%">
            <Path.RenderTransform><RotateTransform Angle="270" /></Path.RenderTransform>
          </Path>
        </Grid>
      </Button>
      <Grid Name="SummaryPanel" ColumnDefinitions="Auto,*" Height="18" Margin="132,11,35,0"
            VerticalAlignment="Top" IsHitTestVisible="False" IsVisible="{Binding ShowMinecraftSummary}">
        <Image Source="{Binding MinecraftIcon}" Width="18" Height="18" Margin="0,0,7,0" />
        <TextBlock Grid.Column="1" Text="{Binding MinecraftVersionText}" FontSize="13"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </Grid>
      <Grid Name="ComparisonPanel" ColumnDefinitions="180,Auto,*" Height="18" Margin="132,11,80,0"
            VerticalAlignment="Top" IsHitTestVisible="False" IsVisible="{Binding HasMinecraftComparison}">
        <StackPanel Orientation="Horizontal">
          <Image Source="{Binding OriginalMinecraftIcon}" Width="18" Height="18" Margin="0,0,7,0" />
          <TextBlock Text="{Binding OriginalMinecraftVersionText}" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>
        <Path Grid.Column="1" Data="M3,3 L7,7 3,11 M9,3 L13,7 9,11" Margin="10,0,18,0" Height="14"
              HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource WmclTextMuted}"
              StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" />
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Image Source="{Binding MinecraftIcon}" Width="18" Height="18" Margin="0,0,7,0" />
          <TextBlock Text="{Binding MinecraftVersionText}" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
      <Button Name="RestoreButton" Classes="minecraftRestore" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,5,32,0" IsVisible="{Binding HasMinecraftComparison}" Command="{Binding RestoreMinecraftCommand}"
              Click="OnRestoreClick" ToolTip.Tip="{Binding MinecraftRestoreHint}" AutomationProperties.Name="撤销 Minecraft 更改">
        <Path Data="M9.83,3.17 A1.18,1.18 0 0 1 9.83,4.83 L6.85,7.82 H14.5 A6.68,6.68 0 0 1 14.5,21.18 H11 A1.18,1.18 0 0 1 11,18.82 H14.5 A4.32,4.32 0 0 0 14.5,10.18 H6.85 L9.83,13.17 A1.18,1.18 0 0 1 8.17,14.83 L3.17,9.83 A1.18,1.18 0 0 1 3.17,8.17 L8.17,3.17 A1.18,1.18 0 0 1 9.83,3.17Z"
              Fill="{Binding $parent[Button].Foreground}" Width="16.5" Height="16.5" Stretch="Uniform" />
      </Button>
    </Grid>
  </Border>
</UserControl>
