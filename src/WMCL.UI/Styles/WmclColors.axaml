<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="WmclBlue1" Color="#343D4A" />
      <SolidColorBrush x:Key="WmclBlue2" Color="#0B5BCB" />
      <SolidColorBrush x:Key="WmclBlue3" Color="#1370F3" />
      <SolidColorBrush x:Key="WmclBlue4" Color="#4890F5" />
      <SolidColorBrush x:Key="WmclBlue5" Color="#96C0F9" />
      <SolidColorBrush x:Key="WmclBlue6" Color="#D5E6FD" />
      <SolidColorBrush x:Key="WmclBlue7" Color="#E0EAFD" />
      <SolidColorBrush x:Key="WmclBlue8" Color="#EAF2FE" />
      <SolidColorBrush x:Key="WmclEntryHover" Color="#BEE0EAFD" />

      <SolidColorBrush x:Key="WmclText" Color="#343D4A" />
      <SolidColorBrush x:Key="WmclTaskAccent" Color="#0B5BCB" />
      <SolidColorBrush x:Key="WmclTextMuted" Color="#737373" />
      <SolidColorBrush x:Key="WmclTextFaint" Color="#8C8C8C" />
      <!-- PCL2 灰阶 6~8 + 语义色（二期 A1-4） -->
      <SolidColorBrush x:Key="WmclGray6" Color="#EBEBEB" />
      <SolidColorBrush x:Key="WmclGray7" Color="#F0F0F0" />
      <SolidColorBrush x:Key="WmclGray8" Color="#F5F5F5" />
      <SolidColorBrush x:Key="WmclSuccess" Color="#2E7D32" />
      <SolidColorBrush x:Key="WmclPageFlat" Color="#F5F5F5" />
      <!-- 灰阶（PCL2 五级：Strong 正文 / Disabled 禁用 / Divider 分隔线） -->
      <SolidColorBrush x:Key="WmclTextStrong" Color="#404040" />
      <SolidColorBrush x:Key="WmclTextDisabled" Color="#A6A6A6" />
      <SolidColorBrush x:Key="WmclDivider" Color="#CCCCCC" />
      <!-- 半透明叠层（顶栏胶囊 / 标题文字 / 任务球进度） -->
      <SolidColorBrush x:Key="WmclOverlayButtonBase" Color="#55FFFFFF" />
      <SolidColorBrush x:Key="WmclOverlayCapsule" Color="#22FFFFFF" />
      <SolidColorBrush x:Key="WmclOverlayCapsuleHover" Color="#33FFFFFF" />
      <SolidColorBrush x:Key="WmclOverlayTitleText" Color="#F2FFFFFF" />
      <SolidColorBrush x:Key="WmclOverlayTaskProgress" Color="#2FFFFFFF" />
      <!-- 阴影档位（卡片 / 任务球 / 窗口 / 轻提示） -->
      <SolidColorBrush x:Key="WmclShadowCard" Color="#22343D4A" />
      <SolidColorBrush x:Key="WmclShadowTaskBall" Color="#33000000" />
      <SolidColorBrush x:Key="WmclShadowWindow" Color="#44000000" />
      <SolidColorBrush x:Key="WmclShadowTooltip" Color="#14343D4A" />
      <!-- 标题栏关闭按钮悬停红 -->
      <SolidColorBrush x:Key="WmclTitleCloseHover" Color="#E04444" />
      <!-- 控件（滚动条滑块 / Slider 圆钮） -->
      <SolidColorBrush x:Key="WmclScrollbarThumb" Color="#B4BCC8" />
      <SolidColorBrush x:Key="WmclScrollbarThumbHover" Color="#8A93A2" />
      <SolidColorBrush x:Key="WmclSliderThumb" Color="#FFFFFF" />
      <SolidColorBrush x:Key="WmclBorder" Color="#D5E6FD" />
      <SolidColorBrush x:Key="WmclCard" Color="#F5FFFFFF" />
      <LinearGradientBrush x:Key="WmclPage" StartPoint="90%,0%" EndPoint="10%,100%">
        <GradientStop Color="#D8F0F8" Offset="0" />
        <GradientStop Color="#D8E8F8" Offset="0.5" />
        <GradientStop Color="#D8E0F8" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="WmclTitleGradient" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Color="#127AE2" Offset="0" />
        <GradientStop Color="#268AED" Offset="0.5" />
        <GradientStop Color="#127AE2" Offset="1" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="WmclSidebar" Color="#F1FFFFFF" />
      <SolidColorBrush x:Key="WmclInput" Color="#FFFFFF" />
      <SolidColorBrush x:Key="WmclLogBackground" Color="#F8FAFF" />
      <SolidColorBrush x:Key="WmclDanger" Color="#D64545" />
      <SolidColorBrush x:Key="WmclErrorBackground" Color="#FFDDDF" />
      <SolidColorBrush x:Key="WmclErrorBorder" Color="#D82929" />
      <SolidColorBrush x:Key="WmclErrorText" Color="#BF0B0B" />
      <SolidColorBrush x:Key="WmclWarningBackground" Color="#FFEBD7" />
      <SolidColorBrush x:Key="WmclWarningBorder" Color="#F57A00" />
      <SolidColorBrush x:Key="WmclWarningText" Color="#A85000" />

      <SolidColorBrush x:Key="WmclCrashBackground" Color="#FFF1F0" />
      <SolidColorBrush x:Key="WmclCrashBorder" Color="#F3B5B5" />
      <SolidColorBrush x:Key="WmclCrashText" Color="#7A271A" />
      <SolidColorBrush x:Key="WmclCrashTitle" Color="#B42318" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="WmclBlue1" Color="#D8DCE5" />
      <SolidColorBrush x:Key="WmclBlue2" Color="#7DB2FF" />
      <SolidColorBrush x:Key="WmclBlue3" Color="#3B82F6" />
      <SolidColorBrush x:Key="WmclBlue4" Color="#60A5FA" />
      <SolidColorBrush x:Key="WmclBlue5" Color="#93C5FD" />
      <SolidColorBrush x:Key="WmclBlue6" Color="#2C3B52" />
      <SolidColorBrush x:Key="WmclBlue7" Color="#263345" />
      <SolidColorBrush x:Key="WmclBlue8" Color="#202A38" />
      <SolidColorBrush x:Key="WmclEntryHover" Color="#BE263345" />

      <SolidColorBrush x:Key="WmclText" Color="#E7E9EE" />
      <SolidColorBrush x:Key="WmclTaskAccent" Color="#7DB2FF" />
      <SolidColorBrush x:Key="WmclTextMuted" Color="#A9ADB8" />
      <SolidColorBrush x:Key="WmclTextFaint" Color="#818692" />
      <!-- PCL2 灰阶 6~8 + 语义色（暗色适配，二期 A1-4） -->
      <SolidColorBrush x:Key="WmclGray6" Color="#2A2D33" />
      <SolidColorBrush x:Key="WmclGray7" Color="#26292F" />
      <SolidColorBrush x:Key="WmclGray8" Color="#212429" />
      <SolidColorBrush x:Key="WmclSuccess" Color="#4ADE80" />
      <SolidColorBrush x:Key="WmclPageFlat" Color="#212429" />
      <!-- 灰阶（PCL2 五级，暗色适配） -->
      <SolidColorBrush x:Key="WmclTextStrong" Color="#E7E9EE" />
      <SolidColorBrush x:Key="WmclTextDisabled" Color="#6B7078" />
      <SolidColorBrush x:Key="WmclDivider" Color="#3A3E46" />
      <!-- 半透明叠层（暗色：白叠层映射半透明黑；标题文字保持高 alpha 白） -->
      <SolidColorBrush x:Key="WmclOverlayButtonBase" Color="#55000000" />
      <SolidColorBrush x:Key="WmclOverlayCapsule" Color="#22000000" />
      <SolidColorBrush x:Key="WmclOverlayCapsuleHover" Color="#33000000" />
      <SolidColorBrush x:Key="WmclOverlayTitleText" Color="#F2FFFFFF" />
      <SolidColorBrush x:Key="WmclOverlayTaskProgress" Color="#2FFFFFFF" />
      <!-- 阴影档位（暗色同为黑系） -->
      <SolidColorBrush x:Key="WmclShadowCard" Color="#22343D4A" />
      <SolidColorBrush x:Key="WmclShadowTaskBall" Color="#33000000" />
      <SolidColorBrush x:Key="WmclShadowWindow" Color="#44000000" />
      <SolidColorBrush x:Key="WmclShadowTooltip" Color="#14343D4A" />
      <!-- 标题栏关闭按钮悬停红（暗色适配红） -->
      <SolidColorBrush x:Key="WmclTitleCloseHover" Color="#C0392B" />
      <!-- 控件（滚动条滑块 / Slider 圆钮，暗色适配） -->
      <SolidColorBrush x:Key="WmclScrollbarThumb" Color="#4E5666" />
      <SolidColorBrush x:Key="WmclScrollbarThumbHover" Color="#626C80" />
      <SolidColorBrush x:Key="WmclSliderThumb" Color="#E7E9EE" />
      <SolidColorBrush x:Key="WmclBorder" Color="#353941" />
      <SolidColorBrush x:Key="WmclCard" Color="#202226" />
      <LinearGradientBrush x:Key="WmclPage" StartPoint="90%,0%" EndPoint="10%,100%">
        <GradientStop Color="#09262F" Offset="0" />
        <GradientStop Color="#0B2138" Offset="0.5" />
        <GradientStop Color="#0C1940" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="WmclTitleGradient" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Color="#106BC6" Offset="0" />
        <GradientStop Color="#127AE2" Offset="0.5" />
        <GradientStop Color="#106BC6" Offset="1" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="WmclSidebar" Color="#1B1D21" />
      <SolidColorBrush x:Key="WmclInput" Color="#2A2D33" />
      <SolidColorBrush x:Key="WmclLogBackground" Color="#16171A" />
      <SolidColorBrush x:Key="WmclDanger" Color="#F87171" />
      <SolidColorBrush x:Key="WmclErrorBackground" Color="#3A2323" />
      <SolidColorBrush x:Key="WmclErrorBorder" Color="#D82929" />
      <SolidColorBrush x:Key="WmclErrorText" Color="#FCA5A5" />
      <SolidColorBrush x:Key="WmclWarningBackground" Color="#392B20" />
      <SolidColorBrush x:Key="WmclWarningBorder" Color="#F5A04B" />
      <SolidColorBrush x:Key="WmclWarningText" Color="#FFC78F" />

      <SolidColorBrush x:Key="WmclCrashBackground" Color="#3A2323" />
      <SolidColorBrush x:Key="WmclCrashBorder" Color="#7F3B3B" />
      <SolidColorBrush x:Key="WmclCrashText" Color="#FCA5A5" />
      <SolidColorBrush x:Key="WmclCrashTitle" Color="#F87171" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- 卡片阴影双档（PCL2 基线：静止半径 3、可点击 hover 抬升半径 6） -->
  <BoxShadows x:Key="WmclCardShadowBox">0 0 3 0 #12343D4A</BoxShadows>
  <BoxShadows x:Key="WmclCardShadowHoverBox">0 1 6 0 #66343D4A</BoxShadows>
  <BoxShadows x:Key="WmclTaskBallShadowBox">0 0 10 0 #33000000</BoxShadows>
  <BoxShadows x:Key="WmclWindowShadowBox">0 2 8 0 #44000000</BoxShadows>
  <BoxShadows x:Key="WmclTooltipShadowBox">0 1 4 0 #14343D4A</BoxShadows>
  <!-- 主窗口圆角（PCL2 规格 8px，主题无关） -->
  <CornerRadius x:Key="WmclWindowCorner">8</CornerRadius>
  <!-- 滑块向 PCL 看齐：10~12px 圆形拇指、更窄的上下留白（轨道高度由 Fluent 保持 2px） -->
  <x:Double x:Key="SliderHorizontalThumbWidth">12</x:Double>
  <x:Double x:Key="SliderHorizontalThumbHeight">12</x:Double>
  <x:Double x:Key="SliderVerticalThumbWidth">12</x:Double>
  <x:Double x:Key="SliderVerticalThumbHeight">12</x:Double>
  <x:Double x:Key="SliderHorizontalHeight">20</x:Double>
  <GridLength x:Key="SliderPreContentMargin">8</GridLength>
  <GridLength x:Key="SliderPostContentMargin">8</GridLength>
  <CornerRadius x:Key="SliderThumbCornerRadius">6</CornerRadius>
  <!-- 滚动条宽度向 PCL 的 8px 细条看齐；箭头按钮在样式中隐藏 -->
  <x:Double x:Key="ScrollBarSize">8</x:Double>
  <!-- 自定义成就提示图（Minecraft 深色 toast，明暗主题一致） -->
  <SolidColorBrush x:Key="WmclAchievementBack" Color="#212121" />
  <SolidColorBrush x:Key="WmclAchievementBorder" Color="#555555" />
  <SolidColorBrush x:Key="WmclAchievementSlot" Color="#3A3A3A" />
  <SolidColorBrush x:Key="WmclAchievementSlotBorder" Color="#777777" />
  <SolidColorBrush x:Key="WmclAchievementTitle" Color="#FFD84D" />
  <SolidColorBrush x:Key="WmclAchievementText" Color="#E8E8E8" />
</ResourceDictionary>
