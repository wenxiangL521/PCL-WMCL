<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- PCL 风格复选框：细边框、无默认间距 -->
      <ControlTheme x:Key="PclCheckBoxTheme" TargetType="CheckBox">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="FontSize" Value="{DynamicResource WmclFontBody}" />
        <Setter Property="Foreground" Value="{DynamicResource WmclText}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate>
              <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                <Border x:Name="CheckBoxBorder"
                        Width="18" Height="18"
                        CornerRadius="{DynamicResource WmclCornerButton}"
                        BorderThickness="1.1"
                        BorderBrush="{DynamicResource WmclText}"
                        Background="{DynamicResource WmclOverlayButtonBase}"
                        VerticalAlignment="Center"
                        RenderTransformOrigin="50%,50%">
                  <Border.Transitions>
                    <Transitions>
                      <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
                    </Transitions>
                  </Border.Transitions>
                  <Path x:Name="CheckBoxCheck"
                        Data="M0,6L1.5,4.5 4.5,7.5 10.5,1.5 12,3 4.5,10.5 0,6z"
                        Width="12" Height="12"
                        Stretch="Uniform"
                        Fill="{DynamicResource WmclBlue2}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0"
                        RenderTransformOrigin="50%,50%">
                    <Path.Transitions>
                      <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                        <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
                      </Transitions>
                    </Path.Transitions>
                  </Path>
                </Border>
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Grid.Column="1"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style Selector="^:checked /template/ Border#CheckBoxBorder">
          <Setter Property="BorderBrush" Value="{DynamicResource WmclBlue2}" />
        </Style>
        <Style Selector="^ /template/ Path#CheckBoxCheck">
          <Setter Property="RenderTransform" Value="scale(0.4)" />
        </Style>
        <Style Selector="^:checked /template/ Path#CheckBoxCheck">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="^:pressed /template/ Border#CheckBoxBorder">
          <Setter Property="RenderTransform" Value="scale(0.86)" />
        </Style>
        <Style Selector="^:checked:pressed /template/ Border#CheckBoxBorder">
          <Setter Property="BorderBrush" Value="{DynamicResource WmclBlue1}" />
        </Style>
      </ControlTheme>
</ResourceDictionary>
