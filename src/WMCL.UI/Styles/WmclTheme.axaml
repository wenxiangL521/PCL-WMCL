<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource WmclUiFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource WmclFontBody}" />
    <Setter Property="Background" Value="{DynamicResource WmclPage}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WmclText}" />
  </Style>

  <!-- h1/h2 保留弹窗标题语义（D1 裁决）；页面/分组标题由 pageTitle/groupTitle 承接。 -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="{DynamicResource WmclFontDialogTitle}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource WmclBlue2}" />
  </Style>

  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="{DynamicResource WmclFontTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource WmclText}" />
  </Style>

  <Style Selector="TextBlock.pageSubtitle">
    <Setter Property="FontSize" Value="{DynamicResource WmclFontCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource WmclTextMuted}" />
  </Style>

  <Style Selector="TextBlock.groupTitle">
    <Setter Property="FontSize" Value="{DynamicResource WmclFontCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource WmclTextMuted}" />
  </Style>

  <Style Selector="TextBlock.cardTitle">
    <Setter Property="FontSize" Value="{DynamicResource WmclFontBody}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource WmclText}" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="{DynamicResource WmclFontTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="{DynamicResource WmclFontCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource WmclTextMuted}" />
  </Style>

  <Style Selector="TextBlock.faint">
    <Setter Property="FontSize" Value="{DynamicResource WmclFontFaint}" />
    <Setter Property="Foreground" Value="{DynamicResource WmclTextFaint}" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="DejaVu Sans Mono, Noto Sans Mono, monospace" />
    <Setter Property="FontSize" Value="{DynamicResource WmclFontFaint}" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource WmclCard}" />
    <Setter Property="CornerRadius" Value="{DynamicResource WmclCornerCard}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="15" />
    <Setter Property="BoxShadow" Value="{DynamicResource WmclCardShadowBox}" />
  </Style>

  <Style Selector="Border.card.clickable">
    <Setter Property="Transitions">
      <Transitions>
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.09" />
        <BrushTransition Property="Background" Duration="0:0:0.09" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.card.clickable:pointerover">
    <Setter Property="Background" Value="{DynamicResource WmclBlue8}" />
    <Setter Property="BoxShadow" Value="{DynamicResource WmclCardShadowHoverBox}" />
  </Style>

  <!-- 按钮基线对齐 PCL MyButton：白底、1px 浅灰边、深色文字；主操作用蓝边蓝字，不再用填充色区分。 -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource WmclCard}" />
    <Setter Property="Foreground" Value="{DynamicResource WmclText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclDivider}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="{DynamicResource WmclFontBody}" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="13,4" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.2" />
        <BrushTransition Property="Foreground" Duration="0:0:0.2" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.10" />
      </Transitions>
    </Setter>
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
  </Style>

  <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.2" />
        <BrushTransition Property="Foreground" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ListBoxItem /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WmclBlue7}" />
    <Setter Property="Foreground" Value="{DynamicResource WmclBlue2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclBlue3}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.1" />
        <BrushTransition Property="Foreground" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource WmclCard}" />
    <Setter Property="Foreground" Value="{DynamicResource WmclBlue3}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclBlue3}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="13,4" />
  </Style>

  <Style Selector="Button.launchButton">
    <Setter Property="Height" Value="54" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Foreground" Value="{DynamicResource WmclBlue3}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclBlue3}" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WmclBlue7}" />
    <Setter Property="Foreground" Value="{DynamicResource WmclBlue2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclBlue3}" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource WmclCard}" />
    <Setter Property="Foreground" Value="{DynamicResource WmclText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclDivider}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WmclBlue7}" />
    <Setter Property="Foreground" Value="{DynamicResource WmclBlue2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclBlue3}" />
  </Style>

  <Style Selector="Button.tertiary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource WmclBlue2}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <Style Selector="Button.tertiary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WmclBlue8}" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource WmclCard}" />
    <Setter Property="Foreground" Value="{DynamicResource WmclDanger}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclDanger}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WmclErrorBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclDanger}" />
    <Setter Property="Foreground" Value="{DynamicResource WmclErrorText}" />
  </Style>

  <!-- disabled 必须位于全部 Button.<class> 之后，否则层级色会压过禁用态（设计 R3）。 -->
  <Style Selector="Button:disabled">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclDivider}" />
    <Setter Property="Foreground" Value="{DynamicResource WmclTextDisabled}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Button:disabled TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WmclTextDisabled}" />
  </Style>

  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclDivider}" />
    <Setter Property="Foreground" Value="{DynamicResource WmclTextDisabled}" />
  </Style>

  <Style Selector="Button:disabled:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclDivider}" />
    <Setter Property="Foreground" Value="{DynamicResource WmclTextDisabled}" />
  </Style>

  <Style Selector="Button.iconButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource WmclCornerButton}" />
  </Style>

  <Style Selector="Button.iconButton Path">
    <Setter Property="Stroke" Value="{DynamicResource WmclTextMuted}" />
    <Setter Property="StrokeThickness" Value="1.7" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>

  <Style Selector="Button.iconButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WmclBlue8}" />
  </Style>

  <Style Selector="Button.iconButton:pointerover Path">
    <Setter Property="Stroke" Value="{DynamicResource WmclBlue2}" />
  </Style>

  <Style Selector="Button.iconButton:disabled Path">
    <Setter Property="Stroke" Value="{DynamicResource WmclTextDisabled}" />
  </Style>

  <Style Selector="Button.size16">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>

  <Style Selector="Button.size20">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>

  <Style Selector="Button.size24">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Height" Value="30" />
    <Setter Property="Background" Value="{DynamicResource WmclCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclDivider}" />
    <Setter Property="Foreground" Value="{DynamicResource WmclText}" />
    <Setter Property="CornerRadius" Value="{DynamicResource WmclCornerButton}" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="{DynamicResource WmclFontInput}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="CaretBrush" Value="{DynamicResource WmclText}" />
  </Style>

  <!-- 复选框统一使用已有 PCL 主题，避免 Fluent 默认蓝底方块与 PCL 白底方框混用。 -->
  <Style Selector="CheckBox">
    <Setter Property="Theme" Value="{StaticResource PclCheckBoxTheme}" />
  </Style>

  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource WmclBlue3}" />
  </Style>

  <Style Selector="TextBox:disabled">
    <Setter Property="Foreground" Value="{DynamicResource WmclTextDisabled}" />
  </Style>
  <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource WmclInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclBorder}" />
  </Style>

  <Style Selector="NumericUpDown:disabled">
    <Setter Property="Background" Value="{DynamicResource WmclInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclBorder}" />
  </Style>
  <Style Selector="NumericUpDown:disabled /template/ ButtonSpinner#PART_Spinner">
    <Setter Property="Background" Value="{DynamicResource WmclInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclBorder}" />
  </Style>
  <Style Selector="NumericUpDown:disabled /template/ TextBox#PART_TextBox">
    <Setter Property="Foreground" Value="{DynamicResource WmclTextDisabled}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Height" Value="30" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource WmclCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclDivider}" />
    <Setter Property="Foreground" Value="{DynamicResource WmclText}" />
    <Setter Property="CornerRadius" Value="{DynamicResource WmclCornerButton}" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="{DynamicResource WmclFontInput}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBox:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource WmclBlue4}" />
  </Style>

  <Style Selector="ComboBox:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource WmclBlue4}" />
  </Style>

  <Style Selector="ComboBox /template/ PathIcon#DropDownGlyph">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="Foreground" Value="{DynamicResource WmclTextMuted}" />
  </Style>

  <Style Selector="ComboBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource WmclBlue3}" />
  </Style>

  <Style Selector="ComboBox:disabled /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource WmclInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclBorder}" />
  </Style>
  <Style Selector="ComboBox:disabled /template/ ContentControl#ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource WmclTextDisabled}" />
  </Style>
  <Style Selector="ComboBox:disabled /template/ TextBlock#PlaceholderTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WmclTextDisabled}" />
  </Style>
  <Style Selector="ComboBox:disabled /template/ PathIcon#DropDownGlyph">
    <Setter Property="Foreground" Value="{DynamicResource WmclTextDisabled}" />
  </Style>

  <!-- ScrollBar：8px 细轨、无箭头、6px 圆角滑块，贴近 PCL 的 MyScrollBar。 -->
  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="8" />
    <Setter Property="MinWidth" Value="8" />
    <Setter Property="MinHeight" Value="8" />
  </Style>
  <Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton,
                   ScrollBar /template/ RepeatButton#PART_LineDownButton,
                   ScrollBar /template/ RepeatButton#PART_LineLeftButton,
                   ScrollBar /template/ RepeatButton#PART_LineRightButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ScrollBar /template/ Rectangle#TrackRect">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ScrollBar:vertical /template/ Thumb">
    <Setter Property="Width" Value="6" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{DynamicResource WmclBlue4}" />
  </Style>
  <Style Selector="ScrollBar:horizontal /template/ Thumb">
    <Setter Property="Height" Value="6" />
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{DynamicResource WmclBlue4}" />
  </Style>

  <!-- ProgressBar：PCL 的细长圆角进度条。 -->
  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{DynamicResource WmclBlue8}" />
    <Setter Property="Foreground" Value="{DynamicResource WmclBlue3}" />
  </Style>

  <!-- ToolTip：PCL 的白色描边小提示。 -->
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource WmclCard}" />
    <Setter Property="Foreground" Value="{DynamicResource WmclText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclDivider}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontSize" Value="{DynamicResource WmclFontCaption}" />
  </Style>

  <!-- ContextMenu / MenuItem：白底描边菜单，26px 行高。 -->
  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource WmclCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclDivider}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource WmclText}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="MinHeight" Value="26" />
  </Style>
  <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource WmclBlue8}" />
  </Style>
  <Style Selector="MenuItem:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource WmclBlue2}" />
  </Style>

  <Style Selector="ComboBox[IsDropDownOpen=True] /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource WmclCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclDivider}" />
    <Setter Property="CornerRadius" Value="{DynamicResource WmclCornerCard}" />
    <Setter Property="MaxWidth" Value="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}" />
  </Style>

  <Style Selector="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource WmclText}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ComboBoxItem TextBlock">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WmclBlue8}" />
    <Setter Property="Foreground" Value="{DynamicResource WmclText}" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WmclBlue7}" />
    <Setter Property="Foreground" Value="{DynamicResource WmclText}" />
  </Style>

  <Style Selector="NumericUpDown">
    <Setter Property="Background" Value="{DynamicResource WmclCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclDivider}" />
    <Setter Property="CornerRadius" Value="{DynamicResource WmclCornerButton}" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="{DynamicResource WmclFontInput}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="{DynamicResource WmclCornerListItem}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="Foreground" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WmclBlue8}" />
  </Style>

  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WmclBlue7}" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource WmclBlue3}" />
    <Setter Property="Background" Value="{DynamicResource WmclBlue7}" />
    <Setter Property="CornerRadius" Value="{DynamicResource WmclCornerButton}" />
  </Style>

  <!-- A1 细滚动条（PCL2 MyScrollViewer 对齐）：默认 6px、悬停 8px；
       加宽走 Width 的 DoubleTransition，禁用 RenderTransform——PclPageAnimation 独占 ScrollBar.RenderTransform 做入场联动。 -->
  <Style Selector="ScrollBar[Orientation=Vertical]">
    <Setter Property="Width" Value="6" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Width" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ScrollBar[Orientation=Horizontal]">
    <Setter Property="Height" Value="6" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Height" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ScrollBar[Orientation=Vertical]:pointerover">
    <Setter Property="Width" Value="8" />
  </Style>
  <Style Selector="ScrollBar[Orientation=Horizontal]:pointerover">
    <Setter Property="Height" Value="8" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="MinWidth" Value="6" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Background" Value="{DynamicResource WmclScrollbarThumb}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource WmclCornerButton}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ScrollBar:pointerover /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource WmclScrollbarThumbHover}" />
  </Style>

  <!-- A2 ToolTip：卡片底 + 细描边 + 轻阴影 + 圆角 5。 -->
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource WmclCard}" />
    <Setter Property="Foreground" Value="{DynamicResource WmclText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="{DynamicResource WmclFontCaption}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource WmclCornerCard}"
                  BoxShadow="{DynamicResource WmclTooltipShadowBox}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A3 Slider（PCL2 MySlider 对齐）：16px 圆钮白底蓝描边，悬停放大至 18px。 -->
  <Style Selector="Slider">
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource WmclBlue3}" />
  </Style>
  <Style Selector="Slider /template/ Thumb">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Background" Value="{DynamicResource WmclSliderThumb}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclBlue3}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Slider:pointerover /template/ Thumb">
    <Setter Property="RenderTransform" Value="scale(1.125)" />
  </Style>

  <!-- A4 菜单（ContextMenu / MenuFlyout）：卡片底 + 细描边 + 圆角 5，菜单项高 32 / 悬停浅蓝 / 禁用灰。 -->
  <Style Selector="ContextMenu, MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource WmclCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="MenuItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource WmclBlue8}" />
  </Style>
  <Style Selector="MenuItem:disabled">
    <Setter Property="Foreground" Value="{DynamicResource WmclTextDisabled}" />
  </Style>


  <!-- A7 三态与提示族 -->
  <Style Selector="Border.skeleton">
    <Setter Property="Background" Value="{DynamicResource WmclGray6}" />
    <Setter Property="CornerRadius" Value="{DynamicResource WmclCornerButton}" />
  </Style>

  <Style Selector="StackPanel.animated">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:1.4" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.hint">
    <Setter Property="Background" Value="{DynamicResource WmclBlue8}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclBlue3}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource WmclCornerSmall}" />
    <Setter Property="Padding" Value="12,9" />
  </Style>

  <Style Selector="Border.hint.warning">
    <Setter Property="Background" Value="{DynamicResource WmclWarningBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclWarningBorder}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource WmclWarningText}" />
  </Style>

  <Style Selector="Border.hint.error">
    <Setter Property="Background" Value="{DynamicResource WmclErrorBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclDanger}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource WmclErrorText}" />
  </Style>

  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource WmclDivider}" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <Style Selector="TextBlock.dataDisplay">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

</Styles>

