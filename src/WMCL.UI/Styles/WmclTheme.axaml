<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">



  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Noto Sans CJK SC, Noto Sans SC, sans-serif" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="{DynamicResource WmclPage}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WmclText}" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource WmclBlue2}" />
  </Style>

  <Style Selector="TextBlock.cardTitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource WmclText}" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource WmclTextMuted}" />
  </Style>

  <Style Selector="TextBlock.faint">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource WmclTextFaint}" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="DejaVu Sans Mono, Noto Sans Mono, monospace" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource WmclCard}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="15" />
    <Setter Property="BoxShadow" Value="0 1 6 0 #22343D4A" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Background" Value="#55FFFFFF" />
    <Setter Property="Foreground" Value="{DynamicResource WmclText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclText}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="Foreground" Duration="0:0:0.12" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.10" />
      </Transitions>
    </Setter>
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
  </Style>

  <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="Foreground" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ListBoxItem /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WmclBlue7}" />
    <Setter Property="Foreground" Value="{DynamicResource WmclBlue2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclBlue3}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="#55FFFFFF" />
    <Setter Property="Foreground" Value="{DynamicResource WmclBlue2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclBlue2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="20,9" />
  </Style>

  <Style Selector="Button.launchButton">
    <Setter Property="Height" Value="54" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WmclBlue7}" />
    <Setter Property="Foreground" Value="{DynamicResource WmclBlue2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclBlue3}" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="#55FFFFFF" />
    <Setter Property="Foreground" Value="{DynamicResource WmclText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclText}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WmclBlue7}" />
    <Setter Property="Foreground" Value="{DynamicResource WmclBlue2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclBlue3}" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource WmclInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclBorder}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="MinHeight" Value="30" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource WmclInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclBorder}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="MinHeight" Value="30" />
  </Style>

  <Style Selector="NumericUpDown">
    <Setter Property="Background" Value="{DynamicResource WmclInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WmclBorder}" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <BrushTransition Property="Foreground" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WmclBlue8}" />
  </Style>

  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WmclBlue7}" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource WmclBlue3}" />
    <Setter Property="Background" Value="{DynamicResource WmclBlue7}" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

</Styles>
