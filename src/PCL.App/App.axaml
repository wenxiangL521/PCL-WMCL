<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PCL.App.ViewModels"
             xmlns:views="using:PCL.App.Views"
             x:Class="PCL.App.App"
             RequestedThemeVariant="Light">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://PCL.UI/Styles/PclColors.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://PCL.UI/Styles/PclTheme.axaml" />
  </Application.Styles>

  <Application.DataTemplates>
    <DataTemplate DataType="vm:LaunchViewModel">
      <views:LaunchView />
    </DataTemplate>
    <DataTemplate DataType="vm:DownloadViewModel">
      <views:DownloadView />
    </DataTemplate>
    <DataTemplate DataType="vm:InstanceViewModel">
      <views:InstanceView />
    </DataTemplate>
    <DataTemplate DataType="vm:ModsViewModel">
      <views:ModsView />
    </DataTemplate>
    <DataTemplate DataType="vm:ModpackViewModel">
      <views:ModpackView />
    </DataTemplate>
    <DataTemplate DataType="vm:InstanceContentViewModel">
      <views:InstanceContentView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="vm:AboutViewModel">
      <views:AboutView />
    </DataTemplate>
    <DataTemplate DataType="vm:LinkViewModel">
      <views:LinkView />
    </DataTemplate>
    <DataTemplate DataType="vm:MorePageViewModel">
      <views:MoreInfoView />
    </DataTemplate>
  </Application.DataTemplates>

</Application>
