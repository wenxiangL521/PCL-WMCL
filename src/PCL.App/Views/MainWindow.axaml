<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PCL.App.Views.MainWindow"
        Title="Plain Craft Launcher"
        Width="850"
        Height="500"
        MinWidth="810"
        MinHeight="470"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        CanResize="True"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        PointerPressed="OnWindowPointerPressed"
        PointerMoved="OnWindowPointerMoved">

  <Window.Resources>
    <LinearGradientBrush x:Key="PclTitleGradient" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Color="#4890F5" Offset="0" />
      <GradientStop Color="#1370F3" Offset="1" />
    </LinearGradientBrush>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="ListBox.topTabs">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.topTabs ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="14,5" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="ListBox.topTabs ListBoxItem /template/ ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox.topTabs ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#22FFFFFF" />
    </Style>
    <Style Selector="ListBox.topTabs ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="ListBox.topTabs ListBoxItem TextBlock">
      <Setter Property="Foreground" Value="#E6FFFFFF" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ListBox.topTabs ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="ListBox.subTabs">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.subTabs ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="ListBox.subTabs ListBoxItem /template/ ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox.subTabs ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PclBlue8}" />
    </Style>
    <Style Selector="ListBox.subTabs ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PclBlue8}" />
    </Style>
    <Style Selector="ListBox.subTabs ListBoxItem TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PclText}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ListBox.subTabs ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PclBlue3}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.taskBall">
      <Setter Property="Width" Value="52" />
      <Setter Property="Height" Value="52" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="26" />
      <Setter Property="Background" Value="{DynamicResource PclBlue3}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.taskBallShadow">
      <Setter Property="Width" Value="52" />
      <Setter Property="Height" Value="52" />
      <Setter Property="CornerRadius" Value="26" />
      <Setter Property="BoxShadow" Value="0 2 10 0 #550B5BCB" />
    </Style>
    <Style Selector="Button.taskBall:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PclBlue2}" />
    </Style>

    <Style Selector="Button.titleButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.titleButton:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.titleButton.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E04444" />
    </Style>
  </Window.Styles>

  <Border x:Name="RootFrame"
          Margin="8"
          Opacity="0.01"
          CornerRadius="6"
          ClipToBounds="True"
          Background="{DynamicResource PclPage}"
          BoxShadow="0 2 8 0 #44000000">
    <Border.RenderTransform>
      <ScaleTransform ScaleX="0.985" ScaleY="0.985" />
    </Border.RenderTransform>
    <Border.Transitions>
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
      </Transitions>
    </Border.Transitions>
  <Grid>
    <Image Source="{Binding BackgroundImage}"
           Stretch="UniformToFill"
           Opacity="{Binding BackgroundImageOpacity}"
           IsVisible="{Binding HasBackgroundImage}">
      <Image.Effect>
        <BlurEffect Radius="{Binding BackgroundImageBlur}" />
      </Image.Effect>
    </Image>
    <Grid RowDefinitions="48,*">
    <Border Name="TitleBar"
            Grid.Row="0"
            Background="{DynamicResource PclTitleGradient}"
            PointerPressed="OnTitleBarPointerPressed">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="18,0,0,0"
                    Spacing="8">
          <Path Data="M26,29 v-25 h6 a7,7 180 0 1 0,14 h-6 M62.5,6.5 a10,11.5 180 1 0 0,18 M71,2.5 v24.5 h13.5"
                Stroke="White"
                StrokeThickness="2.2"
                Width="39"
                Height="29"
                Stretch="Fill"
                VerticalAlignment="Center" />
          <TextBlock Text="Linux"
                     FontSize="12"
                     Foreground="#CCFFFFFF"
                     VerticalAlignment="Center"
                     Margin="0,5,0,0" />
        </StackPanel>

        <ListBox Grid.Column="1"
                 Classes="topTabs"
                 ItemsSource="{Binding TopTabs}"
                 SelectedItem="{Binding SelectedTopTab}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Data="{Binding IconData}"
                      Fill="#F2FFFFFF"
                      Width="14"
                      Height="14"
                      Stretch="Uniform"
                      VerticalAlignment="Center"
                      IsVisible="{Binding HasIcon}" />
                <TextBlock Text="{Binding Icon}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           IsVisible="{Binding !HasIcon}" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    Spacing="2">
          <Button Classes="titleButton" Click="OnMinimizeClick">
            <Path Data="M0,0 h15 v2 h-15 v-2 Z"
                  Fill="White"
                  Width="13"
                  Height="2"
                  Stretch="Fill" />
          </Button>
          <Button Classes="titleButton close" Click="OnCloseClick">
            <Path Data="M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z"
                  Fill="White"
                  Width="13"
                  Height="13"
                  Stretch="Fill" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
      <Border Grid.Column="0"
              Width="{Binding SubNavWidth}"
              Background="{DynamicResource PclSidebar}"
              BorderBrush="{DynamicResource PclBorder}"
              BorderThickness="0,0,1,0"
              ClipToBounds="True"
              IsHitTestVisible="{Binding HasSubTabs}">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Width" Duration="0:0:0.18" Easing="CubicEaseOut" />
          </Transitions>
        </Border.Transitions>
        <DockPanel Margin="9,12,9,10">
          <TextBlock DockPanel.Dock="Bottom"
                     Text="{Binding VersionText}"
                     Classes="faint"
                     Margin="6,10,0,0" />
          <ListBox Classes="subTabs"
                   ItemsSource="{Binding SubTabs}"
                   SelectedItem="{Binding SelectedSubTab}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <TextBlock Text="{Binding Icon}" Width="16" FontSize="13" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <TransitioningContentControl x:Name="PageHost"
                                   Grid.Column="1"
                                   Content="{Binding CurrentPage}"
                                   Margin="18" />
    </Grid>
  </Grid>

    <Border Classes="taskBallShadow"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,24,84"
            IsVisible="{Binding IsTaskActive}">
      <Button Classes="taskBall"
              Command="{Binding OpenTaskCommand}"
              ToolTip.Tip="{Binding TaskText}">
        <Grid Width="44" Height="44">
          <Ellipse Stroke="#77FFFFFF" StrokeThickness="3" Margin="2" />
          <TextBlock Text="{Binding TaskPercentText}"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="White"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Grid>
      </Button>
    </Border>
  </Grid>
  </Border>
</Window>
