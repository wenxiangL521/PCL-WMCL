<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PCL.App.Views.InstallView">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="12" MaxWidth="760" HorizontalAlignment="Stretch">
      <Border Classes="card">
        <StackPanel Spacing="9">
          <StackPanel Spacing="2">
            <TextBlock Text="Minecraft" Classes="cardTitle" />
            <TextBlock Text="安装原版游戏文件" Classes="muted" />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <ComboBox ItemsSource="{Binding Download.Versions}"
                      SelectedItem="{Binding Download.SelectedVersion}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Id}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="已安装"
                               Classes="faint"
                               Foreground="{DynamicResource PclBlue3}"
                               IsVisible="{Binding IsInstalled}"
                               Margin="8,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Content="刷新" Classes="secondary"
                    Command="{Binding Download.RefreshCommand}" Margin="7,0,0,0" />
          </Grid>
          <ComboBox ItemsSource="{Binding Download.Filters}"
                    SelectedItem="{Binding Download.SelectedFilter}"
                    HorizontalAlignment="Stretch" />
          <TextBlock Text="{Binding Download.SelectedVersionTitle}"
                     FontSize="19" FontWeight="Bold"
                     Foreground="{DynamicResource PclBlue2}" />
          <TextBlock Text="{Binding Download.SelectedVersionInfo}" Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Download.GameDirectory}" Classes="faint"
                     TextTrimming="CharacterEllipsis" />
          <ProgressBar Value="{Binding Download.Progress}" Maximum="100"
                       IsVisible="{Binding Download.IsBusy}" />
          <TextBlock Text="{Binding Download.ProgressText}" Classes="faint"
                     IsVisible="{Binding Download.IsBusy}" TextWrapping="Wrap" />
          <WrapPanel Orientation="Horizontal">
            <Button Content="安装所选版本" Classes="primary"
                    Command="{Binding Download.InstallCommand}"
                    IsEnabled="{Binding Download.CanInstall}" Margin="0,0,7,7" />
            <Button Content="校验 / 修复" Classes="secondary"
                    Command="{Binding Download.VerifyCommand}"
                    IsEnabled="{Binding Download.CanVerify}" Margin="0,0,7,7" />
            <Button Content="取消" Command="{Binding Download.CancelCommand}"
                    IsVisible="{Binding Download.CanCancel}" Margin="0,0,7,7" />
          </WrapPanel>
          <TextBlock Text="{Binding Download.Status}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="9">
          <StackPanel Spacing="2">
            <TextBlock Text="Fabric" Classes="cardTitle" />
            <TextBlock Text="为已安装的原版版本安装 Fabric Loader" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto">
            <TextBlock Text="游戏版本" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Mods.GameVersions}"
                      SelectedItem="{Binding Mods.SelectedGameVersion}"
                      HorizontalAlignment="Stretch" Margin="0,4" />
            <TextBlock Grid.Row="1" Text="Fabric Loader" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Mods.Loaders}"
                      SelectedItem="{Binding Mods.SelectedLoader}"
                      HorizontalAlignment="Stretch" Margin="0,4" />
          </Grid>
          <ProgressBar Value="{Binding Mods.Progress}" Maximum="100"
                       IsVisible="{Binding Mods.IsBusy}" />
          <WrapPanel Orientation="Horizontal">
            <Button Content="安装 Fabric" Classes="primary"
                    Command="{Binding Mods.InstallFabricCommand}"
                    IsEnabled="{Binding Mods.CanInstall}" Margin="0,0,7,7" />
            <Button Content="取消" Command="{Binding Mods.CancelCommand}"
                    IsEnabled="{Binding Mods.CanCancel}" Margin="0,0,7,7" />
            <Button Content="刷新" Command="{Binding Mods.RefreshCommand}" Margin="0,0,7,7" />
          </WrapPanel>
          <TextBlock Text="{Binding Mods.Status}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="9">
          <StackPanel Spacing="2">
            <TextBlock Text="Forge / NeoForge" Classes="cardTitle" />
            <TextBlock Text="现代 Forge/NeoForge headless 安装器" Classes="muted" />
          </StackPanel>
          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto">
            <TextBlock Text="加载器" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Mods.ForgelikeKinds}"
                      SelectedItem="{Binding Mods.SelectedForgelikeKind}"
                      HorizontalAlignment="Stretch" Margin="0,4" />
            <TextBlock Grid.Row="1" Text="版本" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Mods.ForgelikeVersions}"
                      SelectedItem="{Binding Mods.SelectedForgelikeVersion}"
                      HorizontalAlignment="Stretch" Margin="0,4" />
          </Grid>
          <TextBlock Text="{Binding Mods.SelectedGameVersion, StringFormat='游戏版本：{0}'}" Classes="faint" />
          <ProgressBar Value="{Binding Mods.ForgelikeProgress}" Maximum="100"
                       IsVisible="{Binding Mods.IsForgelikeBusy}" />
          <WrapPanel Orientation="Horizontal">
            <Button Content="安装 Forge/NeoForge" Classes="primary"
                    Command="{Binding Mods.InstallForgelikeCommand}"
                    IsEnabled="{Binding Mods.CanInstallForgelike}" Margin="0,0,7,7" />
            <Button Content="取消" Command="{Binding Mods.CancelForgelikeCommand}"
                    IsEnabled="{Binding Mods.IsForgelikeBusy}" Margin="0,0,7,7" />
          </WrapPanel>
          <TextBlock Text="{Binding Mods.ForgelikeStatus}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="9">
          <StackPanel Spacing="2">
            <TextBlock Text="OptiFine" Classes="cardTitle" />
            <TextBlock Text="官方安装器 headless 安装" Classes="muted" />
          </StackPanel>
          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto">
            <TextBlock Text="游戏版本" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Mods.SelectedGameVersion}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Text="OptiFine 版本" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Mods.OptiFineVersions}"
                      SelectedItem="{Binding Mods.SelectedOptiFineVersion}"
                      HorizontalAlignment="Stretch" Margin="0,4">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Patch}" />
                    <TextBlock Text="preview" Classes="faint" IsVisible="{Binding IsPreview}" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <ProgressBar Value="{Binding Mods.OptiFineProgress}" Maximum="100"
                       IsVisible="{Binding Mods.IsOptiFineBusy}" />
          <WrapPanel Orientation="Horizontal">
            <Button Content="安装 OptiFine" Classes="primary"
                    Command="{Binding Mods.InstallOptiFineCommand}"
                    IsEnabled="{Binding Mods.CanInstallOptiFine}" Margin="0,0,7,7" />
            <Button Content="取消" Command="{Binding Mods.CancelOptiFineCommand}"
                    IsEnabled="{Binding Mods.IsOptiFineBusy}" Margin="0,0,7,7" />
          </WrapPanel>
          <TextBlock Text="{Binding Mods.OptiFineStatus}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
