<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PCL.App.Views.LaunchView">

  <Grid ColumnDefinitions="300,*">
    <Border Grid.Column="0"
            Background="{DynamicResource PclSidebar}"
            BorderBrush="{DynamicResource PclBorder}"
            BorderThickness="0,0,1,0"
            Margin="-18,-18,0,-18"
            Padding="20,16">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="8">
          <TextBlock Text="账户" Classes="cardTitle" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding PlayerName}"
                     Watermark="玩家名"
                     IsEnabled="{Binding IsOfflineAccount}" />
            <Button Grid.Column="1"
                    Content="微软登录"
                    Classes="secondary"
                    Padding="10,6"
                    MinHeight="30"
                    Click="OnMicrosoftLoginClick" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding AccountStatus}" Classes="faint" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="退出"
                    Padding="8,2"
                    MinHeight="24"
                    FontSize="11"
                    Command="{Binding LogoutMicrosoftCommand}"
                    IsVisible="{Binding IsMicrosoftAccount}" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
            <TextBlock Text="内存" VerticalAlignment="Center" Classes="muted" />
            <Slider Grid.Column="1"
                    Minimum="512"
                    Maximum="16384"
                    TickFrequency="512"
                    Value="{Binding MemoryMb}"
                    Margin="10,0" />
            <TextBlock Grid.Column="2"
                       Text="{Binding MemoryMb, StringFormat='{}{0:0} MB'}"
                       Classes="faint"
                       VerticalAlignment="Center"
                       Width="64" />
          </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    Spacing="8">
          <TextBlock Text="游戏版本" Classes="cardTitle" />
          <ComboBox ItemsSource="{Binding Versions}"
                    SelectedItem="{Binding SelectedVersion}"
                    HorizontalAlignment="Stretch"
                    MaxDropDownHeight="320">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Id}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1"
                             Text="已安装"
                             Classes="faint"
                             Foreground="{DynamicResource PclBlue3}"
                             IsVisible="{Binding IsInstalled}"
                             Margin="8,0,0,0" />
                </Grid>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{Binding SelectedVersionTitle}"
                     FontSize="18"
                     FontWeight="Bold"
                     Foreground="{DynamicResource PclBlue2}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding VersionInfo}"
                     Classes="faint"
                     TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="安装"
                    Classes="secondary"
                    Command="{Binding InstallCommand}"
                    IsEnabled="{Binding CanInstall}" />
            <Button Content="刷新"
                    Classes="secondary"
                    Command="{Binding RefreshCommand}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="7">
          <ProgressBar Value="{Binding Progress}"
                       Maximum="100"
                       IsVisible="{Binding IsBusy}" />
          <TextBlock Text="{Binding ProgressText}"
                     Classes="faint"
                     IsVisible="{Binding IsBusy}"
                     TextTrimming="CharacterEllipsis" />
          <Button Content="启动游戏"
                  Classes="primary launchButton"
                  Command="{Binding LaunchCommand}"
                  IsEnabled="{Binding CanLaunch}" />
          <Button Content="取消"
                  Command="{Binding CancelCommand}"
                  IsVisible="{Binding CanCancel}" />
          <TextBlock Text="{Binding Status}"
                     Classes="muted"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="18,0,0,0">
      <Border Grid.Row="0"
              IsVisible="{Binding HasCrashReport}"
              Background="{DynamicResource PclCrashBackground}"
              BorderBrush="{DynamicResource PclCrashBorder}"
              BorderThickness="1"
              CornerRadius="5"
              Padding="12"
              Margin="0,0,0,12">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding CrashTitle}"
                     FontWeight="Bold"
                     Foreground="{DynamicResource PclCrashTitle}" />
          <TextBlock Text="{Binding CrashDetails}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource PclCrashText}" />
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Classes="card" Padding="0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="15,11,11,7">
            <TextBlock Text="启动日志" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="清空"
                    Padding="9,3"
                    MinHeight="26"
                    FontSize="11"
                    Command="{Binding ClearLogCommand}" />
          </Grid>
          <TextBox x:Name="LogBox"
                   Text="{Binding Log, Mode=OneWay}"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="NoWrap"
                   FontFamily="DejaVu Sans Mono, Noto Sans Mono, monospace"
                   FontSize="11"
                   Background="{DynamicResource PclLogBackground}"
                   BorderThickness="0"
                   CornerRadius="0,0,5,5"
                   Margin="10,0,10,10"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
