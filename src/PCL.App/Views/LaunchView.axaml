<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PCL.App.Views.LaunchView">

  <Grid ColumnDefinitions="300,*">
    <Border Grid.Column="0"
            Background="{DynamicResource PclSidebar}"
            BorderBrush="{DynamicResource PclBorder}"
            BorderThickness="0,0,1,0"
            Margin="-18,-18,0,-18"
            Padding="20,16">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <RadioButton x:Name="OnlineAccountRadio"
                         GroupName="AccountType"
                         Content="正版"
                         IsChecked="{Binding IsMicrosoftAccount, Mode=OneWay}"
                         Click="OnOnlineAccountClick" />
            <RadioButton x:Name="OfflineAccountRadio"
                         GroupName="AccountType"
                         Content="离线"
                         IsChecked="{Binding IsOfflineAccount, Mode=OneWay}"
                         Click="OnOfflineAccountClick" />
            <RadioButton x:Name="AuthlibAccountRadio"
                         GroupName="AccountType"
                         Content="第三方"
                         IsChecked="{Binding IsAuthlibAccount, Mode=OneWay}"
                         Click="OnAuthlibAccountClick" />
          </StackPanel>
          <ComboBox ItemsSource="{Binding AuthlibAccounts}"
                    SelectedItem="{Binding SelectedAuthlibAccount}"
                    IsVisible="{Binding HasAuthlibAccounts}"
                    HorizontalAlignment="Stretch"
                    Margin="0,2,0,0">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Server}" Classes="faint" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Border Width="38" Height="38" CornerRadius="19"
                    ClipToBounds="True"
                    Background="{DynamicResource PclBlue6}">
              <Panel>
                <TextBlock Text="{Binding PlayerInitial}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PclBlue3}"
                           IsVisible="{Binding !HasAccountSkin}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <Image Source="{Binding AccountSkin}"
                       IsVisible="{Binding HasAccountSkin}"
                       Stretch="UniformToFill" />
              </Panel>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="{Binding PlayerName}" FontWeight="SemiBold" FontSize="14" />
              <TextBlock Text="{Binding AccountStatus}" Classes="faint" />
            </StackPanel>
          </Grid>
          <TextBox Text="{Binding PlayerName}"
                   Watermark="玩家名"
                   IsVisible="{Binding IsOfflineAccount}" />
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Text="内存" VerticalAlignment="Center" Classes="muted" />
            <Slider Grid.Column="1"
                    Minimum="512"
                    Maximum="16384"
                    TickFrequency="512"
                    Value="{Binding MemoryMb}"
                    Margin="10,0" />
            <TextBlock Grid.Column="2"
                       Text="{Binding MemoryMb, StringFormat='{}{0:0} MB'}"
                       Classes="faint"
                       VerticalAlignment="Center"
                       Width="64" />
          </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    VerticalAlignment="Top"
                    Margin="0,8,0,0"
                    Spacing="6">
          <TextBlock Text="游戏版本" Classes="cardTitle" />
          <ComboBox ItemsSource="{Binding Versions}"
                    SelectedItem="{Binding SelectedVersion}"
                    HorizontalAlignment="Stretch"
                    MaxDropDownHeight="320">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Id}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1"
                             Text="已安装"
                             Classes="faint"
                             Foreground="{DynamicResource PclBlue3}"
                             IsVisible="{Binding IsInstalled}"
                             Margin="8,0,0,0" />
                </Grid>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{Binding SelectedVersionTitle}"
                     FontSize="17"
                     FontWeight="Bold"
                     Foreground="{DynamicResource PclBlue2}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding VersionInfo}"
                     Classes="faint"
                     TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="安装"
                    Classes="secondary"
                    Command="{Binding InstallCommand}"
                    IsEnabled="{Binding CanInstall}" />
            <Button Content="刷新"
                    Classes="secondary"
                    Command="{Binding RefreshCommand}" />
            <Button Content="版本设置"
                    Command="{Binding OpenVersionSettingsCommand}"
                    IsEnabled="{Binding CanOpenVersionSettings}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="7">
          <ProgressBar Value="{Binding Progress}"
                       Maximum="100"
                       IsVisible="{Binding IsBusy}" />
          <TextBlock Text="{Binding ProgressText}"
                     Classes="faint"
                     IsVisible="{Binding IsBusy}"
                     TextTrimming="CharacterEllipsis" />
          <Button Content="启动游戏"
                  Classes="primary launchButton"
                  HorizontalAlignment="Stretch"
                  Command="{Binding LaunchCommand}"
                  IsEnabled="{Binding CanLaunch}" />
          <Button Content="取消"
                  HorizontalAlignment="Stretch"
                  Command="{Binding CancelCommand}"
                  IsVisible="{Binding CanCancel}" />
          <TextBlock Text="{Binding Status}"
                     Classes="muted"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="18,0,0,0">
      <Border Grid.Row="0"
              IsVisible="{Binding HasCrashReport}"
              Background="{DynamicResource PclCrashBackground}"
              BorderBrush="{DynamicResource PclCrashBorder}"
              BorderThickness="1"
              CornerRadius="5"
              Padding="12"
              Margin="0,0,0,12">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding CrashTitle}"
                     FontWeight="Bold"
                     Foreground="{DynamicResource PclCrashTitle}" />
          <TextBlock Text="{Binding CrashDetails}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource PclCrashText}" />
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Classes="card" Padding="0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="15,11,11,7">
            <TextBlock Text="启动日志" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="清空"
                    Padding="9,3"
                    MinHeight="26"
                    FontSize="11"
                    Command="{Binding ClearLogCommand}" />
          </Grid>
          <TextBox x:Name="LogBox"
                   Text="{Binding Log, Mode=OneWay}"
                   IsReadOnly="True"
                   AcceptsReturn="True"
                   TextWrapping="NoWrap"
                   FontFamily="DejaVu Sans Mono, Noto Sans Mono, monospace"
                   FontSize="11"
                   Background="{DynamicResource PclLogBackground}"
                   BorderThickness="0"
                   CornerRadius="0,0,5,5"
                   Margin="10,0,10,10"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
