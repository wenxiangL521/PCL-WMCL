<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PCL.App.Views.TaskManagerWindow"
        Title="任务管理"
        Width="620"
        Height="440"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PclPage}">
  <Border Classes="card" Margin="14" Padding="16">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="任务管理" Classes="h2" />
          <TextBlock Text="{Binding OverallText}" Classes="muted" />
        </StackPanel>
        <Button Grid.Column="1" Content="取消全部" Classes="secondary"
                Command="{Binding CancelAllCommand}"
                IsEnabled="{Binding HasTasks}" />
      </Grid>

      <ProgressBar DockPanel.Dock="Top"
                   Value="{Binding OverallProgress}"
                   Maximum="100"
                   Margin="0,10,0,0" />

      <ListBox Margin="0,12,0,0" ItemsSource="{Binding Tasks}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Detail}" Classes="faint" TextWrapping="Wrap" />
                <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" />
              </StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="4">
                <TextBlock Text="{Binding PercentText}" Classes="faint"
                           HorizontalAlignment="Right" />
                <Button Content="取消"
                        IsVisible="{Binding HasCancel}"
                        Command="{Binding $parent[Window].DataContext.CancelTaskCommand}"
                        CommandParameter="{Binding}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Border>
</Window>
