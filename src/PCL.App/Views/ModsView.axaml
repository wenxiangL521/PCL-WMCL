<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PCL.App.Views.ModsView">

  <Grid ColumnDefinitions="*,380">
    <ScrollViewer Grid.Column="0" Margin="0,0,16,0" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16">
        <Border Classes="card">
          <StackPanel Spacing="16">
            <StackPanel Spacing="2">
              <TextBlock Text="Fabric" Classes="h1" />
              <TextBlock Text="为已安装的原版版本安装 Fabric Loader"
                         Classes="muted" />
            </StackPanel>

            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto">
              <TextBlock Text="游戏版本" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding GameVersions}"
                        SelectedItem="{Binding SelectedGameVersion}"
                        HorizontalAlignment="Stretch"
                        Margin="0,6" />

              <TextBlock Grid.Row="1" Text="Fabric Loader" VerticalAlignment="Center" />
              <ComboBox Grid.Row="1" Grid.Column="1"
                        ItemsSource="{Binding Loaders}"
                        SelectedItem="{Binding SelectedLoader}"
                        HorizontalAlignment="Stretch"
                        Margin="0,6" />
            </Grid>

            <ProgressBar Value="{Binding Progress}"
                         Maximum="100"
                         IsVisible="{Binding IsBusy}" />
            <TextBlock Text="{Binding ProgressText}"
                       Classes="faint"
                       IsVisible="{Binding IsBusy}"
                       TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="安装 Fabric"
                      Classes="primary"
                      Command="{Binding InstallFabricCommand}"
                      IsEnabled="{Binding CanInstall}" />
              <Button Content="取消"
                      Command="{Binding CancelCommand}"
                      IsEnabled="{Binding CanCancel}" />
              <Button Content="刷新"
                      Classes="secondary"
                      Command="{Binding RefreshCommand}" />
            </StackPanel>

            <TextBlock Text="{Binding Status}"
                       Classes="muted"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="12">
            <StackPanel Spacing="2">
              <TextBlock Text="Forge / NeoForge" Classes="h2" />
              <TextBlock Text="为原版版本安装现代 Forge/NeoForge（headless installer）"
                         Classes="muted"
                         TextWrapping="Wrap" />
            </StackPanel>

            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto">
              <TextBlock Text="加载器" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding ForgelikeKinds}"
                        SelectedItem="{Binding SelectedForgelikeKind}"
                        HorizontalAlignment="Stretch"
                        Margin="0,6" />

              <TextBlock Grid.Row="1" Text="版本" VerticalAlignment="Center" />
              <ComboBox Grid.Row="1" Grid.Column="1"
                        ItemsSource="{Binding ForgelikeVersions}"
                        SelectedItem="{Binding SelectedForgelikeVersion}"
                        HorizontalAlignment="Stretch"
                        Margin="0,6" />
            </Grid>

            <TextBlock Text="{Binding SelectedGameVersion, StringFormat='游戏版本：{0}'}"
                       Classes="faint" />

            <ProgressBar Value="{Binding ForgelikeProgress}"
                         Maximum="100"
                         IsVisible="{Binding IsForgelikeBusy}" />
            <TextBlock Text="{Binding ForgelikeProgressText}"
                       Classes="faint"
                       IsVisible="{Binding IsForgelikeBusy}"
                       TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="安装 Forge/NeoForge"
                      Classes="primary"
                      Command="{Binding InstallForgelikeCommand}"
                      IsEnabled="{Binding CanInstallForgelike}" />
              <Button Content="取消"
                      Command="{Binding CancelForgelikeCommand}"
                      IsEnabled="{Binding IsForgelikeBusy}" />
            </StackPanel>

            <TextBlock Text="{Binding ForgelikeStatus}"
                       Classes="muted"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="已安装 Mod" Classes="h2" />
                <TextBlock Text="{Binding ModsDirectory}"
                           Classes="faint"
                           TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1"
                      Content="刷新"
                      Classes="secondary"
                      Command="{Binding RefreshLocalModsCommand}" />
            </Grid>

            <ListBox ItemsSource="{Binding LocalMods}"
                     SelectedItem="{Binding SelectedLocalMod}"
                     Height="200">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="1">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding DisplayName}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding StateText}"
                                 Classes="faint"
                                 Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding UpdateText}"
                               FontSize="11"
                               Foreground="{DynamicResource PclBlue2}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{Binding ToggleModText}"
                      Classes="primary"
                      Command="{Binding ToggleLocalModCommand}"
                      IsEnabled="{Binding HasSelectedLocalMod}" />
              <Button Content="删除"
                      Command="{Binding DeleteLocalModCommand}"
                      IsEnabled="{Binding HasSelectedLocalMod}" />
              <Button Content="打开目录"
                      Command="{Binding OpenModsFolderCommand}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="检查更新"
                      Classes="secondary"
                      Command="{Binding CheckModUpdatesCommand}" />
              <Button Content="更新选中"
                      Command="{Binding UpdateSelectedModCommand}"
                      IsEnabled="{Binding CanUpdateSelectedMod}" />
            </StackPanel>

            <TextBlock Text="{Binding LocalModStatus}"
                       Classes="faint"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding UpdateStatus}"
                       Classes="faint"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Column="1" Classes="card" Margin="16,0,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,150">
            <StackPanel Spacing="2">
              <TextBlock Text="Mod 搜索" Classes="h1" />
              <TextBlock Text="Modrinth / CurseForge" Classes="muted" />
            </StackPanel>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding ModSources}"
                      SelectedItem="{Binding SelectedModSource}"
                      VerticalAlignment="Center" />
          </Grid>

          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Text="目标实例"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding ModInstances}"
                      SelectedItem="{Binding SelectedModInstance}"
                      HorizontalAlignment="Stretch" />
          </Grid>
          <TextBlock Text="{Binding ModTargetInfo}"
                     Classes="faint"
                     TextWrapping="Wrap" />

          <Grid ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding SearchText}"
                     Watermark="搜索 Mod，例如 sodium" />
            <Button Grid.Column="1"
                    Content="搜索"
                    Classes="secondary"
                    Command="{Binding SearchModsCommand}"
                    Margin="8,0,0,0" />
          </Grid>

          <ListBox ItemsSource="{Binding SearchResults}"
                   SelectedItem="{Binding SelectedMod}"
                   Height="300">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Description}"
                             Classes="faint"
                             TextWrapping="Wrap"
                             MaxHeight="34"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Downloads, StringFormat='下载 {0:N0}'}"
                             Classes="faint" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <ProgressBar Value="{Binding ModProgress}"
                       Maximum="100"
                       IsVisible="{Binding IsModBusy}" />
          <TextBlock Text="{Binding ModProgressText}"
                     Classes="faint"
                     IsVisible="{Binding IsModBusy}"
                     TextWrapping="Wrap" />

          <Button Content="安装所选 Mod"
                  Classes="primary"
                  HorizontalAlignment="Stretch"
                  Command="{Binding InstallModCommand}"
                  IsEnabled="{Binding CanInstallMod}" />

          <TextBlock Text="{Binding ModStatus}"
                     Classes="muted"
                     TextWrapping="Wrap" />

          <Border Height="1" Background="{DynamicResource PclBorder}" Margin="0,4" />

          <TextBlock Text="{Binding ModsDirectory}"
                     Classes="faint"
                     TextWrapping="Wrap" />
          <Button Content="打开 mods 目录"
                  HorizontalAlignment="Stretch"
                  Command="{Binding OpenModsFolderCommand}" />

          <Border Background="{DynamicResource PclBlue8}"
                  CornerRadius="8"
                  Padding="12">
            <TextBlock Text="Fabric/Forge 实例使用独立游戏目录，mods 位于 versions/&lt;id&gt;/mods；原版实例仍使用根目录 mods。"
                       Classes="muted"
                       TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
