<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PCL.App.Views.AboutView">

  <Border Classes="card" MaxWidth="760" HorizontalAlignment="Left">
    <StackPanel Spacing="12">
      <TextBlock Text="PCL Linux" Classes="h1" />
      <TextBlock Text="{Binding Version}" Classes="muted" />
      <TextBlock Text="{Binding Runtime}" Classes="faint" />

      <Border Height="1" Background="{DynamicResource PclBorder}" Margin="0,6" />

      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Attribution}"
                 Classes="muted"
                 TextWrapping="Wrap" />

      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <Button Content="打开原版仓库"
                Classes="secondary"
                Command="{Binding OpenProjectCommand}" />
        <Button Content="打开日志目录"
                Classes="secondary"
                Command="{Binding OpenLogsCommand}" />
        <Button Content="检查更新"
                Classes="secondary"
                Command="{Binding CheckUpdateCommand}" />
        <Button Content="下载更新包"
                Command="{Binding DownloadUpdateCommand}"
                IsEnabled="{Binding CanDownloadUpdate}" />
      </StackPanel>

      <ProgressBar Value="{Binding UpdateProgress}"
                   Maximum="100"
                   IsVisible="{Binding IsUpdating}" />
      <TextBlock Text="{Binding UpdateProgressText}"
                 Classes="faint"
                 IsVisible="{Binding IsUpdating}" />
      <TextBlock Text="{Binding UpdateStatus}"
                 Classes="muted"
                 TextWrapping="Wrap" />

      <TextBlock Text="{Binding Status}" Classes="faint" />

      <Border Height="1" Background="{DynamicResource PclBorder}" Margin="0,6" />

      <TextBlock Text="许可提示" FontWeight="SemiBold" />
      <TextBlock Text="原版 PCL2 使用《PCL 分发有限许可》（非 OSI 开源许可）。本项目在发布前需按其要求处理名称、署名、开源与正版提示；当前仅为本地开发版本。"
                 Classes="muted"
                 TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>
