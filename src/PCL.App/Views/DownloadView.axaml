<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PCL.App.Views.DownloadView">

  <Grid ColumnDefinitions="*,360">
    <Border Classes="card">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="下载" Classes="h1" />
            <TextBlock Text="原版 Minecraft 版本安装" Classes="muted" />
          </StackPanel>
          <Button Grid.Column="1"
                  Content="刷新"
                  Classes="secondary"
                  Command="{Binding RefreshCommand}"
                  Padding="12,4"
                  MinHeight="30" />
        </Grid>

        <ComboBox DockPanel.Dock="Top"
                  Margin="0,12,0,0"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Filters}"
                  SelectedItem="{Binding SelectedFilter}" />

        <ListBox Margin="0,12,0,0"
                 ItemsSource="{Binding Versions}"
                 SelectedItem="{Binding SelectedVersion}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="1">
                  <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Subtitle}" Classes="faint" />
                </StackPanel>
                <Border Grid.Column="1"
                        Background="{DynamicResource PclBlue8}"
                        CornerRadius="4"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsInstalled}">
                  <TextBlock Text="已安装"
                             FontSize="10"
                             Foreground="{DynamicResource PclBlue3}" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <Border Grid.Column="1" Classes="card" Margin="16,0,0,0">
      <StackPanel Spacing="12">
        <TextBlock Text="{Binding SelectedVersionTitle}"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="{DynamicResource PclBlue2}" />
        <TextBlock Text="{Binding SelectedVersionInfo}" Classes="muted" />
        <TextBlock Text="{Binding GameDirectory}"
                   Classes="faint"
                   TextTrimming="CharacterEllipsis" />

        <Border Background="{DynamicResource PclBlue8}"
                CornerRadius="8"
                Padding="14"
                Margin="0,6,0,0">
          <StackPanel Spacing="6">
            <TextBlock Text="安装内容" FontWeight="SemiBold" />
            <TextBlock Text="客户端 jar、libraries、assets、日志配置；自动校验 SHA1，支持断点续传。"
                       Classes="muted"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <ProgressBar Value="{Binding Progress}"
                     Maximum="100"
                     IsVisible="{Binding IsBusy}" />
        <TextBlock Text="{Binding ProgressText}"
                   Classes="faint"
                   IsVisible="{Binding IsBusy}"
                   TextWrapping="Wrap" />

        <Button Content="安装所选版本"
                Classes="primary"
                HorizontalAlignment="Stretch"
                Command="{Binding InstallCommand}"
                IsEnabled="{Binding CanInstall}" />
        <Button Content="取消"
                HorizontalAlignment="Stretch"
                Command="{Binding CancelCommand}"
                IsEnabled="{Binding CanCancel}" />

        <TextBlock Text="{Binding Status}"
                   Classes="muted"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
