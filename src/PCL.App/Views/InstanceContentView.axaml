<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PCL.App.Views.InstanceContentView">

  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Spacing="8">
      <TextBlock Text="资源与存档" Classes="h1" />
      <TextBlock Text="管理当前实例的资源包、光影包与存档；删除不可恢复。"
                 Classes="muted" />

      <Grid ColumnDefinitions="Auto,240,Auto,*" Margin="0,4,0,0">
        <TextBlock Text="实例" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox Grid.Column="1"
                  ItemsSource="{Binding Instances}"
                  SelectedItem="{Binding SelectedInstance}"
                  HorizontalAlignment="Stretch" />
        <Button Grid.Column="2"
                Content="刷新"
                Classes="secondary"
                Command="{Binding RefreshCommand}"
                Margin="10,0,0,0" />
        <TextBlock Grid.Column="3"
                   Text="{Binding GameDirectory}"
                   Classes="faint"
                   VerticalAlignment="Center"
                   Margin="12,0,0,0"
                   TextTrimming="CharacterEllipsis" />
      </Grid>

      <TextBlock Text="{Binding Status}"
                 Classes="faint"
                 TextWrapping="Wrap" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="0,16,0,0">
      <Border Classes="card" Margin="0,0,8,0">
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Top" Text="资源包" Classes="h2" Margin="0,0,0,8" />
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
            <Button Content="删除"
                    Command="{Binding DeleteResourcePackCommand}"
                    IsEnabled="{Binding HasResourcePack}" />
            <Button Content="打开目录"
                    Command="{Binding OpenResourcePacksCommand}" />
          </StackPanel>
          <ListBox ItemsSource="{Binding ResourcePacks}"
                   SelectedItem="{Binding SelectedResourcePack}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding SizeText}" Classes="faint" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Classes="card" Margin="8,0,8,0">
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Top" Text="光影包" Classes="h2" Margin="0,0,0,8" />
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
            <Button Content="删除"
                    Command="{Binding DeleteShaderPackCommand}"
                    IsEnabled="{Binding HasShaderPack}" />
            <Button Content="打开目录"
                    Command="{Binding OpenShaderPacksCommand}" />
          </StackPanel>
          <ListBox ItemsSource="{Binding ShaderPacks}"
                   SelectedItem="{Binding SelectedShaderPack}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding SizeText}" Classes="faint" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Classes="card" Margin="8,0,0,0">
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Top" Text="存档" Classes="h2" Margin="0,0,0,8" />
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
            <Button Content="备份"
                    Command="{Binding BackupWorldCommand}"
                    IsEnabled="{Binding HasWorld}" />
            <Button Content="删除"
                    Command="{Binding DeleteWorldCommand}"
                    IsEnabled="{Binding HasWorld}" />
            <Button Content="打开目录"
                    Command="{Binding OpenWorldsCommand}" />
          </StackPanel>
          <ListBox ItemsSource="{Binding Worlds}"
                   SelectedItem="{Binding SelectedWorld}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding SizeText}" Classes="faint" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
