<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PCL.App.Views.SettingsView">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="12" MaxWidth="760" HorizontalAlignment="Stretch">

      <Border Classes="card" IsVisible="{Binding ShowLaunchSettings}">
        <StackPanel Spacing="10">
          <StackPanel Spacing="2">
            <TextBlock Text="启动设置" Classes="cardTitle" />
            <TextBlock Text="游戏目录修改后需要重启启动器生效。"
                       Classes="muted" />
          </StackPanel>

          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Text="游戏目录" VerticalAlignment="Center" />
            <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,4">
              <TextBox Text="{Binding GameDirectory}" />
              <Button Grid.Column="1" Content="打开" Classes="secondary"
                      Margin="7,0,0,0" Command="{Binding OpenGameFolderCommand}" />
            </Grid>

            <TextBlock Grid.Row="1" Text="最大内存" VerticalAlignment="Center" />
            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,4">
              <Slider Minimum="512" Maximum="16384" TickFrequency="512"
                      Value="{Binding MemoryMb}" />
              <TextBlock Grid.Column="1" Width="74" VerticalAlignment="Center"
                         Text="{Binding MemoryMb, StringFormat='{}{0:0} MB'}" Classes="faint" />
            </Grid>

            <TextBlock Grid.Row="2" Text="默认玩家名" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PlayerName}" Margin="0,4" />

            <TextBlock Grid.Row="3" Text="Java" VerticalAlignment="Center" />
            <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto,Auto" Margin="0,4">
              <ComboBox ItemsSource="{Binding JavaRuntimes}"
                        SelectedItem="{Binding SelectedJavaRuntime}"
                        PlaceholderText="自动 / 选择已发现的 Java"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="1" Content="扫描" Classes="secondary"
                      Margin="7,0,0,0" Command="{Binding DetectJavaCommand}" />
              <Button Grid.Column="2" Content="自动" Classes="secondary"
                      Margin="7,0,0,0" Command="{Binding UseAutomaticJavaCommand}" />
            </Grid>

            <TextBlock Grid.Row="4" Text="Java 路径" VerticalAlignment="Center" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding JavaPath}"
                     Watermark="留空则自动发现（JAVA_HOME / PATH / /usr/lib/jvm）"
                     Margin="0,4" />

            <TextBlock Grid.Row="5" Text="下载源" VerticalAlignment="Center" />
            <ComboBox Grid.Row="5" Grid.Column="1"
                      ItemsSource="{Binding Mirrors}"
                      SelectedItem="{Binding Mirror}"
                      HorizontalAlignment="Stretch"
                      Margin="0,4" />
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="7">
            <Button Content="保存设置" Classes="primary" Command="{Binding SaveCommand}" />
            <Button Content="打开配置目录" Command="{Binding OpenConfigFolderCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding ShowPersonalization}">
        <StackPanel Spacing="10">
          <StackPanel Spacing="2">
            <TextBlock Text="个性化" Classes="cardTitle" />
            <TextBlock Text="主题与窗口默认大小。" Classes="muted" />
          </StackPanel>

          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Text="主题" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1"
                      ItemsSource="{Binding Themes}"
                      SelectedItem="{Binding Theme}"
                      HorizontalAlignment="Stretch"
                      Margin="0,4" />

            <TextBlock Grid.Row="1" Text="窗口大小" VerticalAlignment="Center" />
            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto,*" Margin="0,4">
              <NumericUpDown Value="{Binding WindowWidth}" Minimum="320" Maximum="7680" Increment="10" />
              <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" Margin="10,0" />
              <NumericUpDown Grid.Column="2" Value="{Binding WindowHeight}" Minimum="240" Maximum="4320" Increment="10" />
            </Grid>

            <TextBlock Grid.Row="2" Text="背景图" VerticalAlignment="Center" />
            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,4">
              <TextBox Text="{Binding BackgroundImagePath}"
                       Watermark="图片路径（留空使用默认渐变），保存后需重启" />
              <Button Grid.Column="1" Content="选择" Classes="secondary"
                      Margin="7,0,0,0" Click="OnChooseBackgroundClick" />
            </Grid>
          </Grid>

          <Button Content="保存设置" Classes="primary" Command="{Binding SaveCommand}" />
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding ShowOtherSettings}">
        <StackPanel Spacing="10">
          <StackPanel Spacing="2">
            <TextBlock Text="其他" Classes="cardTitle" />
            <TextBlock Text="更新、登录、API 与网络。代理修改后需要重启。" Classes="muted" />
          </StackPanel>

          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Text="更新源" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding UpdateManifestUrl}"
                     Watermark="https://.../latest.json（留空则不检查更新）" Margin="0,4" />

            <TextBlock Grid.Row="1" Text="微软 Client ID" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MicrosoftClientId}"
                     Watermark="Azure 公共客户端应用 ID（设备码登录）" Margin="0,4" />

            <TextBlock Grid.Row="2" Text="CurseForge Key" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurseForgeApiKey}"
                     Watermark="可选；也可设置 PCL_CURSEFORGE_API_KEY" Margin="0,4" />

            <TextBlock Grid.Row="3" Text="全局 JVM 参数" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding GlobalJvmArgs}"
                     Watermark="-Dfoo=bar" Margin="0,4" />

            <TextBlock Grid.Row="4" Text="全局游戏参数" VerticalAlignment="Center" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding GlobalGameArgs}"
                     Watermark="--fullscreen" Margin="0,4" />

            <TextBlock Grid.Row="5" Text="HTTP 代理" VerticalAlignment="Center" />
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ProxyUrl}"
                     Watermark="http://127.0.0.1:7890（修改后需重启）" Margin="0,4" />

            <TextBlock Grid.Row="6" Text="配置文件" VerticalAlignment="Center" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ConfigPath}"
                       Classes="faint" TextWrapping="Wrap" Margin="0,4" />
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="7">
            <Button Content="保存设置" Classes="primary" Command="{Binding SaveCommand}" />
            <Button Content="打开配置目录" Command="{Binding OpenConfigFolderCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" Margin="2,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
