<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PCL.App.Views.SettingsView">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="12" MaxWidth="760" HorizontalAlignment="Stretch">

      <Border Classes="card" IsVisible="{Binding ShowLaunchSettings}">
        <StackPanel Spacing="10">
          <StackPanel Spacing="2">
            <TextBlock Text="启动设置" Classes="cardTitle" />
            <TextBlock Text="游戏目录修改后需要重启启动器生效。"
                       Classes="muted" />
          </StackPanel>

          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Text="游戏目录" VerticalAlignment="Center" />
            <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,4">
              <TextBox Text="{Binding GameDirectory}" />
              <Button Grid.Column="1" Content="打开" Classes="secondary"
                      Margin="7,0,0,0" Command="{Binding OpenGameFolderCommand}" />
            </Grid>

            <TextBlock Grid.Row="1" Text="最大内存" VerticalAlignment="Center" />
            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,4">
              <Slider Minimum="512" Maximum="16384" TickFrequency="512"
                      Value="{Binding MemoryMb}" />
              <TextBlock Grid.Column="1" Width="74" VerticalAlignment="Center"
                         Text="{Binding MemoryMb, StringFormat='{}{0:0} MB'}" Classes="faint" />
            </Grid>

            <TextBlock Grid.Row="2" Text="默认玩家名" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PlayerName}" Margin="0,4" />

            <TextBlock Grid.Row="3" Text="Java" VerticalAlignment="Center" />
            <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,4">
              <ComboBox ItemsSource="{Binding JavaRuntimes}"
                        SelectedItem="{Binding SelectedJavaRuntime}"
                        PlaceholderText="自动 / 选择已发现的 Java"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="1" Content="扫描" Classes="secondary"
                      Margin="7,0,0,0" Command="{Binding DetectJavaCommand}" />
              <Button Grid.Column="2" Content="自动" Classes="secondary"
                      Margin="7,0,0,0" Command="{Binding UseAutomaticJavaCommand}" />
              <ComboBox Grid.Column="3" Width="72"
                        ItemsSource="{Binding JavaInstallVersions}"
                        SelectedItem="{Binding JavaInstallVersion}"
                        Margin="7,0,0,0" />
              <Button Grid.Column="4" Content="安装" Classes="secondary"
                      Margin="6,0,0,0" Command="{Binding InstallJavaCommand}"
                      IsEnabled="{Binding !IsInstallingJava}" />
              <Button Grid.Column="5" Content="取消" Classes="secondary"
                      Margin="6,0,0,0" Command="{Binding CancelJavaInstallCommand}"
                      IsEnabled="{Binding IsInstallingJava}" />
              <Button Grid.Column="6" Content="清理" Classes="secondary"
                      Margin="6,0,0,0" Command="{Binding CleanJavaCommand}"
                      IsEnabled="{Binding !IsInstallingJava}" />
            </Grid>

            <TextBlock Grid.Row="4" Text="Java 路径" VerticalAlignment="Center" />
            <StackPanel Grid.Row="4" Grid.Column="1" Spacing="2" Margin="0,4">
              <TextBox Text="{Binding JavaPath}"
                       Watermark="留空则自动发现（JAVA_HOME / PATH / /usr/lib/jvm）" />
              <ProgressBar Value="{Binding JavaInstallProgress}" Maximum="100"
                           Height="4" IsVisible="{Binding IsInstallingJava}" />
              <TextBlock Text="{Binding JavaInstallStatus}" Classes="faint" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Grid.Row="5" Text="启动前命令" VerticalAlignment="Center" />
            <StackPanel Grid.Row="5" Grid.Column="1" Spacing="4" Margin="0,4">
              <TextBox Text="{Binding PreLaunchCommand}"
                       Watermark="全局启动前命令，支持 {java}/{minecraft}/{verpath}/{name}" />
              <CheckBox Content="等待命令完成" IsChecked="{Binding PreLaunchWait}" />
            </StackPanel>

            <TextBlock Grid.Row="6" Text="游戏时隐藏启动器" VerticalAlignment="Center" />
            <CheckBox Grid.Row="6" Grid.Column="1"
                      Content="游戏运行时隐藏窗口，退出后恢复"
                      IsChecked="{Binding HideLauncherOnGame}" />

            <TextBlock Grid.Row="7" Text="下载源" VerticalAlignment="Center" />
            <ComboBox Grid.Row="7" Grid.Column="1"
                      ItemsSource="{Binding Mirrors}"
                      SelectedItem="{Binding Mirror}"
                      HorizontalAlignment="Stretch"
                      Margin="0,4" />

            <TextBlock Grid.Row="8" Text="进程优先级" VerticalAlignment="Center" />
            <ComboBox Grid.Row="8" Grid.Column="1"
                      ItemsSource="{Binding PriorityOptions}"
                      SelectedItem="{Binding Priority}"
                      HorizontalAlignment="Stretch"
                      Margin="0,4" />

            <TextBlock Grid.Row="9" Text="高性能显卡" VerticalAlignment="Center" />
            <CheckBox Grid.Row="9" Grid.Column="1"
                      Content="设置 DRI_PRIME / NVIDIA 环境变量"
                      IsChecked="{Binding HighPerformanceGpu}" />

            <TextBlock Grid.Row="10" Text="版本隔离" VerticalAlignment="Center" />
            <ComboBox Grid.Row="10" Grid.Column="1"
                      ItemsSource="{Binding IsolationOptions}"
                      SelectedItem="{Binding Isolation}"
                      HorizontalAlignment="Stretch"
                      Margin="0,4" />
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="7">
          <Button Content="保存设置" Classes="primary" Command="{Binding SaveCommand}" />
            <Button Content="打开配置目录" Command="{Binding OpenConfigFolderCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding ShowPersonalization}">
        <StackPanel Spacing="10">
          <StackPanel Spacing="2">
            <TextBlock Text="个性化" Classes="cardTitle" />
            <TextBlock Text="主题色、背景与窗口默认大小。" Classes="muted" />
          </StackPanel>

          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Text="主题" VerticalAlignment="Center" />
            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="0,4">
              <ComboBox ItemsSource="{Binding Themes}"
                        SelectedItem="{Binding Theme}"
                        HorizontalAlignment="Stretch" />
              <ComboBox ItemsSource="{Binding ThemePresets}"
                        SelectedItem="{Binding SelectedThemePreset}"
                        DisplayMemberBinding="{Binding Name}"
                        HorizontalAlignment="Stretch" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="色相" VerticalAlignment="Center" />
            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,4">
              <Slider Minimum="0" Maximum="360" TickFrequency="1" Value="{Binding AccentHue}" />
              <TextBlock Grid.Column="1" Width="48" VerticalAlignment="Center"
                         Text="{Binding AccentHue, StringFormat='{}{0:0}°'}" Classes="faint" />
            </Grid>

            <TextBlock Grid.Row="2" Text="饱和度" VerticalAlignment="Center" />
            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,4">
              <Slider Minimum="0" Maximum="100" TickFrequency="1" Value="{Binding AccentSaturation}" />
              <TextBlock Grid.Column="1" Width="48" VerticalAlignment="Center"
                         Text="{Binding AccentSaturation, StringFormat='{}{0:0}%'}" Classes="faint" />
            </Grid>

            <TextBlock Grid.Row="3" Text="亮度" VerticalAlignment="Center" />
            <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,4">
              <Slider Minimum="-30" Maximum="30" TickFrequency="1" Value="{Binding AccentLightAdjust}" />
              <TextBlock Grid.Column="1" Width="48" VerticalAlignment="Center"
                         Text="{Binding AccentLightAdjust, StringFormat='{}{0:+0;-0;0}'}" Classes="faint" />
            </Grid>

            <TextBlock Grid.Row="4" Text="窗口大小" VerticalAlignment="Center" />
            <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto,*" Margin="0,4">
              <NumericUpDown Value="{Binding WindowWidth}" Minimum="810" Maximum="7680" Increment="10" />
              <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" Margin="10,0" />
              <NumericUpDown Grid.Column="2" Value="{Binding WindowHeight}" Minimum="470" Maximum="4320" Increment="10" />
            </Grid>

            <TextBlock Grid.Row="5" Text="自定义 Logo" VerticalAlignment="Center" />
            <Grid Grid.Row="5" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,4">
              <TextBox Text="{Binding CustomLogoPath}"
                       Watermark="Logo 图片路径（留空使用 PCL 图标），需重启" />
              <Button Grid.Column="1" Content="选择" Classes="secondary"
                      Margin="7,0,0,0" Click="OnChooseLogoClick" />
            </Grid>

            <TextBlock Grid.Row="6" Text="背景" VerticalAlignment="Center" />
            <StackPanel Grid.Row="6" Grid.Column="1" Spacing="4" Margin="0,4">
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding BackgroundImagePath}"
                         Watermark="单张背景图（留空使用默认渐变）" />
                <Button Grid.Column="1" Content="选择" Classes="secondary"
                        Margin="7,0,0,0" Click="OnChooseBackgroundClick" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding BackgroundImageFolder}"
                         Watermark="背景文件夹（优先并随机选择）" />
                <Button Grid.Column="1" Content="选择" Classes="secondary"
                        Margin="7,0,0,0" Click="OnChooseBackgroundFolderClick" />
              </Grid>
              <CheckBox Content="叠加主题色" IsChecked="{Binding BackgroundColorOverlay}" />
            </StackPanel>

            <TextBlock Grid.Row="7" Text="背景不透明度" VerticalAlignment="Center" />
            <Grid Grid.Row="7" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,4">
              <Slider Minimum="0" Maximum="100" TickFrequency="5"
                      Value="{Binding BackgroundImageOpacity}" />
              <TextBlock Grid.Column="1" Width="48" VerticalAlignment="Center"
                         Text="{Binding BackgroundImageOpacity, StringFormat='{}{0:0}%'}" Classes="faint" />
            </Grid>

            <TextBlock Grid.Row="8" Text="背景模糊" VerticalAlignment="Center" />
            <Grid Grid.Row="8" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,4">
              <Slider Minimum="0" Maximum="30" TickFrequency="1"
                      Value="{Binding BackgroundImageBlur}" />
              <TextBlock Grid.Column="1" Width="48" VerticalAlignment="Center"
                         Text="{Binding BackgroundImageBlur, StringFormat='{}{0:0} px'}" Classes="faint" />
            </Grid>
          </Grid>

          <StackPanel Spacing="4">
            <TextBlock Text="自定义主页" Classes="cardTitle" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding CustomHomePagePath}"
                       Watermark="本地 .axaml 文件（留空使用启动日志）" />
              <Button Grid.Column="1" Content="选择" Classes="secondary"
                      Margin="7,0,0,0" Click="OnChooseHomePageClick" />
            </Grid>
            <TextBlock Text="⚠ 自定义主页是可执行 XAML，请只加载可信文件；保存后重启生效。"
                       Classes="faint" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Spacing="6">
          <TextBlock Text="背景音乐" Classes="cardTitle" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding MusicFolder}"
                     Watermark="音乐文件夹（mp3/ogg/wav/flac）" />
            <Button Grid.Column="1" Content="选择" Classes="secondary"
                    Margin="7,0,0,0" Click="OnChooseMusicFolderClick" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <Slider Minimum="0" Maximum="100" TickFrequency="5" Value="{Binding MusicVolume}" />
            <TextBlock Grid.Column="1" Width="48" VerticalAlignment="Center"
                       Text="{Binding MusicVolume, StringFormat='{}{0:0}%'}" Classes="faint" />
          </Grid>
          <CheckBox Content="启动时播放背景音乐" IsChecked="{Binding MusicStart}" />
          <CheckBox Content="游戏运行时暂停，退出后恢复" IsChecked="{Binding MusicPauseOnGame}" />
          <TextBlock Text="保存后重启生效。"
                     Classes="faint" TextWrapping="Wrap" />
          </StackPanel>
          <Button Content="保存设置" Classes="primary" Command="{Binding SaveCommand}" />
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding ShowOtherSettings}">
        <StackPanel Spacing="10">
          <StackPanel Spacing="2">
            <TextBlock Text="其他" Classes="cardTitle" />
            <TextBlock Text="更新、登录、API 与网络。代理修改后需要重启。" Classes="muted" />
          </StackPanel>

          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Text="更新源" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding UpdateManifestUrl}"
                     Watermark="https://.../latest.json（留空则不检查更新）" Margin="0,4" />

            <TextBlock Grid.Row="1" Text="微软 Client ID" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MicrosoftClientId}"
                     Watermark="Azure 公共客户端应用 ID（设备码登录）" Margin="0,4" />

            <TextBlock Grid.Row="2" Text="CurseForge Key" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurseForgeApiKey}"
                     Watermark="可选；也可设置 PCL_CURSEFORGE_API_KEY" Margin="0,4" />

            <TextBlock Grid.Row="3" Text="全局 JVM 参数" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding GlobalJvmArgs}"
                     Watermark="-Dfoo=bar" Margin="0,4" />

            <TextBlock Grid.Row="4" Text="全局游戏参数" VerticalAlignment="Center" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding GlobalGameArgs}"
                     Watermark="--fullscreen" Margin="0,4" />

            <TextBlock Grid.Row="5" Text="HTTP 代理 / 限速" VerticalAlignment="Center" />
            <StackPanel Grid.Row="5" Grid.Column="1" Spacing="2" Margin="0,4">
              <TextBox Text="{Binding ProxyUrl}"
                       Watermark="http://127.0.0.1:7890（修改后需重启）" />
              <Grid ColumnDefinitions="Auto,110" ColumnSpacing="8">
                <TextBlock Text="下载限速 MB/s（0=不限）" Classes="faint" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Value="{Binding DownloadSpeedLimitMbps}"
                               Minimum="0" Maximum="10240" Increment="1" />
              </Grid>
            </StackPanel>

            <TextBlock Grid.Row="6" Text="配置文件" VerticalAlignment="Center" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ConfigPath}"
                       Classes="faint" TextWrapping="Wrap" Margin="0,4" />
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="7">
            <Button Content="保存设置" Classes="primary" Command="{Binding SaveCommand}" />
            <Button Content="打开配置目录" Command="{Binding OpenConfigFolderCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding Status}"
                 Classes="muted"
                 TextWrapping="Wrap"
                 Margin="2,0"
                 IsVisible="{Binding ShowLaunchSettings}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
