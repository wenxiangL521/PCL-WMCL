<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PCL.App.Views.InstanceView">

  <Grid ColumnDefinitions="*,380">
    <Border Classes="card">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="实例" Classes="h1" />
            <TextBlock Text="{Binding GameDirectory}"
                       Classes="faint"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="1"
                  Content="刷新"
                  Classes="secondary"
                  Command="{Binding RefreshCommand}"
                  Padding="12,4"
                  MinHeight="30" />
        </Grid>

        <ListBox Margin="0,12,0,0"
                 ItemsSource="{Binding Instances}"
                 SelectedItem="{Binding SelectedInstance}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="1">
                <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Subtitle}" Classes="faint" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <Border Grid.Column="1" Classes="card" Margin="16,0,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
        <TextBlock Text="{Binding SelectedInstanceTitle}"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="{DynamicResource PclBlue2}" />
        <TextBlock Text="{Binding SelectedInstanceInfo}" Classes="muted" />
        <TextBlock Text="{Binding SelectedInstancePath}"
                   Classes="faint"
                   TextWrapping="Wrap" />

        <Border Background="{DynamicResource PclBlue8}"
                CornerRadius="8"
                Padding="14"
                Margin="0,6,0,0">
          <StackPanel Spacing="6">
            <TextBlock Text="实例目录" FontWeight="SemiBold" />
            <TextBlock Text="与官方启动器兼容：versions/&lt;id&gt;/ 下保存版本 JSON、客户端 jar 与 natives。"
                       Classes="muted"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Button Content="打开版本目录"
                HorizontalAlignment="Stretch"
                Command="{Binding OpenFolderCommand}" />
        <Button Content="打开游戏目录"
                HorizontalAlignment="Stretch"
                Classes="secondary"
                Command="{Binding OpenGameFolderCommand}" />
        <Button Content="导出实例（备份 zip）"
                HorizontalAlignment="Stretch"
                Command="{Binding ExportInstanceCommand}" />
        <Button Content="导出整合包 (.mrpack)"
                HorizontalAlignment="Stretch"
                Classes="secondary"
                Command="{Binding ExportModpackCommand}" />

        <Border Height="1"
                Background="{DynamicResource PclBorder}"
                Margin="0,4" />

        <TextBlock Text="导入实例" Classes="h2" />
        <TextBox Text="{Binding ImportPath}"
                 Watermark="/path/to/instance-export.zip" />
        <Button Content="导入 zip"
                HorizontalAlignment="Stretch"
                Classes="secondary"
                Command="{Binding ImportInstanceCommand}"
                IsEnabled="{Binding !IsImporting}" />

        <Border Height="1"
                Background="{DynamicResource PclBorder}"
                Margin="0,4" />

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="克隆"
                  Command="{Binding CloneInstanceCommand}" />
          <Button Content="重命名"
                  Command="{Binding RenameInstanceCommand}" />
          <Button Content="删除实例"
                  Command="{Binding DeleteInstanceCommand}" />
        </StackPanel>

        <Border Height="1"
                Background="{DynamicResource PclBorder}"
                Margin="0,4" />

        <TextBlock Text="实例设置" Classes="h2" />

        <CheckBox Content="内存使用全局设置"
                  IsChecked="{Binding UseGlobalMemory}" />
        <Grid ColumnDefinitions="90,*">
          <TextBlock Text="内存 (MB)" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="1"
                         Value="{Binding InstanceMemoryMb}"
                         Minimum="512"
                         Maximum="32768"
                         Increment="512"
                         IsEnabled="{Binding CanEditMemory}" />
        </Grid>

        <CheckBox Content="Java 使用全局设置"
                  IsChecked="{Binding UseGlobalJava}" />
        <TextBox Text="{Binding InstanceJavaPath}"
                 Watermark="Java 路径（留空则自动选择）"
                 IsEnabled="{Binding CanEditJava}" />

        <TextBlock Text="额外 JVM 参数" Classes="faint" />
        <TextBox Text="{Binding InstanceJvmArgs}"
                 Watermark="-Dfoo=bar" />
        <TextBlock Text="额外游戏参数" Classes="faint" />
        <TextBox Text="{Binding InstanceGameArgs}"
                 Watermark="--fullscreen" />

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="保存实例设置"
                  Classes="primary"
                  Command="{Binding SaveInstanceSettingsCommand}" />
          <Button Content="重置"
                  Command="{Binding ResetInstanceSettingsCommand}" />
        </StackPanel>

        <TextBlock Text="{Binding Status}"
                   Classes="muted"
                   TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
