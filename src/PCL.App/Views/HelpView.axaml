<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PCL.App.Views.HelpView">
  <Grid ColumnDefinitions="250,*">
    <Border Classes="card" Margin="0,0,12,0" Padding="12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="7">
          <TextBlock Text="帮助" Classes="cardTitle" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding SearchText}" Watermark="搜索帮助" />
            <Button Grid.Column="1" Content="清空" Padding="8,3" MinHeight="26"
                    Command="{Binding ClearSearchCommand}" Margin="6,0,0,0" />
          </Grid>
          <TextBlock Text="{Binding Status}" Classes="faint" />
        </StackPanel>
        <ListBox ItemsSource="{Binding FilteredTopics}"
                 SelectedItem="{Binding SelectedTopic}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Summary}" Classes="faint" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <Border Grid.Column="1" Classes="card">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" IsVisible="{Binding HasSelectedTopic}">
          <TextBlock Text="{Binding SelectedTopic.Title}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{Binding SelectedTopic.Summary}" Classes="muted" TextWrapping="Wrap" />
          <Border Height="1" Background="{DynamicResource PclBorder}" />
          <TextBlock Text="{Binding SelectedTopic.Body}" TextWrapping="Wrap" LineHeight="22" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
