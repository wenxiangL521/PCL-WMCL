<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PCL.App.Views.AuthlibLoginWindow"
        Title="第三方登录"
        Width="540"
        Height="430"
        MinWidth="480"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PclPage}">
  <Border Classes="card" Margin="20" Padding="18">
    <StackPanel Spacing="12">
      <TextBlock Text="第三方登录" Classes="h1" />
      <TextBlock Text="使用 Yggdrasil / Authlib-Injector 认证服务器。登录后会把 authlib-injector 注入启动参数。"
                 Classes="muted" TextWrapping="Wrap" />
      <TextBlock Text="认证服务器" Classes="muted" />
      <TextBox Text="{Binding Server}" Watermark="https://example.com/api/yggdrasil" />
      <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
        <StackPanel Spacing="4">
          <TextBlock Text="账号 / 邮箱" Classes="muted" />
          <TextBox Text="{Binding UserName}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="密码" Classes="muted" />
          <TextBox Text="{Binding Password}" PasswordChar="●" />
        </StackPanel>
      </Grid>
      <TextBlock Text="{Binding Status}" Classes="faint" TextWrapping="Wrap" />
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="登录" Classes="primary"
                Command="{Binding LoginCommand}" IsEnabled="{Binding !IsBusy}" />
        <Button Content="取消" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
